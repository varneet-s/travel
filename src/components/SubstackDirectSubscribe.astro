---
// Minimalist Substack Subscription Box matching Nature's Hideaways Design System
---

<div class="w-full max-w-md mx-auto my-6 p-6 rounded-2xl bg-[#0F1720] border border-white/10 text-center">
  <p class="text-xs uppercase font-sans tracking-[0.2em] text-[#F7E4A1] mb-2 font-medium">
    Substack Newsletter
  </p>
  <h3 class="font-serif text-xl text-white font-normal mb-3">
    Letters from the Slow Road
  </h3>
  <p class="font-sans text-xs text-white/60 mb-6 leading-relaxed">
    Bi-weekly dispatches, transit breakdowns, and field notes sent directly to your inbox.
  </p>
  <form
    action="https://rekhoj.substack.com/subscribe"
    method="get"
    target="_blank"
    class="flex flex-col sm:flex-row gap-2"
  >
    <input
      type="email"
      name="email"
      placeholder="Type your email..."
      required
      class="flex-1 px-4 py-2.5 rounded-full bg-[#0A1C20] border border-white/20 text-white placeholder-white/40 text-xs focus:outline-none focus:border-[#77C5A0] transition-colors"
      aria-label="Email address for Substack newsletter"
    />
    <button
      type="submit"
      class="px-6 py-2.5 rounded-full bg-[#77C5A0] text-[#0A1C20] font-sans text-xs font-semibold hover:bg-[#8CD5B1] active:scale-[0.98] transition-all cursor-pointer"
    >
      Subscribe
    </button>
  </form>
</div>
