---
---

<div class="direct-subscribe-card">
  <div class="direct-subscribe-kicker">[ REKHOJ · THE MUSAFIR PAAJI ]</div>
  <h3 class="direct-subscribe-title">Letters from the Long Road</h3>
  <p class="direct-subscribe-lead">
    Unhurried field letters, state bus transit logs, travel expense ledgers, and stories from the open road. Delivered directly to your inbox — no noise, no algorithms.
  </p>

  <div class="direct-subscribe-emblem">
    <div class="direct-subscribe-icon-wrap">
      <img
        src="/images/illustrations/expedition-compass.svg"
        alt="reKhoj Compass"
        width="44"
        height="44"
        class="direct-subscribe-compass"
      />
    </div>
    <div class="direct-subscribe-brand">reKhoj</div>
    <p class="direct-subscribe-subcopy">
      Slow travel archives, state bus routes, and honest road ledgers by Varneet Singh (@the_musafir_paaji). 14 documented journeys across coastlines, deserts, river towns, and mountain passes.
    </p>
  </div>

  <form
    action="https://rekhoj.substack.com/api/v1/free"
    method="post"
    target="_blank"
    class="direct-subscribe-form"
  >
    <div class="direct-subscribe-input-group">
      <input
        type="email"
        name="email"
        placeholder="Type your email..."
        required
        class="direct-subscribe-input"
        aria-label="Email address for Substack newsletter"
      />
      <button type="submit" class="direct-subscribe-btn">
        Subscribe
      </button>
    </div>
  </form>

  <p class="direct-subscribe-terms">
    By subscribing you agree to <a href="https://substack.com/tos" target="_blank" rel="noopener noreferrer">Substack's Terms of Use</a>, our <a href="https://substack.com/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a> and our Information collection notice.
  </p>

  <div class="direct-subscribe-footlink">
    <a href="https://rekhoj.substack.com" target="_blank" rel="noopener noreferrer">
      Or browse past letters on rekhoj.substack.com <span class="arrow-spring" aria-hidden="true">↗</span>
    </a>
  </div>
</div>

<style>
  .direct-subscribe-card {
    background: #172320;
    color: #FAF8F5;
    border-radius: 16px;
    padding: 40px 28px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    text-align: center;
    max-width: 580px;
    margin: 32px auto;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }

  .direct-subscribe-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--accent-sage-light);
    margin-bottom: 8px;
  }

  .direct-subscribe-title {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 12px 0;
    line-height: 1.2;
  }

  .direct-subscribe-lead {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-dark-secondary);
    max-width: 480px;
    margin: 0 auto 24px auto;
  }

  .direct-subscribe-emblem {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 24px;
  }

  .direct-subscribe-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background: #FAF8F5;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    margin-bottom: 12px;
  }

  .direct-subscribe-compass {
    width: 40px;
    height: 40px;
  }

  .direct-subscribe-brand {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.04em;
    margin-bottom: 8px;
  }

  .direct-subscribe-subcopy {
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-dark-muted);
    max-width: 440px;
    margin: 0 auto;
  }

  .direct-subscribe-form {
    margin: 20px auto 16px auto;
    max-width: 460px;
    width: 100%;
  }

  .direct-subscribe-input-group {
    display: flex;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: #0E1815;
  }

  .direct-subscribe-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    padding: 14px 16px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: #ffffff;
    outline: none;
  }

  .direct-subscribe-input::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  .direct-subscribe-btn {
    background: var(--accent-terracotta);
    color: #ffffff;
    border: none;
    padding: 0 24px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    min-height: 44px;
    transition: background 0.2s ease, transform 0.1s ease;
  }

  .direct-subscribe-btn:hover {
    background: var(--accent-terracotta-hover);
  }

  .direct-subscribe-terms {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.5;
    margin: 0 auto 16px auto;
    max-width: 420px;
  }

  .direct-subscribe-terms a {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: underline;
  }

  .direct-subscribe-terms a:hover {
    color: #ffffff;
  }

  .direct-subscribe-footlink a {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent-sage-light);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .direct-subscribe-footlink a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .direct-subscribe-card {
      padding: 28px 18px;
    }
    .direct-subscribe-input-group {
      flex-direction: column;
    }
    .direct-subscribe-btn {
      padding: 12px;
      width: 100%;
    }
  }
</style>
