---
// Direct Substack Email Subscribe Component
// Allows users to directly input their email and subscribe to rekhoj.substack.com
---

<div class="direct-subscribe-card">
  <!-- Top Badge -->
  <div class="direct-subscribe-badge">
    <span>[ REKHOJ · THE MUSAFIR PAAJI ]</span>
  </div>

  <!-- Main Title -->
  <h2 class="direct-subscribe-title">Letters from the Long Road</h2>

  <!-- Description -->
  <p class="direct-subscribe-desc">
    Unhurried field letters, state bus transit logs, travel expense ledgers, and stories from the open road. Delivered directly to your inbox — no noise, no algorithms.
  </p>

  <!-- Subtitle Lockup with Compass Logo -->
  <div class="direct-subscribe-sublockup">
    <img
      src="/images/illustrations/expedition-compass.svg"
      alt="reKhoj compass rose"
      class="direct-subscribe-compass"
      width="32"
      height="32"
      loading="lazy"
    />
    <div class="direct-subscribe-author-info">
      <span class="direct-subscribe-author-title">reKhoj</span>
      <span class="direct-subscribe-author-subtitle">
        Slow travel archives, state bus routes, and honest road ledgers by Varneet Singh (@the_musafir_paaji)...
      </span>
    </div>
  </div>

  <!-- Direct Form -->
  <form
    action="https://rekhoj.substack.com/api/v1/free"
    method="post"
    target="_blank"
    class="direct-subscribe-form"
  >
    <input
      type="email"
      name="email"
      placeholder="Type your email..."
      required
      class="direct-subscribe-input"
    />
    <button type="submit" class="direct-subscribe-button">
      Subscribe
    </button>
  </form>

  <!-- Terms Notice -->
  <p class="direct-subscribe-terms">
    By subscribing you agree to Substack's <a href="https://substack.com/tos" target="_blank" rel="noopener noreferrer">Terms of Use</a>, our <a href="https://substack.com/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a> and our <a href="https://substack.com/ccpa#personal-data-collected" target="_blank" rel="noopener noreferrer">Information collection notice</a>
  </p>

  <!-- Past Letters Link -->
  <div class="direct-subscribe-past">
    <a
      href="https://rekhoj.substack.com"
      target="_blank"
      rel="noopener noreferrer"
      class="direct-subscribe-past-link"
    >
      Or browse past letters on rekhoj.substack.com <span class="arrow-spring">↗</span>
    </a>
  </div>
</div>

<style>
  .direct-subscribe-card {
    background: #ffffff;
    border: 2px solid var(--border-on-light, rgba(24, 32, 36, 0.12));
    border-radius: var(--radius-sharp, 0px);
    box-shadow: 4px 4px 0px rgba(22, 36, 33, 0.08);
    padding: 36px 32px;
    max-width: 640px;
    margin: 32px auto;
    text-align: center;
    box-sizing: border-box;
  }

  .direct-subscribe-badge {
    margin-bottom: 16px;
  }

  .direct-subscribe-badge span {
    font-family: var(--font-mono, 'Courier Prime', monospace);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-terracotta, #D86B58);
    background: rgba(216, 107, 88, 0.08);
    padding: 4px 10px;
    border-radius: var(--radius-sharp, 0px);
    border: 1px solid rgba(216, 107, 88, 0.25);
    display: inline-block;
  }

  .direct-subscribe-title {
    font-family: var(--font-serif, 'Newsreader', Georgia, serif);
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-light-primary, #182024);
    margin: 0 0 14px;
    letter-spacing: -0.015em;
  }

  .direct-subscribe-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-light-secondary, #3D4E4A);
    max-width: 520px;
    margin: 0 auto 24px;
  }

  .direct-subscribe-sublockup {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    text-align: left;
    gap: 12px;
    background: #FAF8F5;
    border: 1px solid var(--border-on-light, rgba(24, 32, 36, 0.12));
    padding: 12px 16px;
    margin-bottom: 24px;
    border-radius: var(--radius-sharp, 0px);
  }

  .direct-subscribe-compass {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .direct-subscribe-author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .direct-subscribe-author-title {
    font-family: var(--font-display, 'Courier Prime', monospace);
    font-weight: 700;
    font-size: 14px;
    color: var(--text-light-primary, #182024);
  }

  .direct-subscribe-author-subtitle {
    font-size: 12px;
    color: var(--text-light-muted, #5C6E68);
    line-height: 1.4;
  }

  .direct-subscribe-form {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    width: 100%;
    box-sizing: border-box;
  }

  .direct-subscribe-input {
    flex: 1;
    min-height: 46px;
    padding: 10px 16px;
    font-family: var(--font-sans, 'Source Sans 3', sans-serif);
    font-size: 15px;
    background: #FFFFFF;
    border: 1.5px solid var(--border-on-light, rgba(24, 32, 36, 0.2));
    border-radius: var(--radius-sharp, 0px);
    color: var(--text-light-primary, #182024);
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .direct-subscribe-input:focus {
    outline: none;
    border-color: var(--accent-terracotta, #D86B58);
    box-shadow: 0 0 0 2px rgba(216, 107, 88, 0.2);
  }

  .direct-subscribe-button {
    min-height: 46px;
    padding: 0 24px;
    background: var(--accent-terracotta, #D86B58);
    color: #ffffff;
    font-family: var(--font-mono, 'Courier Prime', monospace);
    font-weight: 700;
    font-size: 13.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1.5px solid var(--accent-terracotta, #D86B58);
    border-radius: var(--radius-sharp, 0px);
    cursor: pointer;
    box-shadow: 2px 2px 0px rgba(22, 36, 33, 0.15);
    transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .direct-subscribe-button:hover {
    background: var(--accent-terracotta-hover, #BC5544);
    border-color: var(--accent-terracotta-hover, #BC5544);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px rgba(22, 36, 33, 0.2);
  }

  .direct-subscribe-button:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px rgba(22, 36, 33, 0.2);
  }

  .direct-subscribe-terms {
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--text-light-muted, #5C6E68);
    margin: 0 0 18px;
    text-align: center;
  }

  .direct-subscribe-terms a {
    color: var(--text-light-secondary, #3D4E4A);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .direct-subscribe-terms a:hover {
    color: var(--accent-terracotta, #D86B58);
  }

  .direct-subscribe-past {
    padding-top: 14px;
    border-top: 1px solid var(--border-on-light, rgba(24, 32, 36, 0.08));
  }

  .direct-subscribe-past-link {
    font-family: var(--font-mono, 'Courier Prime', monospace);
    font-size: 12.5px;
    color: var(--text-light-secondary, #3D4E4A);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    transition: color 0.2s ease;
  }

  .direct-subscribe-past-link:hover {
    color: var(--accent-terracotta, #D86B58);
    text-decoration: underline;
  }

  @media (max-width: 540px) {
    .direct-subscribe-card {
      padding: 24px 18px;
      margin: 20px auto;
    }

    .direct-subscribe-form {
      flex-direction: column;
    }

    .direct-subscribe-button {
      width: 100%;
    }
  }
</style>
