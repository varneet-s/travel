---
/**
 * @deprecated PreviewCard is deprecated and superseded by JourneyCard and editorial preview grids.
 * Retained with brand token alignment and safe defaults for backwards compatibility.
 */
interface Props {
  href?: string;
  title?: string;
  date?: Date | string;
  images?: string[];
}

const { href = '#', title = '', date = new Date(), images = [] } = Astro.props;

const dateObj = typeof date === 'string' ? new Date(date) : (date || new Date());
const formattedDate = dateObj.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

{href && (
  <a href={href} class="preview-card-editorial">
    {images && images.length > 0 && (
      <div class="preview-photos-3">
        {images.slice(0, 3).map((img, i) => (
          <img src={img} alt={`${title} photo ${i + 1}`} loading="lazy" />
        ))}
      </div>
    )}
    <div class="preview-meta">
      <h3 class="card-title">{title}</h3>
      <span class="date-label">{formattedDate}</span>
    </div>
  </a>
)}
