---
---

<section class="volunteer-pitch-section section-dark reveal-on-scroll" id="volunteer" aria-label="Hostel and Volunteering Collaboration">
  <div class="content-wrap">
    <div class="pitch-container">
      <div class="pitch-header">
        <span class="pitch-badge">[ HOMESTAY & HOSTEL VOLUNTEERING ]</span>
        <h2 class="pitch-title">
          Slow Travel &amp; Meaningful Stays.
        </h2>
        <p class="pitch-lead">
          I collaborate with mountain homestays, remote hostels, and slow travel communities across the Himalayas. Offering photography, editorial documentation, and authentic road stories in exchange for quiet stays.
        </p>
      </div>

      <div class="pitch-cards-grid">
        <div class="pitch-feature-card">
          <div class="card-icon">📷</div>
          <h3 class="card-headline">Editorial Photo Documentation</h3>
          <p class="card-desc">
            Authentic, unposed photography of your space, kitchen, and trail walks that honors the mountain ethos without synthetic promotional shine.
          </p>
        </div>

        <div class="pitch-feature-card">
          <div class="card-icon">✍️</div>
          <h3 class="card-headline">Field Dispatch Writing</h3>
          <p class="card-desc">
            Long-form travel journals and route notes syndicated through reKhoj on Substack and Google Search indexing.
          </p>
        </div>

        <div class="pitch-feature-card">
          <div class="card-icon">🏔️</div>
          <h3 class="card-headline">Trail Guidance &amp; Hosting</h3>
          <p class="card-desc">
            Experience leading group journeys across Himachal valleys with Raw Diaries, cultivating warm circles and respectful trail stewardship.
          </p>
        </div>
      </div>

      <div class="pitch-cta-box">
        <div class="pitch-cta-text">
          <strong>Operating a mountain space or homestay?</strong>
          <span>Let's connect for upcoming seasonal routes.</span>
        </div>
        <div class="pitch-actions-row">
          <a
            href="mailto:varneet.singh@gmail.com?subject=Mountain%20Stay%20Collaboration%20via%20reKhoj"
            class="pitch-primary-btn"
          >
            Initiate Collaboration ↗
          </a>
          <a
            href="/about"
            class="pitch-secondary-btn"
          >
            Read About My Journey →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .volunteer-pitch-section {
    padding: 100px 0;
    background: #0A1210;
  }

  .pitch-container {
    max-width: 960px;
    margin: 0 auto;
    background: #111E1A;
    border: 1.5px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 48px 40px;
  }

  .pitch-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 44px auto;
  }

  .pitch-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--accent-sage-light);
  }

  .pitch-title {
    font-family: 'Newsreader', var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 400;
    color: #FAF8F5;
    margin: 12px 0 16px 0;
    line-height: 1.15;
  }

  .pitch-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-dark-secondary);
  }

  .pitch-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  .pitch-feature-card {
    background: #182823;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 24px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .pitch-feature-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-terracotta);
  }

  .card-icon {
    font-size: 24px;
    margin-bottom: 12px;
  }

  .card-headline {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 8px 0;
  }

  .card-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-dark-muted);
    margin: 0;
  }

  .pitch-cta-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 20px 24px;
  }

  .pitch-cta-text {
    display: flex;
    flex-direction: column;
    font-size: 14px;
    color: #FAF8F5;
    line-height: 1.5;
  }

  .pitch-actions-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .pitch-primary-btn {
    background: var(--accent-terracotta);
    color: #ffffff !important;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 10px 20px;
    border-radius: 6px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease;
  }

  .pitch-primary-btn:hover {
    background: var(--accent-terracotta-hover);
  }

  .pitch-secondary-btn {
    background: transparent;
    color: var(--accent-sage-light) !important;
    border: 1px solid rgba(255, 255, 255, 0.2);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 6px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }

  .pitch-secondary-btn:hover {
    border-color: #ffffff;
    color: #ffffff !important;
  }

  @media (max-width: 768px) {
    .pitch-container {
      padding: 28px 20px;
    }
    .pitch-cta-box {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
