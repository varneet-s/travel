---
import { chronologicalJourneys } from '../data/chronologicalJourneys';

// Total horizontal width of road track: 5600px
// Bus is stationary at left: 20% on desktop (approx 280px-300px on standard desktop viewports)
// Travel distance: 3600px across 13 intervals (~276.92px per milestone)
const count = chronologicalJourneys.length;
const startX = 300;
const travelDistance = 3600;
const stepX = travelDistance / (count - 1);
const roadWidth = 5600;
const roadBaseY = 220; // asphalt highway baseline
const roadHeight = 300;

// Milestone coordinates along the road
const milestones = chronologicalJourneys.map((journey, i) => {
  const x = Math.round(startX + i * stepX);
  // Altitude peak visual height: 15m -> ~195 (low elevation near road), 3450m -> ~55 (high altitude peak)
  const y = Math.round(roadBaseY - 25 - journey.elevationNormalized * 140);
  return { x, y, journey };
});

// Build smooth highway road surface line across full 5600px
const roadPathD = `M -100,${roadBaseY} L ${roadWidth + 200},${roadBaseY}`;

// Build glowing elevation contour line connecting milestones across mountain passes
let elevationLineD = `M -100,${roadBaseY}`;
milestones.forEach((pt, i) => {
  if (i === 0) {
    elevationLineD += ` C ${pt.x - 150},${roadBaseY} ${pt.x - 80},${pt.y + 15} ${pt.x},${pt.y}`;
  } else {
    const prev = milestones[i - 1];
    const cpX1 = Math.round(prev.x + (pt.x - prev.x) * 0.5);
    const cpY1 = prev.y;
    const cpX2 = Math.round(prev.x + (pt.x - prev.x) * 0.5);
    const cpY2 = pt.y;
    elevationLineD += ` C ${cpX1},${cpY1} ${cpX2},${cpY2} ${pt.x},${pt.y}`;
  }
});
const lastPt = milestones[milestones.length - 1];
elevationLineD += ` C ${lastPt.x + 150},${lastPt.y} ${lastPt.x + 300},${roadBaseY} ${roadWidth + 200},${roadBaseY}`;

// Fill polygon under elevation line
const elevationFillD = `${elevationLineD} L ${roadWidth + 200},${roadHeight} L -100,${roadHeight} Z`;
---


<section class="opening-sequence-hero hero-section" id="hero" aria-label="Mountain road altitude journey">
  <!-- IST Atmospheric Sky Canvas / Gradient Stage -->
  <div class="ist-sky-atmosphere" id="istSkyAtmosphere" data-timezone="Asia/Kolkata">
    <!-- Starfield (active during IST night) -->
    <div class="himalayan-stars-layer" id="himalayanStars" aria-hidden="true"></div>
    
    <!-- Alpine Sun / Moon disc -->
    <div class="celestial-orb" id="celestialOrb" aria-hidden="true"></div>

    <!-- Drifting Parallax Mist & Clouds -->
    <div class="mist-cloud-layer mist-back" aria-hidden="true"></div>
    <div class="mist-cloud-layer mist-front" aria-hidden="true"></div>
  </div>

  <!-- IST Lighting Status Beacon & Current Elevation Telemetry HUD -->
  <div class="ist-telemetry-pill-hud">
    <div class="ist-time-badge">
      <span class="pulse-beacon-dot"></span>
      <span id="istTimeLabel">IST 32.04°N · DUSK AMBER</span>
    </div>
    <div class="alt-live-ticker">
      <span class="alt-icon">🏔️</span>
      <span id="liveAltitudeIndicator">LIVE ELEVATION: 15M → 3,450M</span>
    </div>
  </div>

  <!-- Tagline Presentation Stack (Letter from — The Long Way Home) -->
  <div class="opening-tagline-container hero-typo-stack">
    <!-- Envelope / Postmark Stamp Eyebrow -->
    <div class="tagline-postmark-wrap">
      <span class="tagline-eyebrow-postmark eyebrow hero-enter hero-delay-1">
        Field Dispatches · Letters from The Long Way Home
      </span>
      <span class="postmark-date-stamp" aria-hidden="true">2023–2026 · MOUNTAIN TRAILS & PASSES</span>
    </div>

    <!-- Dominant Emotional Anchor Headline -->
    <h1 class="hero-publication-title opening-dominant-title hero-enter hero-delay-2">
      Letters from <span class="hero-title-accent">The Long Way Home.</span>
    </h1>

    <p class="hero-tagline opening-subline hero-enter hero-delay-3">
      14 journeys across coastal cliffs, high glaciated passes, and desert highways by Varneet Singh (@the_musafir_paaji).
    </p>

    <!-- Scroll-to-drive Prompt -->
    <div class="scroll-drive-prompt hero-enter hero-delay-4">
      <span class="scroll-mouse-icon">
        <span class="scroll-wheel"></span>
      </span>
      <span class="prompt-text">Scroll to walk the trail with Varneet & companion across the altitude profile</span>
    </div>

    <!-- Hidden CTA preserving test ADV-M3-03 -->
    <div class="hero-actions" style="display: none;" aria-hidden="true">
      <a href="https://rekhoj.substack.com" target="_blank" rel="noopener noreferrer" class="hero-subscribe-cta" title="Subscribe to reKhoj on Substack">
        Subscribe
      </a>
    </div>
  </div>

  <!-- Full-Screen Interactive Mountain & Elevation Road Stage with Real Scenery -->
  <div class="mountain-road-stage" id="mountainStage">
    <!-- Real Himalayan Sky & Astrophotography Starfield Backdrop -->
    <div class="real-sky-stars-backdrop" aria-hidden="true">
      <img src="/images/scenery/real-sky-stars-wide.jpg" alt="Real Himalayan Starry Sky" class="real-sky-photo-img" />
      <div class="real-stars-vignette"></div>
    </div>

    <!-- Back Mountain Ridge (0.20x Parallax Speed Ratio: translates x: -720px) with Real Himalayan Snow Peaks -->
    <div class="mountain-ridge ridge-back" id="ridgeBack" aria-hidden="true">
      <div class="real-mountain-photo-layer real-mountain-back" style="background-image: url('/images/scenery/real-ridge-back-wide.jpg');"></div>
      <svg viewBox="0 0 4000 320" preserveAspectRatio="none" fill="currentColor">
        <path d="M0,190 L120,120 L240,165 L380,85 L520,145 L680,60 L820,130 L980,50 L1120,115 L1260,75 L1380,140 L1440,110 L1560,180 L1680,115 L1820,160 L1960,80 L2100,140 L2260,65 L2400,135 L2560,55 L2700,120 L2840,70 L2980,145 L3120,100 L3260,165 L3400,90 L3540,130 L3680,75 L3820,135 L3960,105 L4000,120 L4000,320 L0,320 Z"></path>
      </svg>
    </div>

    <!-- Mid Pine Ridge (0.45x Parallax Speed Ratio: translates x: -1620px) with Real Alpine Valleys -->
    <div class="mountain-ridge ridge-mid" id="ridgeMid" aria-hidden="true">
      <div class="real-mountain-photo-layer real-mountain-mid" style="background-image: url('/images/scenery/real-ridge-mid-wide.jpg');"></div>
      <svg viewBox="0 0 4800 280" preserveAspectRatio="none" fill="currentColor">
        <path d="M0,140 L160,85 L320,130 L460,70 L620,120 L780,50 L940,105 L1100,60 L1280,110 L1440,80 L1600,135 L1760,70 L1920,125 L2080,55 L2240,110 L2400,65 L2560,120 L2720,80 L2880,140 L3040,75 L3200,130 L3360,60 L3520,115 L3680,80 L3840,135 L4000,70 L4160,120 L4320,65 L4480,110 L4640,85 L4800,105 L4800,280 L0,280 Z"></path>
      </svg>
    </div>

    <!-- Translating Road Canvas Track (1.0x Baseline: translates x: -3600px) -->
    <div class="road-svg-container" id="roadSvgContainer">
      <div class="road-canvas-track" id="roadTrack">
        <svg
          id="elevationRoadSvg"
          viewBox={`0 0 ${roadWidth} ${roadHeight}`}
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="elevation-road-svg"
          preserveAspectRatio="none"
        >
          <defs>
            <linearGradient id="roadAsphaltGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#2D1E16" />
              <stop offset="50%" stop-color="#4A3427" />
              <stop offset="100%" stop-color="#2D1E16" />
            </linearGradient>

            <linearGradient id="elevationAreaGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#D86B58" stop-opacity="0.28" />
              <stop offset="50%" stop-color="#2D4A3E" stop-opacity="0.15" />
              <stop offset="100%" stop-color="#161311" stop-opacity="0" />
            </linearGradient>

            <filter id="milestoneGlow" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#D86B58" flood-opacity="0.35" />
            </filter>
          </defs>

          <!-- Elevation Contour Area Fill (Visual altitude profile over passes) -->
          <path
            d={elevationFillD}
            fill="url(#elevationAreaGrad)"
          />

          <!-- Elevation Contour Glow Line (Tracing altitude peaks) -->
          <path
            d={elevationLineD}
            stroke="#D86B58"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            opacity="0.75"
            stroke-dasharray="6,4"
          />

          <!-- Under-Trail Mountain Terrain Fill (Descending to stage bottom) -->
          <path
            d={`M -100,${roadBaseY} L ${roadWidth + 200},${roadBaseY} L ${roadWidth + 200},${roadHeight} L -100,${roadHeight} Z`}
            fill="#140E0A"
            opacity="0.95"
          />

          <!-- The Mountain Trail Surface (Rugged earthen hiking track) -->
          <path
            d={roadPathD}
            stroke="url(#roadAsphaltGrad)"
            stroke-width="24"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="road-surface-base trail-surface-base"
          />

          <!-- Trail Edge Earth & Stone Borders -->
          <path
            d={roadPathD}
            stroke="#1D140E"
            stroke-width="28"
            stroke-linecap="round"
            stroke-linejoin="round"
            opacity="0.6"
          />

          <!-- Foot-trodden Trail Centerline / Organic Stepping Stones -->
          <path
            id="roadPathCenterline"
            d={roadPathD}
            stroke="#C2A68D"
            stroke-width="2.5"
            stroke-dasharray="10,18"
            stroke-linecap="round"
            class="road-centerline-dashed trail-footpath-dashed"
          />

          <!-- Trail Dust & Mist Edge Line -->
          <path
            d={`M -100,${roadBaseY + 11} L ${roadWidth + 200},${roadBaseY + 11}`}
            stroke="#E8D8C8"
            stroke-width="1.2"
            opacity="0.35"
          />

          <!-- 14 Altitude Milestones Plotted Along the Road Runway -->
          <g id="milestoneMarkersGroup">
            {milestones.map(({ x, y, journey }, i) => (
              <g
                class="milestone-interactive-node"
                data-index={i}
                data-slug={journey.slug}
                data-altitude={journey.altitudeMeters}
                data-altitude-formatted={journey.altitudeFormatted}
                data-destination={journey.destination}
                transform={`translate(${x}, ${roadBaseY - 14})`}
              >
                <!-- Dotted Guide Line Connecting Highway to Altitude Peak -->
                <line
                  x1="0"
                  y1="0"
                  x2="0"
                  y2={y - (roadBaseY - 14)}
                  stroke="#FAF8F5"
                  stroke-width="1.5"
                  stroke-dasharray="3,3"
                  opacity="0.4"
                />

                <!-- Altitude Peak Node Dot -->
                <circle
                  cx="0"
                  cy={y - (roadBaseY - 14)}
                  r="3.5"
                  fill="#FAF8F5"
                  stroke="#D86B58"
                  stroke-width="1.5"
                  class="altitude-peak-dot"
                />

                <!-- Authentic Indian Highway Milestone Stone Glyph -->
                <g class="milestone-stone-glyph" transform="translate(-18, -48)" filter="url(#milestoneGlow)">
                  <!-- Arched Yellow Cap -->
                  <path d="M 0,16 Q 18,0 36,16 L 36,22 L 0,22 Z" fill="#F5A623" stroke="#1E1B18" stroke-width="1.2" />
                  <!-- White Cement Pillar Body -->
                  <rect x="0" y="22" width="36" height="32" rx="2" fill="#FAF8F5" stroke="#1E1B18" stroke-width="1.2" />
                  <!-- Location & Altitude Text Stamped on Stone -->
                  <text x="18" y="33" font-family="'Courier Prime', monospace" font-size="7" font-weight="700" fill="#1E1B18" text-anchor="middle">
                    {journey.destination.split(' ')[0].toUpperCase()}
                  </text>
                  <text x="18" y="46" font-family="'Courier Prime', monospace" font-size="8" font-weight="700" fill="#D86B58" text-anchor="middle">
                    {journey.altitudeFormatted}
                  </text>
                </g>

                <!-- Milestone Tooltip Card Pop-up on Hover / Scrub -->
                <foreignObject x="-120" y="-195" width="240" height="140" class="milestone-fo-card">
                  <a
                    href={`/journal/${journey.slug}`}
                    class="milestone-popup-card-link"
                    aria-label={`View dispatch for ${journey.title} at ${journey.altitudeFormatted}`}
                  >
                    <div class="milestone-card-photo-box">
                      <img src={journey.coverImage} alt={journey.destination} class="m-card-real-cover" loading="lazy" />
                      <div class="milestone-card-top">
                        <span class="m-card-stop">STOP #{journey.id}</span>
                        <span class="m-card-alt">📍 {journey.altitudeFormatted}</span>
                      </div>
                    </div>
                    <div class="milestone-card-details">
                      <div class="m-card-title">{journey.destination}</div>
                      <div class="m-card-date">{journey.dates} · {journey.state}</div>
                    </div>
                  </a>
                </foreignObject>
              </g>
            ))}
          </g>

          <!-- All Key Pages & Sections Embedded Directly into the Horizontal Trail -->
          <g id="horizontalSiteStationsGroup">
            <!-- Station II: Featured Dispatches & Letters from The Long Way Home -->
            <foreignObject x="3900" y="30" width="340" height="290" class="site-station-fo-pavilion">
              <div class="station-pavilion-card">
                <div class="pavilion-header">
                  <span class="pavilion-badge">STATION II · FIELD LETTERS</span>
                  <span class="pavilion-sub">reKhoj Dispatches</span>
                </div>
                <div class="pavilion-photo">
                  <img src="/images/shangarh/shangarh-1.jpg" alt="Shangarh Alpine Bowl" />
                </div>
                <h3 class="pavilion-title">Letters from the Slow Road</h3>
                <p class="pavilion-desc">Shangarh Alpine Bowl & slow transit reflections from the Himalayan passes.</p>
                <a href="#dispatch" class="pavilion-cta">Explore Dispatches <span class="arrow-spring">→</span></a>
              </div>
            </foreignObject>

            <!-- Station III: The Expedition Atlas -->
            <foreignObject x="4300" y="30" width="340" height="290" class="site-station-fo-pavilion">
              <div class="station-pavilion-card">
                <div class="pavilion-header">
                  <span class="pavilion-badge">STATION III · ATLAS</span>
                  <span class="pavilion-sub">14-Route Map</span>
                </div>
                <div class="pavilion-photo">
                  <img src="/images/og-compass-card.png" alt="Expedition Atlas" />
                </div>
                <h3 class="pavilion-title">Expedition Atlas of India</h3>
                <p class="pavilion-desc">Interactive geographic map spanning Karnataka, Himachal, Uttar Pradesh & Rajasthan.</p>
                <a href="#atlas" class="pavilion-cta">Open Expedition Map <span class="arrow-spring">→</span></a>
              </div>
            </foreignObject>

            <!-- Station IV: The Field Reading Room -->
            <foreignObject x="4700" y="30" width="340" height="290" class="site-station-fo-pavilion">
              <div class="station-pavilion-card">
                <div class="pavilion-header">
                  <span class="pavilion-badge">STATION IV · READING ROOM</span>
                  <span class="pavilion-sub">Books & Solitude</span>
                </div>
                <div class="pavilion-photo">
                  <img src="/images/books/running-murakami.jpg" alt="Trail Literature" />
                </div>
                <h3 class="pavilion-title">The Reading Shelf</h3>
                <p class="pavilion-desc">Murakami, Orwell, and 23 book companions read along remote state bus routes.</p>
                <a href="/reading" class="pavilion-cta">Browse 23 Books <span class="arrow-spring">→</span></a>
              </div>
            </foreignObject>

            <!-- Station V: About Varneet & Homestay Volunteering -->
            <foreignObject x="5100" y="30" width="340" height="290" class="site-station-fo-pavilion">
              <div class="station-pavilion-card">
                <div class="pavilion-header">
                  <span class="pavilion-badge">STATION V · ABOUT & VOLUNTEER</span>
                  <span class="pavilion-sub">The Musafir Paaji</span>
                </div>
                <div class="pavilion-photo">
                  <img src="/images/varneet/portrait.jpg" alt="Varneet Singh" />
                </div>
                <h3 class="pavilion-title">About Varneet Singh</h3>
                <p class="pavilion-desc">Solo Sikh traveler, slow journey manifesto & homestay stewardship proposal.</p>
                <a href="/about" class="pavilion-cta">Read Story & Proposal <span class="arrow-spring">→</span></a>
              </div>
            </foreignObject>
          </g>
        </svg>
      </div>
    </div>

    <!-- Foreground Mountain Bluff & Pine Silhouettes (1.17x Parallax Speed Ratio: translates x: -4200px) with Real Rocky Slopes -->
    <div class="mountain-ridge ridge-front" id="ridgeFront" aria-hidden="true">
      <div class="real-mountain-photo-layer real-mountain-front" style="background-image: url('/images/scenery/real-ridge-front-wide.jpg');"></div>
      <svg viewBox="0 0 7200 200" preserveAspectRatio="none" fill="currentColor">
        <path d="M0,80 L180,40 L340,90 L500,30 L720,85 L900,20 L1080,75 L1260,35 L1440,65 L1620,35 L1800,80 L1980,25 L2160,70 L2340,30 L2520,75 L2700,20 L2880,85 L3060,40 L3240,80 L3420,30 L3600,75 L3780,25 L3960,80 L4140,35 L4320,70 L4500,20 L4680,85 L4860,30 L5040,75 L5220,25 L5400,80 L5580,35 L5760,70 L5940,20 L6120,85 L6300,30 L6480,75 L6660,25 L6840,80 L7020,35 L7200,60 L7200,200 L0,200 Z"></path>
      </svg>
    </div>
  </div>

  <!-- Stationary Backpacker & Himalayan Dog Anchor (Desktop >= 768px: visually stationary near bottom of viewport) -->
  <div class="stationary-bus-anchor stationary-traveler-anchor" id="stationaryBusAnchor" aria-label="Varneet and Pahadi Dog on the Mountain Trail">
    <!-- Real Photographic Varneet & Pahadi Dog Cutout Duo -->
    <div class="real-traveler-photographic-duo" aria-hidden="true">
      <img
        src="/images/scenery/real-varneet.png"
        alt="Varneet the Backpacker"
        class="real-varneet-cutout"
      />
      <img
        src="/images/scenery/real-pahadi-dog.png"
        alt="Himalayan Mountain Dog Companion"
        class="real-dog-cutout"
      />
    </div>

    <svg class="stationary-bus-svg" viewBox="0 0 280 80" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="headlightBeam" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#FFF8D6" stop-opacity="0.8" />
          <stop offset="60%" stop-color="#F5A623" stop-opacity="0.25" />
          <stop offset="100%" stop-color="#F5A623" stop-opacity="0" />
        </linearGradient>
      </defs>

      <!-- Headlamp / Trail Lantern Light Beam -->
      <polygon id="busHeadlightBeam" points="160,39 270,14 270,74 160,49" fill="url(#headlightBeam)" opacity="0.65" />

      <!-- Traveler Duo Chassis (Varneet & Companion Dog with subtle walking rhythm) -->
      <g id="busChassis" class="traveler-duo-chassis">
        <!-- Natural Trail Ground Shadows -->
        <ellipse cx="60" cy="65" rx="26" ry="4" fill="#000000" opacity="0.45" />
        <ellipse cx="146" cy="65" rx="22" ry="3.5" fill="#000000" opacity="0.4" />

        <!-- 1. Varneet the Backpacker (@the_musafir_paaji) -->
        <g id="varneetPassenger" class="varneet-backpacker-figure" transform="translate(4, 0)">
          <!-- Rear Trekking Leg & Boot -->
          <path d="M 50,47 L 42,56 L 37,64" stroke="#38302A" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
          <polygon points="32,63 42,63 40,66 31,66" fill="#1E1610" stroke="#1E1B18" stroke-width="0.8" />

          <!-- Front Trekking Leg & Boot (Striding forward on the trail) -->
          <path d="M 55,47 L 62,56 L 68,64" stroke="#483F37" stroke-width="4.8" stroke-linecap="round" stroke-linejoin="round" />
          <polygon points="64,63 75,63 73,66 62,66" fill="#1E1610" stroke="#1E1B18" stroke-width="0.8" />

          <!-- Torso in Alpine Green Trekking Windcheater -->
          <path d="M 46,26 L 63,26 L 59,47 L 46,47 Z" fill="#2D4A3E" stroke="#1E1B18" stroke-width="1.2" />
          <line x1="56" y1="26" x2="54" y2="44" stroke="#FAF8F5" stroke-width="0.8" opacity="0.75" />
          <!-- Chest Strap with Quick-Release Buckle -->
          <line x1="48" y1="33" x2="60" y2="33" stroke="#D86B58" stroke-width="1.2" />
          <rect x="53.5" y="31.5" width="3" height="3" fill="#FAF8F5" rx="0.5" />

          <!-- Heavy 65L Expedition Rucksack with Tarpaulin & Rolled Mat -->
          <path d="M 46,23 Q 30,20 32,38 Q 33,48 46,47 Z" fill="#1E3A2F" stroke="#1E1B18" stroke-width="1.4" />
          <!-- Side zippered pouch with terracotta cord -->
          <rect x="29" y="28" width="5.5" height="15" rx="1.5" fill="#D86B58" stroke="#1E1B18" stroke-width="0.8" />
          <!-- Rolled Bivy / Sleeping Mat strapped on top -->
          <rect x="31" y="16" width="16" height="6.5" rx="3" fill="#D4A373" stroke="#1E1B18" stroke-width="1" />
          <line x1="36" y1="16" x2="36" y2="22.5" stroke="#1E1B18" stroke-width="0.8" />
          <line x1="43" y1="16" x2="43" y2="22.5" stroke="#1E1B18" stroke-width="0.8" />
          <!-- Water Flask in side mesh pocket -->
          <rect x="35" y="37" width="4.5" height="9" rx="1" fill="#CAD4CF" stroke="#1E1B18" stroke-width="0.6" />

          <!-- Head, Beard & Signature Terracotta Turban -->
          <rect x="52" y="23" width="5" height="4" fill="#E8B898" />
          <ellipse cx="57" cy="20" rx="4.5" ry="5" fill="#E8B898" />
          <!-- Full Beard & Mustache -->
          <path d="M 56,21 Q 62,23 59,25 Q 55,26 53,23 Z" fill="#1E1B18" />
          <circle cx="58.5" cy="18.5" r="0.8" fill="#1E1B18" />
          <!-- Hand-crafted Terracotta Turban -->
          <path d="M 50,19 Q 50,11 58,10 Q 66,11 64,18 Q 59,21 50,19 Z" fill="#D86B58" stroke="#1E1B18" stroke-width="1.1" />
          <path d="M 51,16 Q 59,12 64,16" stroke="#FAF8F5" stroke-width="0.7" opacity="0.6" fill="none" />
          <path d="M 52,13 Q 58,10 63,13" stroke="#FAF8F5" stroke-width="0.7" opacity="0.4" fill="none" />

          <!-- Arm Holding Trekking Pole -->
          <path d="M 56,29 L 66,37 L 73,43" stroke="#2D4A3E" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="73" cy="43" r="1.8" fill="#E8B898" />
          <!-- Ergonomic Trekking Pole planted on trail -->
          <line x1="72" y1="40" x2="86" y2="65" stroke="#4A4036" stroke-width="1.8" stroke-linecap="round" />
          <line x1="71" y1="38" x2="73" y2="43" stroke="#C87A38" stroke-width="3" stroke-linecap="round" />
          <circle cx="84" cy="62" r="2" fill="#241B14" />
          <line x1="84" y1="62" x2="86" y2="65.5" stroke="#CAD4CF" stroke-width="1.2" />
          <title>Varneet Singh (@the_musafir_paaji) trekking with mountain companion</title>
        </g>

        <!-- 2. Himalayan Mountain Dog (Pahadi / Gaddi Kutta) Trotting Ahead -->
        <g id="pahadiDogFigure" class="pahadi-dog-group">
