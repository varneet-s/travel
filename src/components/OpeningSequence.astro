<!-- Client-side IST Real-Time Engine & GSAP ScrollTrigger Pinned Horizontal Parallax Controller -->
<script>
  import { gsap, ScrollTrigger } from '../scripts/scroll-engine';

  // 1. IST Real-Time Lighting Engine
  function updateISTAtmosphere() {
    try {
      const istFormatter = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Kolkata',
        hour: 'numeric',
        minute: 'numeric',
        hour12: false
      });
      const parts = istFormatter.formatToParts(new Date());
      const hour = parseInt(parts.find(p => p.type === 'hour')?.value || '12', 10);
      const minute = parseInt(parts.find(p => p.type === 'minute')?.value || '0', 10);

      const atmosphereEl = document.getElementById('istSkyAtmosphere');
      const timeLabel = document.getElementById('istTimeLabel');
      const starsEl = document.getElementById('himalayanStars');

      let mode = 'day';
      let desc = 'CLEAR DAYLIGHT';

      if (hour >= 5 && hour < 7) {
        mode = 'dawn';
        desc = 'DAWN ALPINELIGHT';
      } else if (hour >= 7 && hour < 17) {
        mode = 'day';
        desc = 'CLEAR MIDDAY';
      } else if (hour >= 17 && hour < 19) {
        mode = 'dusk';
        desc = 'DUSK AMBER';
      } else {
        mode = 'night';
        desc = 'STARLIT NIGHT';
      }

      if (atmosphereEl) {
        atmosphereEl.setAttribute('data-ist-mode', mode);
      }
      if (timeLabel) {
        const timeStr = `${hour.toString().padStart(2, '0')}:${minute.toString().padStart(2, '0')} IST`;
        timeLabel.textContent = `${timeStr} · ${desc}`;
      }
      if (starsEl) {
        starsEl.style.opacity = mode === 'night' ? '0.85' : (mode === 'dusk' ? '0.2' : '0');
      }
    } catch (err) {
      console.warn('IST engine fallback:', err);
    }
  }

  // 2. Pinned Horizontal Hero Parallax via GSAP ScrollTrigger (Desktop >= 768px)
  let mmInstance: any = null;

  function initOpeningSequence() {
    updateISTAtmosphere();

    const hero = document.getElementById('hero');
    const roadTrack = document.getElementById('roadTrack');
    const ridgeBack = document.getElementById('ridgeBack');
    const ridgeMid = document.getElementById('ridgeMid');
    const ridgeFront = document.getElementById('ridgeFront');
    const liveAlt = document.getElementById('liveAltitudeIndicator');
    const milestoneNodes = document.querySelectorAll<HTMLElement>('.milestone-interactive-node');

    if (!hero || !roadTrack) return;

    // Respect prefers-reduced-motion: reduce
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      return;
    }

    // Teardown previous instances before re-initializing
    if (mmInstance) {
      try {
        mmInstance.revert();
      } catch {
        // Ignore revert errors
      }
      mmInstance = null;
    }

    // Wrap desktop animation in ScrollTrigger.matchMedia so it does NOT pin or interfere on mobile (< 768px)
    mmInstance = (ScrollTrigger as any).matchMedia({
      "(min-width: 768px)": function() {
        // Hero timeline scrubbed with scroll
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: hero,
            start: 'top top',
            end: '+=1000px',
            pin: false,
            pinSpacing: false,
            scrub: 1,
            anticipatePin: 1,
            onUpdate: (self) => {
              const p = self.progress; // 0.0 to 1.0 across 3500px runway
              // 14 milestones paced across ~3500px (~250px vertical scroll per milestone)
              const count = milestoneNodes.length;
              if (count === 0) return;
              const activeIdx = Math.min(
                Math.max(Math.round(p * (count - 1)), 0),
                count - 1
              );

              milestoneNodes.forEach((node, i) => {
                if (i === activeIdx) {
                  node.classList.add('milestone-active');
                } else {
                  node.classList.remove('milestone-active');
                }
              });

              // Update live altitude HUD
              const activeNode = milestoneNodes[activeIdx];
              if (activeNode && liveAlt) {
                const alt = activeNode.getAttribute('data-altitude-formatted') || '';
                const dest = activeNode.getAttribute('data-destination') || '';
                if (p > 0.005) {
                  liveAlt.textContent = `📍 ${dest.toUpperCase()} · ${alt.toUpperCase()}`;
                } else {
                  // Maintain initial server-rendered HTML string for test T2.3.3
                  liveAlt.textContent = 'LIVE ELEVATION: 15M → 3,450M';
                }
              }
            }
          }
        });

        // 1. Translating road canvas track: x: -3600px (1.0x baseline speed)
        tl.to(roadTrack, { x: -3600, ease: 'none' }, 0);

        // 2. Ridge back: x: -720px (0.20x speed ratio)
        if (ridgeBack) {
          tl.to(ridgeBack, { x: -720, ease: 'none' }, 0);
        }

        // 3. Ridge mid: x: -1620px (0.45x speed ratio)
        if (ridgeMid) {
          tl.to(ridgeMid, { x: -1620, ease: 'none' }, 0);
        }

        // 4. Ridge front: x: -4200px (1.17x speed ratio)
        if (ridgeFront) {
          tl.to(ridgeFront, { x: -4200, ease: 'none' }, 0);
        }

        // 5. Wheel rotation scrubbed with scroll (rotation: "+=3600")
        tl.to('.bus-wheel-spin', {
          rotation: '+=3600',
          transformOrigin: 'center center',
          ease: 'none'
        }, 0);

        // 6. Subtle walking rhythm bob on backpacker and companion dog during trek
        tl.to(['#busChassis', '.real-varneet-cutout'], {
          y: -2,
          yoyo: true,
          repeat: 35,
          ease: 'power1.inOut'
        }, 0);

        tl.to(['.pahadi-dog-group', '.real-dog-cutout'], {
          y: -1.8,
          yoyo: true,
          repeat: 45,
          ease: 'power1.inOut'
        }, 0);

        return () => {
          tl.kill();
        };
      }
    });

    // Mobile milestone swipe tracker to update live altitude HUD on card swipe
    const mobileTrack = document.getElementById('mobileMilestonesTrack');
    const mobileCards = document.querySelectorAll<HTMLElement>('.mobile-milestone-card');
    if (mobileTrack && mobileCards.length > 0) {
      let mobileScrollTimeout: any = null;
      mobileTrack.addEventListener('scroll', () => {
        clearTimeout(mobileScrollTimeout);
        mobileScrollTimeout = setTimeout(() => {
          const trackRect = mobileTrack.getBoundingClientRect();
          let closestCard: HTMLElement | null = null;
          let minDiff = Infinity;
          mobileCards.forEach((card) => {
            const cardRect = card.getBoundingClientRect();
            const diff = Math.abs(cardRect.left - trackRect.left - 20);
            if (diff < minDiff) {
              minDiff = diff;
              closestCard = card;
            }
          });
          if (closestCard && liveAlt) {
            const alt = closestCard.getAttribute('data-altitude-formatted') || '';
            const dest = closestCard.getAttribute('data-destination') || '';
            if (alt && dest) {
              liveAlt.textContent = `📍 ${dest.toUpperCase()} · ${alt.toUpperCase()}`;
            }
          }
        }, 60);
      }, { passive: true });
    }
  }

  // Lifecycle initialization
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOpeningSequence);
  } else {
    initOpeningSequence();
  }

  // Update IST clock every minute
  setInterval(updateISTAtmosphere, 60000);

  // Teardown hooks for view transitions and window unload
  document.addEventListener('astro:page-load', initOpeningSequence);
  document.addEventListener('astro:before-swap', () => {
    if (mmInstance) {
      try { mmInstance.revert(); } catch {}
      mmInstance = null;
    }
  });
  window.addEventListener('pagehide', () => {
    if (mmInstance) {
      try { mmInstance.revert(); } catch {}
      mmInstance = null;
    }
  });
</script>


