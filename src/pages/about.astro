---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About & Volunteer — the_musafir_paaji (reKhoj)"
  description="Slow travel archives, volunteering pitch, and direct contact for hostel and homestay collaborations."
>
  <!-- Section 1: About reKhoj -->
  <div class="section-light">
    <div class="content-narrow">
      <div>
        <span class="eyebrow">About · reKhoj</span>
        <h1 class="display-title" style="margin-top: 8px;">the_musafir_paaji</h1>
        <p style="margin-top: 6px; color: var(--text-light-muted); font-size: 14px;">
          @the_musafir_paaji · Punjab, India
        </p>
      </div>

      <img
        src="/images/varneet/shangarh-about.jpg"
        alt="reKhoj — the_musafir_paaji in Shangarh"
        style="width: 100%; border-radius: 16px; margin: 28px 0; aspect-ratio: 16 / 10; object-fit: cover;"
      />

      <div class="prose-block">
        <p>
          I travel slowly, mostly across Himachal Pradesh, high-altitude passes, and quiet valleys where daily rhythm is shaped by weather, river currents, and seasonal roads.
        </p>

        <p>
          This site is an archive of journeys taken on foot and local buses: unhurried field notes, photographs from trails, book reflections gathered along the way, and practical itineraries for travelers looking to experience the mountains without rushing.
        </p>

        <p>
          Between trips, I look for meaningful volunteering opportunities at homestays, hostels, and eco-initiatives — helping with storytelling, day-to-day hosting, and community presence.
        </p>
      </div>
    </div>
  </div>

  <!-- Section 2: Volunteering Pitch -->
  <div id="volunteer" class="section-dark">
    <div class="content-narrow">
      <div>
        <span class="eyebrow">For Hostels & Homestays</span>
        <h2 class="section-title" style="margin-top: 8px;">
          A guest’s-eye view, with hands-on help.
        </h2>
        <p style="margin-top: 12px; color: var(--text-dark-secondary);">
          I contribute practically to homestays, mountain hostels, and conservation retreats across Himachal.
        </p>
      </div>

      <div style="margin-top: 48px;">
        <span class="eyebrow" style="margin-bottom: 24px;">What I Bring — Ordered by Strength</span>

        <div class="pitch-item" style="border-bottom: 1px solid var(--border-on-dark);">
          <div class="pitch-header">
            <span class="pitch-number">01</span>
            <h3 class="card-title" style="color: var(--text-dark-primary);">Content & Digital Presence</h3>
          </div>
          <p style="color: var(--text-dark-secondary);">
            Proven, hands-on experience managing social media and digital storytelling for LLA (Labour Law Advisor). I don’t treat digital work as an abstract hobby — I know how to document quiet everyday moments, shoot clean natural photos, write authentic long-form copy, and handle day-to-day community interaction without turning a stay into a staged commercial setup.
          </p>
        </div>

        <div class="pitch-item" style="border-bottom: 1px solid var(--border-on-dark);">
          <div class="pitch-header">
            <span class="pitch-number">02</span>
            <h3 class="card-title" style="color: var(--text-dark-primary);">Front Desk & Operations</h3>
          </div>
          <p style="color: var(--text-dark-secondary);">
            Comfortable handling guest coordination, check-ins, supply inventory, and the daily running of a space. Organized, dependable with logistics, and happy to troubleshoot whatever needs handling to keep operations smooth and guests comfortable.
          </p>
        </div>

        <div class="pitch-item" style="border-bottom: 1px solid var(--border-on-dark);">
          <div class="pitch-header">
            <span class="pitch-number">03</span>
            <h3 class="card-title" style="color: var(--text-dark-primary);">Care & Presence</h3>
          </div>
          <p style="color: var(--text-dark-secondary);">
            Naturally patient, calm, and grounded. I am genuinely comfortable with quiet, routine, or repetitive tasks — whether that means tending to a small reading corner, sorting kitchen provisions, or keeping common areas warm and welcoming through long quiet afternoons.
          </p>
        </div>

        <div class="pitch-item" style="border-bottom: none;">
          <div class="pitch-header">
            <span class="pitch-number">04</span>
            <h3 class="card-title" style="color: var(--text-dark-primary);">Open to Learning</h3>
          </div>
          <p style="color: var(--text-dark-secondary);">
            Anything beyond this: trail clearing, kitchen prep, gardening, or odd repairs. I take directions easily, don’t mind getting my hands dirty, and respect the rhythm of local mountain life.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Section 3: Direct Contact -->
  <div id="contact" class="section-light">
    <div class="content-narrow">
      <div>
        <span class="eyebrow">Get in Touch</span>
        <h2 class="section-title" style="margin-top: 8px;">
          Say hello or propose a stay.
        </h2>
        <p style="margin-top: 12px; color: var(--text-light-secondary);">
          Whether you run a mountain property looking for a volunteer, have a question about a trail, or want to discuss an itinerary — send a direct message on Instagram.
        </p>
      </div>

      <div style="margin-top: 32px;">
        <span class="eyebrow" style="margin-bottom: 8px;">Instagram Direct</span>
        <a
          href="https://instagram.com/the_musafir_paaji"
          target="_blank"
          rel="noopener noreferrer"
          class="accent-link"
          style="font-size: 1.35rem; font-family: var(--font-serif);"
        >
          @the_musafir_paaji →
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
