---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  'name': 'About Varneet (@the_musafir_paaji)',
  'description': 'Slow travel archives, volunteering pitch for Himalayan mountain homestays, and field route documentation.',
  'mainEntity': {
    '@type': 'Person',
    'name': 'Varneet Singh',
    'alternateName': 'the_musafir_paaji',
    'image': 'https://travel.varneet.in/images/varneet/shangarh-about.jpg',
    'sameAs': [
      'https://instagram.com/the_musafir_paaji',
      'https://www.goodreads.com/user/show/202026328-varneet-singh'
    ],
    'jobTitle': 'Slow Traveler & Homestay Volunteer',
    'knowsAbout': ['Himalayan Routes', 'Content Storytelling', 'Homestay Operations', 'Backpacking Logistics']
  }
};
---

<BaseLayout
  title="About & Volunteer — the_musafir_paaji (reKhoj)"
  description="Slow travel archives, host collaboration pitch for mountain homestays, and direct contact for hostel stays across Himachal Pradesh."
  image="/images/varneet/shangarh-about.jpg"
  jsonLd={jsonLd}
>
  <!-- Section 1: About reKhoj -->
  <div class="section-light">
    <div class="content-narrow">
      <div>
        <span class="eyebrow hero-enter hero-delay-1">About · reKhoj</span>
        <h1 class="display-title hero-enter hero-delay-2" style="margin-top: 8px;">the_musafir_paaji</h1>
        
        <!-- Mountain GPS Beacon Pill -->
        <div class="beacon-badge hero-enter hero-delay-3" style="margin-top: 10px; display: inline-flex; align-items: center; gap: 8px; background: rgba(15, 61, 48, 0.06); padding: 5px 14px; border-radius: 999px; border: 1px solid rgba(15, 61, 48, 0.1);">
          <span class="beacon-dot-wrap">
            <span class="beacon-dot-ping"></span>
            <span class="beacon-dot-core"></span>
          </span>
          <span style="font-size: 13px; color: var(--text-light-secondary); font-weight: 500;">
            @the_musafir_paaji · Punjab & Himachal Trails
          </span>
        </div>
      </div>

      <div class="hero-enter hero-delay-3" style="overflow: hidden; border-radius: 16px; margin: 28px 0; box-shadow: 0 16px 36px -12px rgba(15, 61, 48, 0.18);">
        <img
          src="/images/varneet/shangarh-about.jpg"
          alt="reKhoj — looking out over the Great Himalayan National Park alpine meadows in Shangarh"
          class="hero-photo-ambient"
          style="width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block;"
        />
      </div>

      <div class="prose-block reveal-on-scroll">
        <p>
          I travel slowly, mostly across Himachal Pradesh, high-altitude passes, and quiet valleys where daily rhythm is shaped by weather, river currents, and seasonal roads.
        </p>

        <p>
          My life on the road began in January 2023 on the coastal trails of Gokarna with Raw Diaries. Over the past three years, that initial curiosity evolved into 14 documented journeys spanning four states — Himachal Pradesh, Uttar Pradesh, Karnataka, and Rajasthan. What started as joining group departures grew into solitary winter walks through Banaras and Lucknow, guiding travelers through the seraj valley as an official trip leader in Jibhi, and spending silent weeks in Shojha.
        </p>

        <p>
          This site is an archive of those miles taken on foot and local buses: unhurried field notes, photographs from trails, book reflections gathered along the way, and practical itineraries for travelers looking to experience the mountains without rushing.
        </p>

        <p>
          Between trips, I look for meaningful volunteering opportunities at homestays, hostels, and eco-initiatives — helping with storytelling, day-to-day hosting, and community presence.
        </p>
      </div>

      <!-- 14 Journeys Chronology Retrospective Highlight Card -->
      <div class="reveal-on-scroll" style="margin-top: 36px; background: #ffffff; border: 1px solid var(--border-on-light); border-radius: 16px; padding: 28px; box-shadow: 0 10px 30px -10px rgba(15, 61, 48, 0.08);">
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px;">
          <div>
            <span class="eyebrow" style="color: var(--accent-terracotta);">The Road Archive · 2023–2026</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.4rem; color: var(--text-light-primary); margin-top: 4px;">
              14 Journeys Across 3 Years
            </h3>
          </div>
          <span class="badge-sage" style="font-size: 11.5px; padding: 3px 10px;">
            14 Recorded Trips · 4 States
          </span>
        </div>

        <p style="font-size: 14.5px; color: var(--text-light-secondary); line-height: 1.6; margin: 12px 0 18px;">
          From first-timer on the beaches of Karnataka to leading expeditions in the Himalayas and solitary temple walks in Banaras:
        </p>

        <!-- Chronology Milestone Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 20px;">
          <div style="background: var(--bg-light); padding: 14px; border-radius: 10px; border-left: 3px solid var(--accent-sage);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <span style="font-weight: 700; font-size: 13px; color: var(--text-light-primary);">2023 · Beginnings</span>
              <span style="font-size: 11px; color: var(--text-light-muted);">4 Trips</span>
            </div>
            <p style="font-size: 12.5px; color: var(--text-light-secondary); line-height: 1.45; margin: 0;">
              Gokarna (#01, where it all started), Bir Billing, Chitkul, Jibhi 2.0 with Raw Diaries.
            </p>
          </div>

          <div style="background: var(--bg-light); padding: 14px; border-radius: 10px; border-left: 3px solid var(--accent-terracotta);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <span style="font-weight: 700; font-size: 13px; color: var(--text-light-primary);">2024 · Trip Leading & Solo</span>
              <span style="font-size: 11px; color: var(--text-light-muted);">7 Trips</span>
            </div>
            <p style="font-size: 12.5px; color: var(--text-light-secondary); line-height: 1.45; margin: 0;">
              Banaras & Lucknow solos, Shangarh, Jibhi (Trip Leader #10), Spiti Circuit, Shojha solo retreat.
            </p>
          </div>

          <div style="background: var(--bg-light); padding: 14px; border-radius: 10px; border-left: 3px solid var(--accent-sage);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <span style="font-weight: 700; font-size: 13px; color: var(--text-light-primary);">2025–2026 · Expansion</span>
              <span style="font-size: 11px; color: var(--text-light-muted);">3 Trips</span>
            </div>
            <p style="font-size: 12.5px; color: var(--text-light-secondary); line-height: 1.45; margin: 0;">
              Jaisalmer & Longewala border post, Winter Shojha snow, NYE in Jibhi (#14).
            </p>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 14px; border-top: 1px solid var(--border-on-light); flex-wrap: wrap; gap: 8px;">
          <span style="font-size: 13px; color: var(--text-light-muted);">
            Includes full dates, routes, styles & tags
          </span>
          <a href="/journal" class="btn-accent" style="font-size: 13.5px; padding: 8px 18px;">
            Explore Interactive 14-Trip Archive <span class="arrow-spring">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Section 2: Volunteering Pitch (Host-Centric Reframing) -->
  <div id="volunteer" class="section-dark">
    <div class="content-narrow">
      <div class="reveal-on-scroll">
        <span class="eyebrow">For Hostels & Homestays</span>
        <h2 class="section-title" style="margin-top: 8px;">
          A guest’s-eye view, with hands-on help.
        </h2>
        <p style="margin-top: 12px; color: var(--text-dark-secondary); font-size: 1.1rem; line-height: 1.6;">
          I contribute practically to mountain homestays, backpacker hostels, and conservation retreats across Himachal Pradesh. Here is how I create direct value for your property:
        </p>
      </div>

      <!-- Host Benefit Pitch Items -->
      <div style="margin-top: 48px;">
        <span class="eyebrow reveal-on-scroll" style="margin-bottom: 24px;">What I Bring to Your Property</span>

        <!-- 01: Host Benefit — Content That Fills Rooms -->
        <div class="pitch-item reveal-on-scroll stagger-1" style="border-bottom: 1px solid var(--border-on-dark);">
          <div class="pitch-header">
            <span class="pitch-number">01</span>
            <h3 class="card-title" style="color: var(--text-dark-primary);">Storytelling that fills your rooms</h3>
          </div>
          <p style="color: var(--text-dark-secondary);">
            Proven, professional editorial and digital storytelling experience from Labour Law Advisor (LLA). I don’t treat digital presence as an abstract hobby — I capture the quiet, authentic details of your property that actually attract mindful travelers: natural-light room photography, unhurried day-in-the-life reels, long-form guides for village walks, and prompt guest DM replies that convert inquiries into confirmed bookings without cheap commercial hype.
          </p>
        </div>

        <!-- 02: Host Benefit — Operations That Let You Breathe -->
        <div class="pitch-item reveal-on-scroll stagger-2" style="border-bottom: 1px solid var(--border-on-dark);">
          <div class="pitch-header">
            <span class="pitch-number">02</span>
            <h3 class="card-title" style="color: var(--text-dark-primary);">Operations that let you breathe</h3>
          </div>
          <p style="color: var(--text-dark-secondary);">
            Dependable day-to-day coordination so you can step away without anxiety. Comfortable managing guest check-ins, tracking room inventory, balancing laundry and kitchen supply rotations, and resolving on-ground issues with a level head.
          </p>
        </div>

        <!-- 03: Host Benefit — Calm, Patient Guest Presence -->
        <div class="pitch-item reveal-on-scroll stagger-3" style="border-bottom: 1px solid var(--border-on-dark);">
          <div class="pitch-header">
            <span class="pitch-number">03</span>
            <h3 class="card-title" style="color: var(--text-dark-primary);">A calm, patient presence for your guests</h3>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap;">
            <p style="color: var(--text-dark-secondary); flex: 1; min-width: 260px;">
              Naturally grounded, quiet, and observant. I enjoy routine: brewing morning chai for arriving travelers, maintaining a warm and welcoming common room, curating a small reading corner, and having genuine, unhurried conversations that leave guests feeling truly at home.
            </p>
            <img
              src="/images/illustrations/mountain-chai.svg"
              alt="Mountain chai and pine needles illustration"
              style="width: 100px; height: auto; opacity: 0.85; flex-shrink: 0; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.15));"
              loading="lazy"
              aria-hidden="true"
            />
          </div>
        </div>

        <!-- 04: Host Benefit — Hands Ready For Whatever The Day Needs -->
        <div class="pitch-item reveal-on-scroll stagger-4" style="border-bottom: none;">
          <div class="pitch-header">
            <span class="pitch-number">04</span>
            <h3 class="card-title" style="color: var(--text-dark-primary);">Hands ready for whatever the day needs</h3>
          </div>
          <p style="color: var(--text-dark-secondary);">
            Kitchen prep during rush hours, trail clearing after rain, firewood stacking, basic property repairs, or garden maintenance. I take direction easily, respect local mountain customs, and never shy away from physical work.
          </p>
        </div>
      </div>

      <!-- Trust & Proof: Testimonials & Endorsements -->
      <div style="margin-top: 64px; padding-top: 40px; border-top: 1px solid var(--border-on-dark);">
        <span class="eyebrow reveal-on-scroll" style="margin-bottom: 24px;">Trust & Past Experience</span>
        <h3 class="reveal-on-scroll" style="font-family: var(--font-serif); font-size: 1.45rem; color: #ffffff; margin-bottom: 20px;">
          What past collaborators and hosts say
        </h3>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
          <!-- Testimonial 1: LLA Editorial / Storytelling -->
          <div class="reveal-on-scroll stagger-1" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between;">
            <p style="font-size: 14.5px; color: var(--text-dark-secondary); line-height: 1.6; font-style: italic;">
              “Varneet has a sharp instinct for clean, grounded storytelling. He doesn’t rely on clickbait or fake excitement — his focus is always on genuine clarity, community warmth, and documenting the real value of what people do.”
            </p>
            <div style="margin-top: 16px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.08);">
              <span style="display: block; font-size: 13.5px; font-weight: 600; color: var(--text-dark-primary);">Editorial Colleague</span>
              <span style="font-size: 12px; color: var(--accent-sage);">Labour Law Advisor (LLA) Social Storytelling</span>
            </div>
          </div>

          <!-- Testimonial 2: Himachal Homestay Hosting -->
          <div class="reveal-on-scroll stagger-2" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between;">
            <p style="font-size: 14.5px; color: var(--text-dark-secondary); line-height: 1.6; font-style: italic;">
              “Having Varneet at the stay brought a rare calm. He respects the silence of the village, handles guest logistics without needing constant instructions, and created photographs that showed the true charm of our rooms.”
            </p>
            <div style="margin-top: 16px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.08);">
              <span style="display: block; font-size: 13.5px; font-weight: 600; color: var(--text-dark-primary);">Himachal Homestay Host</span>
              <span style="font-size: 12px; color: var(--accent-sage);">Tirthan & Seraj Valley Retreat</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Proof of Work & Volunteering Deliverables (Respectful, No Faces) -->
      <div style="margin-top: 48px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 28px;">
        <span class="eyebrow" style="color: var(--accent-sage); margin-bottom: 8px;">Proof of Work · Tangible Deliverables</span>
        <h4 style="font-family: var(--font-serif); font-size: 1.25rem; color: #ffffff; margin-bottom: 12px;">
          What I leave behind for your property
        </h4>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-top: 16px;">
          <div style="background: rgba(255,255,255,0.04); padding: 14px; border-radius: 10px;">
            <span style="font-size: 13.5px; font-weight: 600; color: var(--text-dark-primary); display: block; margin-bottom: 4px;">📸 Property Photo Bank</span>
            <p style="font-size: 12.5px; color: var(--text-dark-secondary); line-height: 1.5;">High-res raw + edited natural light photos of rooms, dining spaces, and outdoor views for your Airbnb / Booking.com listing.</p>
          </div>
          <div style="background: rgba(255,255,255,0.04); padding: 14px; border-radius: 10px;">
            <span style="font-size: 13.5px; font-weight: 600; color: var(--text-dark-primary); display: block; margin-bottom: 4px;">🗺️ Local Walking Guide</span>
            <p style="font-size: 12.5px; color: var(--text-dark-secondary); line-height: 1.5;">A printable or digital 1-page guide to nearby village trails, viewpoints, and local teashops for your arriving guests.</p>
          </div>
          <div style="background: rgba(255,255,255,0.04); padding: 14px; border-radius: 10px;">
            <span style="font-size: 13.5px; font-weight: 600; color: var(--text-dark-primary); display: block; margin-bottom: 4px;">📊 Clean Inventory & Logs</span>
            <p style="font-size: 12.5px; color: var(--text-dark-secondary); line-height: 1.5;">Organized digital sheets for check-in records, kitchen supplies, or seasonal maintenance schedules.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section 3: Direct Contact -->
  <div id="contact" class="section-light">
    <div class="content-narrow">
      <div class="reveal-on-scroll">
        <span class="eyebrow">Get in Touch</span>
        <h2 class="section-title" style="margin-top: 8px;">
          Propose a stay or ask about a route.
        </h2>
        <p style="margin-top: 12px; color: var(--text-light-secondary); font-size: 1.1rem; line-height: 1.6;">
          Whether you run a mountain property looking for a volunteer, or a backpacker planning an unhurried route — send a message directly on Instagram.
        </p>
      </div>

      <div class="reveal-on-scroll stagger-1 contact-grid-with-qr" style="margin-top: 32px;">
        <div style="display: flex; flex-direction: column; gap: 20px;">
          <div style="background: #ffffff; border: 1px solid var(--border-on-light); border-radius: 14px; padding: 24px;">
            <span class="eyebrow" style="color: var(--accent-terracotta); margin-bottom: 6px;">Hosts & Homestays</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--text-light-primary); margin: 4px 0 8px;">
              Propose a Volunteering Collaboration
            </h3>
            <p style="font-size: 14.5px; color: var(--text-light-secondary); line-height: 1.55; margin-bottom: 16px;">
              Let me know your property location, tentative dates, and what kind of help (storytelling, hosting, operations) would make the biggest difference.
            </p>
            <a
              href="https://ig.me/m/the_musafir_paaji?text=Hey%20Varneet,%20I%20run%20a%20property%20in%20Himachal%20and%20would%20love%20to%20discuss%20a%20volunteering%20stay!"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-accent"
              style="font-size: 14px; padding: 10px 20px;"
            >
              Propose Volunteering Stay on Instagram <span class="arrow-spring">→</span>
            </a>
          </div>

          <div style="background: #ffffff; border: 1px solid var(--border-on-light); border-radius: 14px; padding: 24px;">
            <span class="eyebrow" style="color: var(--text-light-muted); margin-bottom: 6px;">Travelers & Backpackers</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--text-light-primary); margin: 4px 0 8px;">
              Itinerary Questions & Offline Packs
            </h3>
            <p style="font-size: 14.5px; color: var(--text-light-secondary); line-height: 1.55; margin-bottom: 16px;">
              Questions about trail difficulty, local bus junctions, or requesting the free offline GPX markers and homestay contact notes.
            </p>
            <a
              href="https://instagram.com/the_musafir_paaji"
              target="_blank"
              rel="noopener noreferrer"
              class="accent-link"
              style="font-size: 15px; font-weight: 600;"
            >
              DM @the_musafir_paaji on Instagram <span class="arrow-spring">→</span>
            </a>
          </div>
        </div>

        {/* Official Instagram Magic Tree QR Card with Live 3D Animation */}
        <div class="instagram-qr-card">
          <div class="qr-card-header">
            <div class="qr-tag">Official Instagram</div>
            <!-- Mode Switcher -->
            <div class="qr-mode-tabs" id="aboutQrTabs">
              <button class="qr-tab-btn active" data-mode="3d" type="button">🌲 3D Animation</button>
              <button class="qr-tab-btn" data-mode="static" type="button">📷 Scan</button>
            </div>
          </div>

          <!-- View 1: Live Interactive 3D Magic Tree Animation -->
          <div class="qr-view-container" id="aboutView3d">
            <div class="qr-scaled-viewport" id="aboutIframeViewport">
              <iframe
                id="aboutIframe"
                src="https://tree.icqr.com/s/MjBodHRwczovL3d3dy5pbnN0YWdyYW0uY29tL3RoZV9tdXNhZmlyX3BhYWppLw"
                title="Varneet Instagram Magic Tree 3D Animation - @the_musafir_paaji"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope"
                class="qr-scaled-iframe"
              ></iframe>
            </div>
            <p class="qr-live-tip">
              ✨ <strong>Tap the tree</strong> to watch it animate into the Instagram QR code
            </p>
          </div>

          <!-- View 2: High-Resolution Static 2D QR Code -->
          <div class="qr-view-container" id="aboutViewStatic" style="display: none; padding: 20px 0;">
            <a
              href="https://instagram.com/the_musafir_paaji"
              target="_blank"
              rel="noopener noreferrer"
              class="qr-frame"
              aria-label="Scan or open Varneet's Instagram profile"
            >
              <img
                src="/images/instagram-qr.png"
                alt="Varneet Instagram QR Code - @the_musafir_paaji"
                class="qr-image"
                loading="lazy"
              />
            </a>
            <div class="qr-meta" style="margin-top: 14px;">
              <span class="qr-handle">@the_musafir_paaji</span>
              <span class="qr-instruction">Scan with phone camera or click to open</span>
            </div>
          </div>

          <!-- Footer Actions -->
          <div class="qr-actions-row">
            <a
              href="https://instagram.com/the_musafir_paaji"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-accent"
              style="font-size: 13px; padding: 9px 16px; flex: 1; text-align: center;"
            >
              DM @the_musafir_paaji <span class="arrow-spring">→</span>
            </a>
            <a
              href="https://tree.icqr.com/s/MjBodHRwczovL3d3dy5pbnN0YWdyYW0uY29tL3RoZV9tdXNhZmlyX3BhYWppLw"
              target="_blank"
              rel="noopener noreferrer"
              class="qr-fullscreen-btn"
              title="Open full interactive experience"
            >
              Fullscreen ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('#aboutQrTabs .qr-tab-btn');
      const view3d = document.getElementById('aboutView3d');
      const viewStatic = document.getElementById('aboutViewStatic');
      const iframeViewport = document.getElementById('aboutIframeViewport');
      const iframe = document.getElementById('aboutIframe');

      function fitAboutIframe() {
        if (!iframeViewport || !iframe) return;
        const w = iframeViewport.clientWidth;
        if (w <= 0) return;
        const baseW = 400;
        const baseH = 640;
        const scale = w / baseW;
        iframe.style.width = `${baseW}px`;
        iframe.style.height = `${baseH}px`;
        iframe.style.transform = `scale(${scale})`;
        iframe.style.transformOrigin = 'top left';
        iframeViewport.style.height = `${Math.round(baseH * scale)}px`;
      }

      fitAboutIframe();
      window.addEventListener('resize', fitAboutIframe);

      if (tabs.length && view3d && viewStatic) {
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            tabs.forEach((t) => t.classList.remove('active'));
            tab.classList.add('active');
            const mode = tab.getAttribute('data-mode');
            if (mode === '3d') {
              view3d.style.display = 'flex';
              viewStatic.style.display = 'none';
              setTimeout(fitAboutIframe, 50);
            } else {
              view3d.style.display = 'none';
              viewStatic.style.display = 'flex';
            }
          });
        });
      }
    });
  </script>

  <style>
    .contact-grid-with-qr {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 24px;
      align-items: start;
    }

    .instagram-qr-card {
      background: #ffffff;
      border: 1px solid var(--border-on-light);
      border-radius: 18px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 12px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
