  <!-- Horizontal Scroll Mouse-Wheel Translation Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const rails = document.querySelectorAll('.letters-scroll-rail');
      rails.forEach((rail) => {
        rail.addEventListener('wheel', (e) => {
          if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
            const atStart = rail.scrollLeft <= 0 && e.deltaY < 0;
            const atEnd = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 2 && e.deltaY > 0;
            if (!atStart && !atEnd) {
              e.preventDefault();
              rail.scrollLeft += e.deltaY * 1.2;
            }
          }
        }, { passive: false });
      });
    });
  </script>
