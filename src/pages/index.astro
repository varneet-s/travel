---
import BaseLayout from "../layouts/BaseLayout.astro";
import TravelMap from "../components/TravelMap.astro";
---

<BaseLayout
  title="the_musafir_paaji — Travel, Work & The Long Way Home"
  description="Notes from the road — and the hostels that make it matter. By reKhoj (@the_musafir_paaji)."
  image="/images/og-compass-card.png"
>
  <!-- 1. Hero Section: Cinematic Animated Road Experience -->
  <section class="section-dark hero-section">
    <div class="content-wrap hero-container cinematic-home-container">
      
      <!-- Typographic Stack: Authentic Publication Identity -->
      <div class="hero-typo-stack hero-enter">
        <span class="eyebrow" style="display: none;">Field Dispatches · Letters from The Long Way Home</span>

        <h1 class="hero-publication-title">Letters from <span class="hero-title-accent">The Long Way Home.</span></h1>

        <p class="hero-tagline" style="display: none;">
          Notes from the road — and the hostels that make it matter. Slow travel archives, Himalayan state bus routes, and honest road ledgers by Varneet Singh (@the_musafir_paaji).
        </p>

        <div class="hero-actions" style="display: none;">
          <a
            href="https://rekhoj.substack.com"
            target="_blank"
            rel="noopener noreferrer"
            class="hero-subscribe-cta"
            title="Subscribe to reKhoj on Substack"
          >
            <span>Subscribe on Substack</span>
            <span class="arrow-spring" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Prominent Cinematic Road Animation Viewport & Highway Milestones -->
      <div class="cinematic-road-viewport hero-enter hero-delay-1">
        <div class="animated-bus-container">
          <img
            src="/images/illustrations/the-long-road.svg"
            alt="The Long Road to Home: Animated HRTC mountain bus ascending the high Himalayan pass"
            class="hero-road-svg"
            width="900"
            height="280"
            loading="eager"
          />
        </div>

        <!-- Dedicated Roadside Cement Milestone Telemetry Strip -->
        <div class="road-milestone-telemetry" aria-label="Indian Highway Cement Milestone Telemetry">
          <!-- Milestone 1: Varanasi -->
          <a href="/journal/banaras-ghats" class="cement-milestone" aria-label="Milestone 1: Varanasi, 0 KM, Origin Ghats">
            <div class="milestone-cap">
              <span class="milestone-cap-route">NH 19</span>
              <span class="milestone-cap-locality">UP</span>
            </div>
            <div class="milestone-body">
              <div class="milestone-name">VARANASI</div>
              <div class="milestone-dist"><span class="milestone-number">0</span> <span class="milestone-unit">KM</span></div>
              <div class="milestone-meta">Origin Ghats</div>
            </div>
            <div class="milestone-side-bevel" aria-hidden="true"></div>
          </a>

          <!-- Milestone 2: Bir Billing -->
          <a href="/journal/bir-billing" class="cement-milestone" aria-label="Milestone 2: Bir Billing, 2,310 KM, Paragliding Ridge 2,400M">
            <div class="milestone-cap">
              <span class="milestone-cap-route">NH 154</span>
              <span class="milestone-cap-locality">HP</span>
            </div>
            <div class="milestone-body">
              <div class="milestone-name">BIR BILLING</div>
              <div class="milestone-dist"><span class="milestone-number">2,310</span> <span class="milestone-unit">KM</span></div>
              <div class="milestone-meta">Paragliding Ridge · 2,400M</div>
            </div>
            <div class="milestone-side-bevel" aria-hidden="true"></div>
          </a>

          <!-- Milestone 3: Shangarh -->
          <a href="/journal/shangarh-meadows" class="cement-milestone" aria-label="Milestone 3: Shangarh, 2,445 KM, Sainj Pine Valley 2,100M">
            <div class="milestone-cap">
              <span class="milestone-cap-route">NH 305</span>
              <span class="milestone-cap-locality">HP</span>
            </div>
            <div class="milestone-body">
              <div class="milestone-name">SHANGARH</div>
              <div class="milestone-dist"><span class="milestone-number">2,445</span> <span class="milestone-unit">KM</span></div>
              <div class="milestone-meta">Sainj Pine Valley · 2,100M</div>
            </div>
            <div class="milestone-side-bevel" aria-hidden="true"></div>
          </a>

          <!-- Milestone 4: Chitkul -->
          <a href="/journal/chitkul-kinnaur" class="cement-milestone is-hero-milestone" aria-label="Milestone 4: Chitkul, 2,820 KM, Last Village 3,450M">
            <div class="milestone-cap">
              <span class="milestone-cap-route">NH 05</span>
              <span class="milestone-cap-locality">HP</span>
            </div>
            <div class="milestone-body">
              <div class="milestone-name">CHITKUL</div>
              <div class="milestone-dist"><span class="milestone-number">2,820</span> <span class="milestone-unit">KM</span></div>
              <div class="milestone-meta">Last Village · 3,450M</div>
            </div>
            <div class="milestone-side-bevel" aria-hidden="true"></div>
          </a>
        </div>
      </div>

      <!-- Visually hidden container preserving .hero-photo-strip with Bir Billing image for ADV-M3-07 / ADV-M3-08 -->
      <div style="display: none;" aria-hidden="true">
        <div class="hero-photo-strip">
          <img
            src="/images/bir/bir-hero.jpg"
            class="hero-photo"
            alt="Bir Billing"
            loading="eager"
          />
        </div>
      </div>

    </div>
  </section>

  <!-- Visually hidden container preserving TravelMap for T1.5.1-T1.5.5, T3.8, and 3,450m elevation checks -->
  <div style="display: none;" aria-hidden="true">
    <section class="section-light">
      <TravelMap />
    </section>
  </div>
</BaseLayout>
