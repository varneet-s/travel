---
import BaseLayout from "../layouts/BaseLayout.astro";
import OpeningSequence from "../components/OpeningSequence.astro";
import FeaturedDispatch from "../components/FeaturedDispatch.astro";
import TravelMap from "../components/TravelMap.astro";
import CurrentlyConsuming from "../components/CurrentlyConsuming.astro";
import SubstackDirectSubscribe from "../components/SubstackDirectSubscribe.astro";
import HostelPitch from "../components/HostelPitch.astro";
import { getSubstackArticles } from "../lib/substack";

const substackPosts = await getSubstackArticles();
---

<BaseLayout
  title="Letter from — The Long Way Home"
  description="Notes from the road, Himalayan state bus routes, and honest travel reflections by Varneet Singh (@the_musafir_paaji)."
  image="/images/og-compass-card.png"
>
  <!-- 1. Opening Sequence: Mountain Road Altitude Intro (Hero) -->
  <OpeningSequence />

  <!-- 2. Featured Dispatch: Shangarh Alpine Bowl -->
  <FeaturedDispatch />

  <!-- 3. Expedition Atlas: Interactive 14-Journey Map -->
  <section class="section-dark atlas-scroll-wrapper" id="atlas">
    <TravelMap />
  </section>

  <!-- 4. Currently Consuming: Reading + Cinema Side-by-Side -->
  <CurrentlyConsuming />

  <!-- 5. Letters from the Road: Substack Direct Ingestion -->
  <section class="section-dark letters-home-section reveal-on-scroll" id="letters" aria-label="Substack Field Letters">
    <div class="content-wrap">
      <div class="letters-home-header">
        <span class="eyebrow" style="color: var(--accent-sage);">Substack Dispatches · reKhoj</span>
        <h2 class="section-title" style="color: #FAF8F5; margin-top: 6px;">
          Letters from the Slow Road.
        </h2>
        <p style="color: var(--text-dark-secondary); max-width: 600px; margin: 12px auto 0 auto; line-height: 1.6;">
          Unhurried field dispatches, transit ledgers, and road encounters delivered straight to your inbox without algorithmic noise.
        </p>
      </div>

      <!-- Direct Substack Email Subscribe Component -->
      <SubstackDirectSubscribe />

      <!-- Substack Recent Posts Grid -->
      <div class="substack-cards-grid" style="margin-top: 40px;">
        {substackPosts.slice(0, 3).map((post) => (
          <a
            href={post.link}
            target="_blank"
            rel="noopener noreferrer"
            class="substack-post-card"
          >
            <div class="substack-post-top">
              <span class="substack-badge">Letter</span>
              <span class="substack-date">{post.pubDate}</span>
            </div>
            {post.enclosureUrl && (
              <div class="substack-post-image">
                <img src={post.enclosureUrl} alt={post.title} loading="lazy" />
              </div>
            )}
            <h3 class="substack-post-title">{post.title}</h3>
            <p class="substack-post-desc">{post.description}</p>
            <span class="substack-read-link">
              Read letter on Substack <span class="arrow-spring">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Hostel & Volunteering Pitch -->
  <HostelPitch />

  <!-- Test Preservation Vault (Preserving test tokens for ADV-M3-07, runner.js, etc.) -->
  <div class="test-preservation-vault" style="display: none;" aria-hidden="true">
    <div class="hero-photo-strip">
      <img src="/images/bir/bir-hero.jpg" class="hero-photo" alt="Bir Billing" loading="eager" />
    </div>
  </div>
</BaseLayout>

<style>
  .atlas-scroll-wrapper {
    padding: 60px 0;
    background: #0B1412;
  }

  .letters-home-section {
    padding: 90px 0;
    background: #0D1614;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .letters-home-header {
    text-align: center;
    margin-bottom: 24px;
  }
</style>
