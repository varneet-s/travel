---
import BaseLayout from "../layouts/BaseLayout.astro";
import goodreadsData from "../data/goodreadsCache.json";

const currentlyReading = goodreadsData.currentlyReading || [];

const bookPastels = [
  {
    accent: "#F7E4A1",
    accentText: "text-[#F7E4A1]",
    accentBg: "bg-[#F7E4A1]/10",
    accentBorder: "border-[#F7E4A1]/30",
    hoverBorder: "hover:border-[#F7E4A1]/40",
    barBg: "bg-[#F7E4A1]",
    bgNumber: "text-[#F7E4A1]/[0.08] group-hover:text-[#F7E4A1]/[0.16]",
  },
  {
    accent: "#F7C5D4",
    accentText: "text-[#F7C5D4]",
    accentBg: "bg-[#F7C5D4]/10",
    accentBorder: "border-[#F7C5D4]/30",
    hoverBorder: "hover:border-[#F7C5D4]/40",
    barBg: "bg-[#F7C5D4]",
    bgNumber: "text-[#F7C5D4]/[0.08] group-hover:text-[#F7C5D4]/[0.16]",
  },
  {
    accent: "#F45B69",
    accentText: "text-[#F45B69]",
    accentBg: "bg-[#F45B69]/10",
    accentBorder: "border-[#F45B69]/30",
    hoverBorder: "hover:border-[#F45B69]/40",
    barBg: "bg-[#F45B69]",
    bgNumber: "text-[#F45B69]/[0.08] group-hover:text-[#F45B69]/[0.16]",
  },
  {
    accent: "#77C5A0",
    accentText: "text-[#77C5A0]",
    accentBg: "bg-[#77C5A0]/10",
    accentBorder: "border-[#77C5A0]/30",
    hoverBorder: "hover:border-[#77C5A0]/40",
    barBg: "bg-[#77C5A0]",
    bgNumber: "text-[#77C5A0]/[0.08] group-hover:text-[#77C5A0]/[0.16]",
  },
];

// Chronological Substack travel letters (Kangra Valley, Jaipur, Jodhpur, Bir Billing)
const chronologicalLetters = [
  {
    id: "kangra",
    step: "01",
    counter: "01 / 04",
    season: "Spring 2023",
    destination: "Kangra Valley, Himachal Pradesh",
    altitude: "1,525m · Dhauladhar Foothills",
    title: "Ridge Lines and First High Air",
    summary:
      "We spent afternoons walking the upper rim toward Billing, watching gliders trace quiet arcs against the Dhauladhar range. At sunset, the entire Kangra valley turns amber, then deep slate blue. The pine air is cold and thin, carrying the murmur of mountain streams and evening monastery bells.",
    reflection:
      "The first lesson of the northern ridges: time expands the moment you stop watching the clock and start watching the fog shift across the terraced tea fields.",
    substackUrl: "https://rekhoj.substack.com",
    tag: "Mountain Foothills · Field Log #01",
    pastel: {
      accent: "#77C5A0",
      accentText: "text-[#77C5A0]",
      accentBg: "bg-[#77C5A0]/10",
      accentBorder: "border-[#77C5A0]/30",
      hoverBorder: "hover:border-[#77C5A0]/40",
      bgNumber: "text-[#77C5A0]/[0.08] group-hover:text-[#77C5A0]/[0.16]",
      quoteBorder: "border-l-[#77C5A0]/60",
    }
  },
  {
    id: "jaipur",
    step: "02",
    counter: "02 / 04",
    season: "Autumn 2023",
    destination: "Jaipur, Rajasthan",
    altitude: "431m · Aravalli Ridge",
    title: "The Terracotta Gates & Old Bazaars",
    summary:
      "Early dawn chai behind the terracotta arches of Hawa Mahal, watching the pink stone wash into morning sunlight. Navigating stepwells carved deep into ancient stone, the geometric staircases casting geometric shadows under a calm desert sky.",
    reflection:
      "In the walled city, every brass door and spice courtyard has survived centuries of caravans. The rhythm is entirely unhurried if you choose the narrow side alleys.",
    substackUrl: "https://rekhoj.substack.com",
    tag: "Desert Caravan · Field Log #02",
    pastel: {
      accent: "#F7E4A1",
      accentText: "text-[#F7E4A1]",
      accentBg: "bg-[#F7E4A1]/10",
      accentBorder: "border-[#F7E4A1]/30",
      hoverBorder: "hover:border-[#F7E4A1]/40",
      bgNumber: "text-[#F7E4A1]/[0.08] group-hover:text-[#F7E4A1]/[0.16]",
      quoteBorder: "border-l-[#F7E4A1]/60",
    }
  },
  {
    id: "jodhpur",
    step: "03",
    counter: "03 / 04",
    season: "Winter 2024",
    destination: "Jodhpur, Rajasthan",
    altitude: "231m · Thar Border",
    title: "The Blue Labyrinth & Desert Asphalt",
    summary:
      "Fourteen continuous days on the road across Rajasthan. An endless ribbon of asphalt stretching under Mehrangarh's towering ramparts. Walking the narrow indigo lanes of Navchokiya, where cool sandstone walls protect against the dry desert wind.",
    reflection:
      "Desert travel strips away everything unnecessary. Miles of open sand and cold winter dawns bring clarity you never find in crowded transit terminals.",
    substackUrl: "https://rekhoj.substack.com",
    tag: "Buransh Trail · Field Log #03",
    pastel: {
      accent: "#F45B69",
      accentText: "text-[#F45B69]",
      accentBg: "bg-[#F45B69]/10",
      accentBorder: "border-[#F45B69]/30",
      hoverBorder: "hover:border-[#F45B69]/40",
      bgNumber: "text-[#F45B69]/[0.08] group-hover:text-[#F45B69]/[0.16]",
      quoteBorder: "border-l-[#F45B69]/60",
    }
  },
  {
    id: "bir-return",
    step: "04",
    counter: "04 / 04",
    season: "Winter 2025–2026",
    destination: "Bir Billing, Himachal Pradesh",
    altitude: "2,400m · Dhauladhar Range",
    title: "Winter Sky & Monastic Silence",
    summary:
      "Returning to Bir after three years. Crisp zero-degree nights under an untamed canopy of Himalayan stars. The prayer flags flutter in the icy evening drafts from the upper ridges. Unhurried notebooks, wooden stoves, and the enduring rhythm of mountain winter.",
    reflection:
      "Coming back to a place you once loved reveals not how the mountains have changed, but how much quieter you have become inside.",
    substackUrl: "https://rekhoj.substack.com",
    tag: "Cherry Blossom · Field Log #04",
    pastel: {
      accent: "#F7C5D4",
      accentText: "text-[#F7C5D4]",
      accentBg: "bg-[#F7C5D4]/10",
      accentBorder: "border-[#F7C5D4]/30",
      hoverBorder: "hover:border-[#F7C5D4]/40",
      bgNumber: "text-[#F7C5D4]/[0.08] group-hover:text-[#F7C5D4]/[0.16]",
      quoteBorder: "border-l-[#F7C5D4]/60",
    }
  }
];
---

<BaseLayout
  title="Letters from — The Long way Home."
  description="Notes from the road, Himalayan state bus routes, and honest travel reflections by Varneet Singh (@the_musafir_paaji)."
  image="/images/scenery/real-mountains-himachal.jpg"
>
  <!-- ================================================================= -->
  <!-- 1. HERO SECTION (Mobile-First, 100vh Full Viewport Mountain Visual)-->
  <!-- ================================================================= -->
  <!-- ================================================================= -->
  <!-- 1. HERO SECTION (Mobile-First, 100vh Viewport with Billowing Clouds)-->
  <!-- ================================================================= -->
  <section
    id="hero"
    class="relative h-screen h-[100vh] min-h-[100dvh] w-full overflow-hidden flex flex-col justify-between select-none"
    aria-label="Hero: Letters from The Long Way Home."
  >
    <!-- Background: Mountain visual covering exactly 100% of the viewport height -->
    <img
      src="/images/scenery/real-mountains-himachal.jpg"
      alt="Snow-covered Himalayan peaks in Himachal Pradesh"
      class="absolute inset-0 w-full h-full h-screen h-[100vh] object-cover object-center pointer-events-none"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Atmospheric Mountain Clouds & Drifting Mist Layers -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden select-none z-[4]" aria-hidden="true">
      <!-- Billowy Cloud Cluster 1 (Upper Left Sky, Drifting) -->
      <div class="absolute top-[6%] -left-[8%] w-[550px] md:w-[750px] h-[220px] opacity-75 blur-md animate-cloud-left">
        <svg viewBox="0 0 600 220" fill="none" class="w-full h-full">
          <path d="M50 180 C30 180 10 160 10 140 C10 115 30 95 60 95 C70 50 120 20 175 25 C215 10 270 25 295 65 C330 45 385 55 410 90 C450 85 490 110 495 150 C525 150 550 170 550 190 C550 210 520 220 490 220 L50 220 Z" fill="url(#cumulus-grad-1)" />
          <path d="M120 160 C100 160 85 145 85 130 C85 110 105 95 130 95 C140 65 180 40 225 45 C255 35 300 45 320 75 C350 60 395 70 415 95 C445 95 470 115 470 145 C470 170 440 180 410 180 L120 180 Z" fill="url(#cumulus-grad-2)" />
        </svg>
      </div>

      <!-- Billowy Cloud Cluster 2 (Upper Right Peak, Drifting opposite) -->
      <div class="absolute top-[10%] -right-[10%] w-[600px] md:w-[850px] h-[260px] opacity-70 blur-md animate-cloud-right">
        <svg viewBox="0 0 650 240" fill="none" class="w-full h-full">
          <path d="M80 190 C50 190 30 170 30 145 C30 120 55 95 85 95 C100 55 150 25 205 30 C250 15 310 30 335 70 C375 50 435 60 460 100 C505 95 550 120 555 160 C585 165 610 185 610 210 C610 230 580 240 550 240 L80 240 Z" fill="url(#cumulus-grad-1)" />
        </svg>
      </div>

      <!-- Cloud Layer 3: Summit Crest Mist (Wisps directly clinging to the mountain summit) -->
      <div class="absolute top-[16%] left-[15%] right-[15%] h-[180px] opacity-65 blur-xl animate-cloud-left">
        <svg viewBox="0 0 800 160" fill="none" class="w-full h-full">
          <ellipse cx="400" cy="80" rx="360" ry="60" fill="url(#mist-grad-center)" />
          <ellipse cx="320" cy="85" rx="220" ry="45" fill="url(#mist-grad-bright)" />
          <ellipse cx="480" cy="75" rx="200" ry="40" fill="url(#mist-grad-bright)" />
        </svg>
      </div>

      <!-- Cloud Layer 4: Wide Valley Mist Rolling Along the Mid-Slopes -->
      <div class="absolute top-[36%] -left-[20%] w-[140%] h-[240px] opacity-45 blur-2xl animate-cloud-right bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>

      <!-- Cloud Layer 5: Deep Pine Forest Ground Fog -->
      <div class="absolute bottom-0 left-0 w-full h-[38vh] opacity-60 blur-3xl animate-mist bg-gradient-to-t from-[#0A1C20] via-white/15 to-transparent"></div>

      <!-- Shared Cloud Gradients -->
      <svg class="absolute w-0 h-0" aria-hidden="true">
        <defs>
          <linearGradient id="cumulus-grad-1" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.85" />
            <stop offset="40%" stop-color="#f0f7f6" stop-opacity="0.6" />
            <stop offset="85%" stop-color="#d9ebe8" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#0A1C20" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="cumulus-grad-2" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.9" />
            <stop offset="60%" stop-color="#ffffff" stop-opacity="0.5" />
            <stop offset="100%" stop-color="#e0eff0" stop-opacity="0" />
          </linearGradient>
          <radialGradient id="mist-grad-center" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.75" />
            <stop offset="50%" stop-color="#eaf4f3" stop-opacity="0.4" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="mist-grad-bright" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.85" />
            <stop offset="60%" stop-color="#f5faf9" stop-opacity="0.3" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
          </radialGradient>
        </defs>
      </svg>
    </div>

    <!-- Ambient Dark Gradient Scrim: Delicate balance preserving mountain & cloud visibility -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-[#0A1C20]/40 via-[#0A1C20]/20 to-[#0A1C20] pointer-events-none z-[5]"
      aria-hidden="true"
    ></div>

    <!-- Top-Left Corner: "Letters from" (Flush to top-left corner, no container margins) -->
    <div class="absolute top-5 left-4 sm:top-8 sm:left-8 md:top-10 md:left-10 z-20 flex items-center gap-2 text-left">
      <span class="w-3.5 sm:w-5 h-[1px] bg-[#77C5A0]/80"></span>
      <p class="font-sans text-[10px] sm:text-xs uppercase tracking-[0.28em] text-[#77C5A0] font-medium">
        Letters from
      </p>
    </div>

    <!-- Center: "THE LONG WAY HOME." using all horizontal space with 1:5 word-to-character ratio -->
    <div class="relative z-10 w-full px-2 sm:px-4 md:px-6 my-auto py-2">
      <h1 class="sr-only">The Long Way Home.</h1>
      <svg
        viewBox="0 0 1200 90"
        class="w-full h-auto block select-none drop-shadow-2xl overflow-visible"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <text
          x="0"
          y="75"
          textLength="174.3"
          lengthAdjust="spacing"
          font-family="'Oswald', sans-serif"
          font-weight="900"
          font-size="80"
          fill="#FFFFFF"
        >THE</text>
        <text
          x="272.0"
          y="75"
          textLength="252.6"
          lengthAdjust="spacing"
          font-family="'Oswald', sans-serif"
          font-weight="900"
          font-size="80"
          fill="#FFFFFF"
        >LONG</text>
        <text
          x="622.3"
          y="75"
          textLength="189.2"
          lengthAdjust="spacing"
          font-family="'Oswald', sans-serif"
          font-weight="900"
          font-size="80"
          fill="#FFFFFF"
        >WAY</text>
        <text
          x="909.2"
          y="75"
          textLength="290.8"
          lengthAdjust="spacing"
          font-family="'Oswald', sans-serif"
          font-weight="900"
          font-size="80"
          fill="#FFFFFF"
        >HOME.</text>
      </svg>
    </div>

    <!-- Bottom-Right Corner: Subtitle (Flush to bottom-right corner with mobile clearance) -->
    <div class="absolute bottom-10 sm:bottom-8 md:bottom-10 right-4 sm:right-8 md:right-10 z-20 flex justify-end">
      <p class="font-sans text-[10px] sm:text-xs md:text-sm text-white/75 leading-relaxed tracking-wide font-normal max-w-[165px] sm:max-w-xs md:max-w-sm text-right">
        Slow routes across Himachal, Rajasthan &amp; the coastal south. Field notebooks, bus ledgers, and honest stories from the trail.
      </p>
    </div>

    <!-- Bottom-Center: Just Downward Arrow -->
    <div class="absolute bottom-3 sm:bottom-6 left-1/2 -translate-x-1/2 z-20 flex justify-center items-center">
      <a
        href="#letters"
        class="inline-flex items-center justify-center p-2 text-white/60 hover:text-[#77C5A0] transition-colors duration-200 group"
        aria-label="Scroll down to explore letters"
      >
        <svg
          class="w-5 h-5 text-white/70 group-hover:text-[#77C5A0] transition-transform duration-300 group-hover:translate-y-1.5 animate-bounce"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 2. SUBSTACK LETTERS (Vita Travel Bento Grid + Extreme Whitespace)  -->
  <!-- ================================================================= -->
  <!-- ================================================================= -->
  <!-- ================================================================= -->
  <!-- 2. THE TRAIL · FIELD NOTES (Horizontal Bento Grid)                 -->
  <!-- ================================================================= -->
  <section
    id="letters"
    class="relative w-full pt-16 pb-6 sm:pt-20 sm:pb-8 md:pt-24 md:pb-8 bg-[#0A1C20] border-t border-white/10 overflow-hidden"
    aria-label="The Trail · Chronological Field Notes"
  >
    <!-- Background Ambient Glow & Empty Whitespace Canvas -->
    <div class="absolute inset-0 pointer-events-none opacity-20" aria-hidden="true">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] md:w-[900px] h-[600px] md:h-[900px] rounded-full bg-[#12292E] blur-3xl"></div>
    </div>

    <!-- Section Content Container -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 md:px-8">

      <!-- Section Editorial Header -->
      <div class="relative max-w-3xl mb-8 sm:mb-12 md:mb-14">
        <div class="flex items-center gap-3 mb-4 sm:mb-6">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#77C5A0]/10 border border-[#77C5A0]/30 text-[#77C5A0] text-xs font-sans tracking-widest uppercase">
            <span>Field Notes</span>
            <span>·</span>
            <span>2023–2026</span>
          </div>
          <span class="text-[11px] font-mono tracking-widest text-[#77C5A0]/60 uppercase hidden sm:inline-block">
            Hover to scroll horizontally →
          </span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-white font-normal tracking-tight leading-tight">
          The Trail
        </h2>
        <p class="mt-3 sm:mt-4 font-sans text-sm sm:text-base md:text-lg text-white/60 max-w-2xl leading-relaxed">
          Unfolding slowly across the mountains and desert ridges. Each dispatch documents quiet moments, state bus tickets, and lessons learned on foot.
        </p>

        <!-- Fun Factor Illustration 1: Open Doodles Chilling Figure floating in header whitespace -->
        <div class="absolute -top-12 right-0 sm:-top-16 md:-top-24 md:-right-8 w-24 h-24 sm:w-36 sm:h-36 md:w-52 md:h-52 pointer-events-none opacity-80 select-none">
          <img
            src="/images/doodles/chilling.svg"
            alt="Playful doodle character floating in open mountain air"
            class="w-full h-full object-contain filter drop-shadow-lg"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Horizontal Bento Grid: Scrollable horizontally with mouse wheel & touch swipe -->
      <div class="letters-scroll-rail flex flex-row gap-6 sm:gap-8 snap-x snap-mandatory overflow-x-auto [&::-webkit-scrollbar]:h-1.5 [&::-webkit-scrollbar-thumb]:bg-white/15 [&::-webkit-scrollbar-thumb]:rounded-full py-4 scroll-smooth">
        {chronologicalLetters.map((letter, index) => {
          return (
            <article
              id={`letter-card-${letter.id}`}
              class={`group relative flex flex-col justify-between p-4 sm:p-8 md:p-12 rounded-2xl sm:rounded-3xl bg-[#12292E] border border-white/10 ${letter.pastel.hoverBorder} transition-all duration-300 shadow-xl overflow-hidden w-[72vw] min-w-[240px] max-w-[265px] sm:w-auto sm:min-w-[400px] sm:max-w-[540px] flex-shrink-0 snap-start`}
            >
              <!-- Editorial Background Number in Newsreader serif -->
              <div
                class={`absolute -top-3 sm:-top-6 md:-top-8 -right-1 sm:-right-4 md:-right-6 font-serif text-5xl sm:text-7xl md:text-9xl ${letter.pastel.bgNumber} transition-colors duration-500 select-none pointer-events-none leading-none z-0`}
                aria-hidden="true"
              >
                {letter.step}
              </div>

              <!-- Top Row: Editorial Step Number, Season, and Altitude Metric -->
              <div class="relative z-10 flex flex-wrap items-center justify-between gap-2 pb-3 sm:pb-6 border-b border-white/10">
                <div class="flex items-center gap-2 sm:gap-3">
                  <span class={`font-mono text-xs sm:text-base ${letter.pastel.accentText} font-bold tracking-wider`}>
                    {letter.step}
                  </span>
                  <span class="text-white/25">/</span>
                  <span class="font-sans text-[10px] sm:text-xs uppercase tracking-widest text-white/60 font-medium">
                    {letter.season}
                  </span>
                </div>

                <!-- Prominent Altitude / Ridge Metric -->
                <span class={`inline-flex items-center gap-1.5 text-[11px] sm:text-xs font-mono ${letter.pastel.accentText} ${letter.pastel.accentBg} px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-full border ${letter.pastel.accentBorder}`}>
                  <svg class={`w-3 h-3 ${letter.pastel.accentText}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {letter.altitude}
                </span>
              </div>

              <!-- Card Core Narrative -->
              <div class="relative z-10 py-3 sm:py-6 flex-grow">
                <p class={`font-sans text-[10px] sm:text-xs uppercase tracking-[0.2em] ${letter.pastel.accentText} font-semibold mb-1.5 sm:mb-3`}>
                  {letter.destination}
                </p>

                <h3 class="font-serif text-lg sm:text-2xl md:text-3xl text-white font-normal tracking-tight mb-2 sm:mb-4 group-hover:text-white/95 transition-colors">
                  {letter.title}
                </h3>

                <p class="font-sans text-xs sm:text-sm md:text-base text-white/80 leading-relaxed mb-3 sm:mb-5 font-normal line-clamp-3 sm:line-clamp-none">
                  {letter.summary}
                </p>

                <blockquote class={`font-serif italic text-xs sm:text-sm text-white/70 border-l-2 ${letter.pastel.quoteBorder} pl-3 sm:pl-5 py-0.5 sm:py-1 mb-1 sm:mb-2 line-clamp-2 sm:line-clamp-none`}>
                  "{letter.reflection}"
                </blockquote>
              </div>

              <!-- Card Footer: Tag & Season Info -->
              <div class="relative z-10 flex items-center justify-between gap-3 pt-3 sm:pt-6 border-t border-white/10">
                <span class="text-[10px] sm:text-xs font-mono text-white/40 tracking-wide">
                  {letter.tag}
                </span>
                <span class={`text-[10px] sm:text-xs font-mono ${letter.pastel.accentText}`}>
                  {letter.season}
                </span>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Fun Factor Illustration 2: Playful Trail Dog nestled tightly under bento rail -->
      <div class="relative w-full flex justify-end mt-2 sm:mt-3 pointer-events-none select-none">
        <div class="w-20 h-14 sm:w-28 sm:h-20 md:w-36 md:h-24 opacity-60 mr-4 sm:mr-8 md:mr-12">
          <img
            src="/images/doodles/doggie.svg"
            alt="Playful doodle dog running along the empty trail whitespace"
            class="w-full h-full object-contain filter drop-shadow-md"
            loading="lazy"
          />
        </div>
      </div>

    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 3. MY LIBRARY (Trail Companions Bento Grid)                        -->
  <!-- ================================================================= -->
  <section
    id="reading"
    class="relative w-full pt-8 pb-16 sm:pt-10 sm:pb-20 md:pt-12 md:pb-24 bg-[#12292E] border-t border-white/10 overflow-hidden"
    aria-label="My Library"
  >
    <!-- Section Container -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 md:px-8">

      <!-- Section Header with hand-drawn motif & Open Doodles reader -->
      <div class="relative flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 sm:pb-10 md:pb-12 border-b border-white/10">
        <div class="max-w-2xl">
          <!-- Hand-drawn Open Book Outline Doodle in Pastel Seafoam -->
          <div class="w-10 h-10 mb-3 text-[#77C5A0] flex items-center justify-center">
            <svg class="w-8 h-8" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
