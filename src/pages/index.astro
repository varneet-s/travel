---
import BaseLayout from '../layouts/BaseLayout.astro';
import { itineraries } from '../data/itineraries';
import TravelMap from '../components/TravelMap.astro';
---

<BaseLayout
  title="the_musafir_paaji — Travel, Work & The Long Way Home"
  description="Notes from the road — and the hostels that make it matter. By reKhoj (@the_musafir_paaji)."
  image="/images/bir/bir-hero.jpg"
>
  <!-- 1. Hero Section (Dark Pine #0E2E25) with Live Basecamp Status -->
  <section class="section-dark" style="padding-top: 28px;">
    <div class="content-wrap hero-wrap">
      <div class="hero-text-block">
        <span class="eyebrow hero-enter hero-delay-1">Travel, Work & The Long Way Home</span>
        <h1 class="display-title hero-enter hero-delay-2">
          Notes from the road — and the hostels that make it matter.
        </h1>
        <p class="hero-lead-text hero-enter hero-delay-3">
          I’m reKhoj (@the_musafir_paaji) — a slow traveller, curious volunteer, and keeper of practical routes for anyone who wants to go farther without rushing.
        </p>

        <!-- Live Basecamp Status Widget (Return-Visit Hook) -->
        <div class="beacon-badge hero-enter hero-delay-4" style="margin-top: 20px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); padding: 8px 18px; border-radius: 999px; width: fit-content;">
          <span class="beacon-dot-wrap">
            <span class="beacon-dot-ping"></span>
            <span class="beacon-dot-core"></span>
          </span>
          <span style="font-size: 13.5px; color: var(--text-dark-primary); font-weight: 500;">
            Currently at: 📍 <strong>Bir Billing, HP</strong> · 32.05° N, 76.71° E · <em>Next trail: Tirthan Valley</em>
          </span>
        </div>
      </div>

      <div class="hero-photo-frame hero-enter hero-delay-3">
        <img
          src="/images/bir/bir-hero.jpg"
          alt="Mountain ridges and alpine mist in Himachal Pradesh"
          class="hero-photo hero-photo-ambient"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- 2. Featured Journey / Story (Visual, First-Person, No Price Tag) -->
  <section class="section-light">
    <div class="content-wrap">
      <div class="reveal-on-scroll" style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 24px;">
        <div>
          <span class="eyebrow" style="color: var(--accent-terracotta);">Featured Story from the Road</span>
          <h2 class="section-title" style="margin-top: 4px;">The quiet meadow ridge of Shangarh</h2>
        </div>
        <a href="/journal/shangarh-meadows" class="accent-link" style="font-weight: 600;">
          Read full dispatch <span class="arrow-spring">→</span>
        </a>
      </div>

      <article class="itinerary-bento-card reveal-on-scroll stagger-1" style="background: #ffffff; text-decoration: none;">
        <img
          src="/images/shangarh/shangarh-1.jpg"
          alt="Shangarh meadows and traditional wooden temple in Sainj Valley"
          class="itinerary-card-img"
          style="min-height: 280px;"
          loading="lazy"
        />
        <div class="itinerary-card-info" style="display: flex; flex-direction: column; justify-content: space-between; padding: 28px;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px;">
              <span class="eyebrow">Sainj Valley · Field Notes</span>
              <span style="font-size: 12.5px; color: var(--text-light-muted);">Field Journal · 2,100m</span>
            </div>

            <h3 style="font-family: var(--font-serif); font-size: 1.6rem; color: var(--text-light-primary); line-height: 1.25; margin-bottom: 12px;">
              Where the road ends and the deodar forest takes over.
            </h3>

            <p style="font-size: 15px; color: var(--text-light-secondary); line-height: 1.65; margin-bottom: 18px;">
              “The bus from Aut dropped me at the edge of the gorge. The meadow opened up like a carpet between giant deodars, and for four days the only sound was the evening bell from the Sangchul Mahadev temple and rain falling on wooden shingles.”
            </p>

            <div style="background: var(--bg-light); border-radius: 8px; padding: 10px 14px; border-left: 3px solid var(--accent-sage); margin-bottom: 20px;">
              <span style="font-size: 12px; color: var(--text-light-muted); display: block;">Trail companion</span>
              <span style="font-size: 13.5px; color: var(--text-light-primary); font-style: italic;">
                Reading Murakami’s <em>Men Without Women</em> on the wooden balcony in the quiet afternoons.
              </span>
            </div>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 16px; border-top: 1px solid var(--border-on-light);">
            <span style="font-size: 13px; color: var(--text-light-muted);">
              Photographs & route diary
            </span>
            <a href="/journal/shangarh-meadows" class="accent-link" style="font-weight: 600; font-size: 14.5px;">
              Read Field Story <span class="arrow-spring">→</span>
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Expedition Atlas / World Journey Map (All 14 Journeys) -->
  <TravelMap />

  <!-- 3. Curated Free Itineraries (All 3 Live, Zero Paywalls) -->
  <section class="section-dark">
    <div class="content-wrap">
      <div class="itinerary-section-header reveal-on-scroll">
        <div style="display: flex; flex-direction: column; gap: 8px; max-width: 620px;">
          <span class="eyebrow">Curated Route Guides · 100% Free</span>
          <h2 class="section-title">
            Go slower. Spend less. See more.
          </h2>
          <p style="color: var(--text-dark-secondary); font-size: 15.5px; line-height: 1.6;">
            Tested day-by-day transit plans, local bus timetables, and homestay recommendations. Completely free open field guides for independent travelers.
          </p>
        </div>
        <div class="badge-sage">
          3 Free Route Guides
        </div>
      </div>

      <!-- 3 Itineraries Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 36px;">
        {itineraries.map((itinerary, idx) => (
          <article class={`itinerary-bento-card reveal-on-scroll stagger-${idx + 1}`} style="display: flex; flex-direction: column; background: #ffffff;">
            <div style="height: 190px; overflow: hidden;">
              <img
                src={itinerary.image}
                alt={itinerary.title}
                class="itinerary-card-img"
                style="height: 100%; width: 100%; object-fit: cover;"
                loading="lazy"
              />
            </div>
            <div class="itinerary-card-info" style="display: flex; flex-direction: column; justify-content: space-between; flex: 1; padding: 22px;">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
                  <span class="eyebrow">{itinerary.duration}</span>
                  <span class="badge-sage" style="font-size: 10.5px; padding: 2px 7px;">
                    🌿 {itinerary.bestSeason.split('&')[0].trim()}
                  </span>
                </div>
                <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--text-light-primary); margin: 6px 0 8px;">
                  <a href={`/itineraries/${itinerary.slug}`} style="color: inherit; text-decoration: none;">
                    {itinerary.title}
                  </a>
                </h3>
                <p style="font-size: 14px; color: var(--text-light-secondary); line-height: 1.55; margin-bottom: 14px;">
                  {itinerary.overview}
                </p>
                <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 16px;">
                  {itinerary.moodTags.slice(0, 3).map((tag) => (
                    <span style="font-size: 11px; color: var(--text-light-muted); background: var(--bg-light); padding: 2px 7px; border-radius: 4px;">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid var(--border-on-light); margin-top: auto;">
                <span style="font-size: 13px; color: #55756B; font-weight: 600;">
                  Free Guide & Map
                </span>
                <a href={`/itineraries/${itinerary.slug}`} class="accent-link" style="font-size: 14px; font-weight: 600;">
                  Read Route <span class="arrow-spring">→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="reveal-on-scroll" style="margin-top: 36px; text-align: center;">
        <a href="/itineraries" class="btn-accent" style="display: inline-block;">
          Browse All Route Guides & Day Notes <span class="arrow-spring">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. Interactive Route Matcher: "Which Valley Matches Your Mood?" -->
  <section class="section-light">
    <div class="content-wrap">
      <div class="reveal-on-scroll" style="background: #ffffff; border: 1px solid var(--border-on-light); border-radius: 18px; padding: 36px 32px; box-shadow: 0 10px 30px -10px rgba(14, 46, 37, 0.08);">
        <div style="max-width: 600px;">
          <span class="eyebrow" style="color: var(--accent-terracotta);">Interactive Route Matcher</span>
          <h2 style="font-family: var(--font-serif); font-size: 1.65rem; color: var(--text-light-primary); margin-top: 6px;">
            Which valley matches your travel mood?
          </h2>
          <p style="font-size: 15px; color: var(--text-light-secondary); margin-top: 8px;">
            Pick what you need right now, and see the best Himalayan route for your pace:
          </p>
        </div>

        <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px;" id="moodQuizButtons">
          <button class="mood-choice-btn active" data-valley="tirthan" data-title="Tirthan Valley & GHNP" data-desc="Trout streams, clean riverbanks, and shade walks through ancient cedar woods. Ideal for quiet reading and slow days." data-link="/itineraries/tirthan-gnhp-retreat">
            🌲 River silence & reading
          </button>
          <button class="mood-choice-btn" data-valley="spiti" data-title="Spiti Valley Circuit" data-desc="Stark 4,000m moonscapes, mud-brick monasteries, fossil villages, and sleeping beneath glaciated passes." data-link="/itineraries/spiti-valley-circuit">
            🏔️ High passes & cold desert
          </button>
          <button class="mood-choice-btn" data-valley="parvati" data-title="Parvati: Grahan & Pulga" data-desc="Footpath-only hamlets, rhododendron trails, zero motor noise, and village timber balconies." data-link="/itineraries/parvati-grahan-trail">
            🥾 Forest footpaths & village life
          </button>
        </div>

        <!-- Result Box -->
        <div id="moodQuizResult" style="margin-top: 24px; background: var(--bg-light); border-radius: 12px; padding: 20px 24px; border-left: 4px solid var(--accent-terracotta); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
          <div>
            <span class="eyebrow" style="font-size: 10.5px; color: var(--text-light-muted);">Recommended Route</span>
            <h4 id="resultTitle" style="font-family: var(--font-serif); font-size: 1.35rem; color: var(--text-light-primary); margin: 2px 0;">
              Tirthan Valley & GHNP Retreat
            </h4>
            <p id="resultDesc" style="font-size: 14.5px; color: var(--text-light-secondary); margin-top: 4px; max-width: 580px; line-height: 1.5;">
              Trout streams, clean riverbanks, and shade walks through ancient cedar woods. Ideal for quiet reading and slow days.
            </p>
          </div>
          <a id="resultLink" href="/itineraries/tirthan-gnhp-retreat" class="btn-accent" style="font-size: 14px; padding: 10px 20px; white-space: nowrap;">
            Open Route Guide <span class="arrow-spring">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Currently Reading Section (Cross-Linked to Trails) -->
  <section class="section-dark">
    <div class="content-wrap">
      <div class="reading-split-grid">
        <a href="/reading" class="book-cover-bento reveal-on-scroll" aria-label="1984 by George Orwell — Currently Reading">
          <div class="book-realistic-mockup">
            <img
              src="/images/books/1984.jpg"
              alt="1984 by George Orwell book cover"
              loading="lazy"
            />
            <div class="book-realistic-spine-highlight"></div>
          </div>
        </a>

        <div class="reveal-on-scroll stagger-1" style="display: flex; flex-direction: column; gap: 16px;">
          <span class="eyebrow" style="color: var(--accent-sage);">Currently Reading · Trail Companion</span>
          <h2 class="section-title">
            1984 by George Orwell
          </h2>
          <p style="color: var(--text-dark-secondary); font-size: 15.5px; line-height: 1.65;">
            Carried across the Parvati valley. In an age of endless feeds and digital noise, Orwell’s examination of language, memory, and truth feels sharper when read beside a rushing mountain river.
          </p>

          <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 12px 16px;">
            <span style="font-size: 13px; color: var(--accent-sage); font-weight: 600;">
              📍 Read on the Grahan trail · Page 47 of 304 (15%)
            </span>
            <span style="display: block; font-size: 12.5px; color: var(--text-dark-muted); margin-top: 4px;">
              Also reading Haruki Murakami’s <em>Men Without Women</em> on quiet afternoons.
            </span>
          </div>

          <div style="margin-top: 8px; display: flex; gap: 18px; flex-wrap: wrap; align-items: center;">
            <a href="/reading" class="accent-link" style="color: #ffffff;">
              Explore reading logs & shelf notes <span class="arrow-spring">→</span>
            </a>
            <a
              href="https://www.goodreads.com/user/show/202026328-varneet-singh"
              target="_blank"
              rel="noopener noreferrer"
              class="accent-link"
              style="color: var(--text-dark-muted); font-size: 14px;"
            >
              Goodreads profile (14 read · to-read list) <span class="arrow-spring">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Newsletter / Dispatches Capture (Traffic-First Retention) -->
  <section class="section-light">
    <div class="content-wrap">
      <div class="reveal-on-scroll" style="background: var(--bg-dark); color: var(--text-dark-primary); border-radius: 18px; padding: 40px 32px; border: 1px solid rgba(255,255,255,0.1); text-align: center; max-width: 680px; margin: 0 auto;">
        <span class="eyebrow" style="color: var(--accent-sage);">Dispatches from the Slow Road</span>
        <h2 style="font-family: var(--font-serif); font-size: 1.8rem; margin-top: 8px; color: #ffffff;">
          Letters from the Long Way Home
        </h2>
        <p style="margin-top: 10px; font-size: 15px; color: var(--text-dark-secondary); line-height: 1.6; max-width: 520px; margin-left: auto; margin-right: auto;">
          A quiet, monthly letter with unhurried trail notes, new Himachal bus timetables, book reflections, and photographs. No algorithms, no spam.
        </p>

        <form
          id="newsletterForm"
          style="margin-top: 24px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;"
          onsubmit="event.preventDefault(); document.getElementById('nlMessage').style.display='block'; this.reset();"
        >
          <input
            type="email"
            placeholder="Your email address..."
            required
            style="padding: 12px 18px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.08); color: #ffffff; font-size: 15px; min-width: 260px; font-family: var(--font-sans);"
          />
          <button type="submit" class="btn-accent" style="padding: 12px 24px; font-size: 15px;">
            Join the Dispatches <span class="arrow-spring">→</span>
          </button>
        </form>

        <div id="nlMessage" style="display: none; margin-top: 14px; font-size: 13.5px; color: var(--accent-sage);">
          ✓ Welcome to the quiet dispatches. You'll hear from me when the next trail is walked.
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Volunteering / Host Pitch (Pushed to Bottom as Secondary CTA) -->
  <section class="section-light" style="padding-top: 0;">
    <div class="content-wrap">
      <div class="split-grid-2" style="border-top: 1px solid var(--border-on-light); padding-top: 48px;">
        <div class="reveal-on-scroll" style="display: flex; flex-direction: column; gap: 14px;">
          <span class="eyebrow">For Hostels & Homestays</span>
          <h2 class="section-title">
            A guest’s-eye view, with hands-on help.
          </h2>
          <p style="font-size: 15px; color: var(--text-light-secondary); line-height: 1.6;">
            Between long walks, I volunteer at homestays and mountain hostels: storytelling that fills rooms, operations that let you breathe, and a calm, dependable presence for your guests.
          </p>
          <div style="margin-top: 4px;">
            <a href="/about#volunteer" class="accent-link" style="font-weight: 600;">
              Read host collaboration pitch <span class="arrow-spring">→</span>
            </a>
          </div>
        </div>

        <a href="/about#volunteer" class="volunteering-bento-card reveal-on-scroll stagger-1" style="text-decoration: none;">
          <div class="card-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
              <path d="M6 6h10"></path>
              <path d="M6 10h10"></path>
            </svg>
          </div>
          <h3 class="card-title" style="color: var(--text-dark-primary);">
            A useful pair of hands
          </h3>
          <p style="font-size: 14px;">
            Editorial storytelling (LLA experience) · front desk & inventory · quiet common-room care · odd repairs
          </p>
          <span style="font-size: 13px; color: var(--accent-sage); font-weight: 500; margin-top: 10px; display: inline-block;">
            Host benefits & testimonials →
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Quiz Script -->
  <script is:inline>
    const moodButtons = document.querySelectorAll('.mood-choice-btn');
    const resultTitle = document.getElementById('resultTitle');
    const resultDesc = document.getElementById('resultDesc');
    const resultLink = document.getElementById('resultLink');

    moodButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        moodButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        if (resultTitle) resultTitle.innerText = btn.getAttribute('data-title');
        if (resultDesc) resultDesc.innerText = btn.getAttribute('data-desc');
        if (resultLink) resultLink.setAttribute('href', btn.getAttribute('data-link'));
      });
    });
  </script>

  <style>
    .mood-choice-btn {
      background: var(--bg-light);
      border: 1px solid var(--border-on-light);
      color: var(--text-light-primary);
      font-size: 14px;
      font-weight: 500;
      padding: 10px 18px;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: var(--font-sans);
    }
    .mood-choice-btn:hover {
      border-color: var(--accent-terracotta);
      color: var(--accent-terracotta);
    }
    .mood-choice-btn.active {
      background: var(--bg-dark);
      color: #ffffff;
      border-color: var(--bg-dark);
    }
  </style>
</BaseLayout>

