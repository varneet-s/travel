---
import BaseLayout from '../layouts/BaseLayout.astro';
import { itineraries } from '../data/itineraries';
---

<BaseLayout
  title="the_musafir_paaji — Travel, Work & The Long Way Home"
  description="Notes from the road — and the hostels that make it matter. By reKhoj (@the_musafir_paaji)."
  image="/images/bir/bir-hero.jpg"
>
  <!-- 1. Hero Section (Dark Green #0E2E25) with Tubik Hero Animation -->
  <section class="section-dark" style="padding-top: 24px;">
    <div class="content-wrap hero-wrap">
      <div class="hero-text-block">
        <span class="eyebrow hero-enter hero-delay-1">Travel, Work & The Long Way Home</span>
        <h1 class="display-title hero-enter hero-delay-2">
          Notes from the road — and the hostels that make it matter.
        </h1>
        <p class="hero-lead-text hero-enter hero-delay-3">
          I’m reKhoj (@the_musafir_paaji) — a slow traveller, curious volunteer, and keeper of practical routes for anyone who wants to go farther without spending more.
        </p>

        <!-- Live GPS Mountain Beacon (Accent Animation) -->
        <div class="beacon-badge hero-enter hero-delay-4" style="margin-top: 18px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); padding: 7px 16px; border-radius: 999px; width: fit-content;">
          <span class="beacon-dot-wrap">
            <span class="beacon-dot-ping"></span>
            <span class="beacon-dot-core"></span>
          </span>
          <span style="font-size: 13px; color: var(--text-dark-secondary); font-weight: 500; letter-spacing: 0.02em;">
            Live base · 32.05° N, 76.71° E · Bir Billing, HP
          </span>
        </div>
      </div>

      <div class="hero-photo-frame hero-enter hero-delay-3">
        <img
          src="/images/bir/bir-hero.jpg"
          alt="Mountain ridges and alpine mist in Himachal Pradesh"
          class="hero-photo hero-photo-ambient"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- 2. Volunteering / For Hostels Section (Mountain Mist #EFF3F0) -->
  <section class="section-light">
    <div class="content-wrap">
      <div class="split-grid-2">
        <div class="reveal-on-scroll" style="display: flex; flex-direction: column; gap: 16px;">
          <span class="eyebrow">For Hostels & Homestays</span>
          <h2 class="section-title">
            A guest’s-eye view, with hands-on help.
          </h2>
          <p>
            I can help shape warm guest experiences, photograph the details that make your place memorable, write story-led social copy, and bring order to the everyday rhythm of a mountain stay.
          </p>
          <div style="margin-top: 8px;">
            <a href="/about#volunteer" class="accent-link" style="font-weight: 600;">
              Read volunteering pitch & host benefits <span class="arrow-spring">→</span>
            </a>
          </div>
        </div>

        <a href="/about#volunteer" class="volunteering-bento-card reveal-on-scroll stagger-1" style="text-decoration: none;">
          <div class="card-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
              <path d="M6 6h10"></path>
              <path d="M6 10h10"></path>
            </svg>
          </div>
          <h3 class="card-title" style="color: var(--text-dark-primary);">
            A useful pair of hands
          </h3>
          <p>
            Storytelling that fills rooms · operations that let you breathe · calm hosting presence · trail research
          </p>
          <span style="font-size: 13.5px; color: var(--accent-sage); font-weight: 500; margin-top: 10px; display: inline-block;">
            View host collaboration details →
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. Journeys & Affordable Itineraries Section (Dark Pine #0E2E25) -->
  <section class="section-dark">
    <div class="content-wrap">
      <div class="itinerary-section-header reveal-on-scroll">
        <div style="display: flex; flex-direction: column; gap: 12px; max-width: 620px;">
          <span class="eyebrow">Journeys & Affordable Itineraries</span>
          <h2 class="section-title">
            Go slower. Spend less. See more.
          </h2>
          <p>
            Full, practical itineraries made for a modest budget: transit schedules, offline GPX trail markers, and direct homestay contacts.
          </p>
        </div>
        <div class="badge-sage">
          3 Live Guides · ₹59 each
        </div>
      </div>

      <!-- All 3 Itineraries Showcase Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 36px;">
        {itineraries.map((itinerary, idx) => (
          <article class={`itinerary-bento-card reveal-on-scroll stagger-${idx + 1}`} style="display: flex; flex-direction: column; background: #ffffff;">
            <div style="height: 180px; overflow: hidden;">
              <img
                src={itinerary.image}
                alt={itinerary.title}
                class="itinerary-card-img"
                style="height: 100%; width: 100%; object-fit: cover;"
                loading="lazy"
              />
            </div>
            <div class="itinerary-card-info" style="display: flex; flex-direction: column; justify-content: space-between; flex: 1; padding: 20px;">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
                  <span class="eyebrow">{itinerary.region}</span>
                  <span class="badge-sage" style="font-size: 11px; padding: 2px 7px;">
                    {itinerary.duration}
                  </span>
                </div>
                <h3 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--text-light-primary); margin: 6px 0;">
                  {itinerary.title}
                </h3>
                <p style="font-size: 14px; color: var(--text-light-secondary); line-height: 1.5; margin-bottom: 14px;">
                  {itinerary.overview}
                </p>
              </div>

              <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid var(--border-on-light); margin-top: auto;">
                <span style="font-size: 14px; font-weight: 700; color: var(--accent-terracotta);">
                  {itinerary.price} Guide
                </span>
                <a href={`/itineraries/${itinerary.slug}`} class="accent-link" style="font-size: 14px; font-weight: 600;">
                  Route & GPX <span class="arrow-spring">→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="reveal-on-scroll" style="margin-top: 36px; text-align: center;">
        <a href="/itineraries" class="btn-accent" style="display: inline-block;">
          Browse All Itineraries & GPX Packs <span class="arrow-spring">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. Currently Reading Section (Cream #FBF7EE) -->
  <section class="section-light">
    <div class="content-wrap">
      <div class="reading-split-grid">
        <!-- Book Cover Bento Card with Real Goodreads Cover -->
        <a href="/reading" class="book-cover-bento reveal-on-scroll" aria-label="1984 by George Orwell — Currently Reading on Goodreads">
          <div class="book-realistic-mockup">
            <img
              src="/images/books/1984.jpg"
              alt="1984 by George Orwell book cover"
              loading="lazy"
            />
            <div class="book-realistic-spine-highlight"></div>
          </div>
        </a>

        <!-- Reading Description & Status from Goodreads -->
        <div class="reveal-on-scroll stagger-1" style="display: flex; flex-direction: column; gap: 16px;">
          <span class="eyebrow">Currently Reading · Goodreads</span>
          <h2 class="section-title">
            1984 by George Orwell
          </h2>
          <p>
            Reading for the second time. In an age of endless feeds and digital noise, Orwell’s examination of language, memory, and truth feels sharper with every reread.
          </p>
          <div class="reading-status-pill">
            Page 47 of 304 · 15% through · Also reading Haruki Murakami’s <em>Men Without Women</em>
          </div>
          <div style="margin-top: 8px; display: flex; gap: 18px; flex-wrap: wrap; align-items: center;">
            <a href="/reading" class="accent-link">
              Explore reading logs <span class="arrow-spring">→</span>
            </a>
            <a
              href="https://www.goodreads.com/user/show/202026328-varneet-singh"
              target="_blank"
              rel="noopener noreferrer"
              class="accent-link"
              style="color: var(--text-light-muted); font-size: 14px;"
            >
              Goodreads profile (14 read · to-read list) <span class="arrow-spring">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
