---
import BaseLayout from '../../layouts/BaseLayout.astro';

const currentlyReading = [
  {
    title: '1984',
    author: 'George Orwell',
    cover: '/images/books/1984.jpg',
    note: 'Reading for the 2nd time. An enduring examination of surveillance, language, and memory.',
    progress: 'Page 47 of 304 · 15%',
    tag: 'Classic · Dystopia · Philosophy',
    link: 'https://www.goodreads.com/book/show/230149114-1984',
  },
  {
    title: 'Men Without Women',
    author: 'Haruki Murakami',
    cover: '/images/books/men-without-women.jpg',
    note: 'Short stories on solitude, longing, quiet estrangement, and what remains behind.',
    progress: 'Page 55 of 228 · 24%',
    tag: 'Literary · Contemporary Fiction',
    link: 'https://www.goodreads.com/book/show/36114337-men-without-women',
  },
  {
    title: 'What I Talk About When I Talk About Running',
    author: 'Haruki Murakami',
    cover: '/images/books/running-murakami.jpg',
    note: 'Memoir on daily distance running, physical endurance, routine, and the craft of writing.',
    progress: 'Page 81 of 180 · 45%',
    tag: 'Memoir · Non-fiction · Discipline',
    link: 'https://www.goodreads.com/book/show/57025000-what-i-talk-about-when-i-talk-about-running',
  },
];

const readingHighlights = [
  {
    shelf: 'Memoirs & Journeys',
    desc: 'Writings on solitude, discipline, and the physical weight of movement across terrain.',
  },
  {
    shelf: 'Classics & Modern Fiction',
    desc: 'Stories that challenge perception, explore existential longing, and stay with you for decades.',
  },
  {
    shelf: 'Philosophy & Human Nature',
    desc: 'Deep investigations into resilience, societal structures, and inner stillness.',
  },
];
---

<BaseLayout
  title="Reading Logs — the_musafir_paaji"
  description="Books carried in the backpack, currently reading shelves, and Goodreads reflections."
>
  <div class="section-light">
    <div class="content-narrow">
      <div>
        <span class="eyebrow hero-enter hero-delay-1">Goodreads Library & Backpack Books</span>
        <h1 class="display-title hero-enter hero-delay-2" style="margin-top: 8px;">Reading</h1>
        <p class="hero-enter hero-delay-3" style="margin-top: 12px; color: var(--text-light-secondary);">
          Books, memoirs, and essays carried along mountain trails and hostel bunk beds.
        </p>
        <div class="hero-enter hero-delay-4" style="margin-top: 12px;">
          <a
            href="https://www.goodreads.com/user/show/202026328-varneet-singh"
            target="_blank"
            rel="noopener noreferrer"
            class="accent-link"
            style="font-size: 14px;"
          >
            Tracked live on Goodreads (389 books) <span class="arrow-spring">↗</span>
          </a>
        </div>
      </div>

      <!-- Currently Reading Stack -->
      <div style="margin-top: 48px;">
        <div class="reveal-on-scroll" style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px;">
          <span class="eyebrow">Currently Reading</span>
          <span class="eyebrow" style="color: var(--text-light-muted);">Live Progress</span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 20px;">
          {currentlyReading.map((book, idx) => (
            <a
              href={book.link}
              target="_blank"
              rel="noopener noreferrer"
              class={`reading-card-horizontal reveal-on-scroll stagger-${idx + 1}`}
            >
              <!-- Real Book Cover from Goodreads -->
              <div class="reading-card-thumb">
                <img
                  src={book.cover}
                  alt={`${book.title} book cover`}
                  loading="lazy"
                />
                <div class="book-realistic-spine-highlight"></div>
              </div>

              <!-- Book Details -->
              <div style="flex: 1; min-width: 0;">
                <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 6px;">
                  <h2 style="font-family: var(--font-serif); font-size: 1.35rem; color: var(--text-light-primary); line-height: 1.25; margin: 0;">
                    {book.title}
                  </h2>
                  <span class="eyebrow" style="color: var(--text-light-muted);">{book.author}</span>
                </div>
                <p style="margin-top: 8px; font-size: 14.5px; line-height: 1.5; color: var(--text-light-secondary);">
                  {book.note}
                </p>
                <div style="margin-top: 14px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                  <span style="font-size: 13px; font-weight: 600; color: #55756B;">
                    {book.progress}
                  </span>
                  <span class="eyebrow" style="font-size: 10px; color: var(--text-light-muted);">
                    {book.tag} <span class="arrow-spring">↗</span>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Goodreads Reading Shelves -->
      <div style="margin-top: 56px;">
        <span class="eyebrow reveal-on-scroll" style="margin-bottom: 20px;">Goodreads Shelf Notes</span>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          {readingHighlights.map((highlight, idx) => (
            <div class={`reveal-on-scroll stagger-${idx + 1}`} style="background: #ffffff; border: 1px solid var(--border-on-light); border-radius: 14px; padding: 20px 24px;">
              <h3 style="font-family: var(--font-serif); font-size: 1.2rem; color: var(--text-light-primary);">
                {highlight.shelf}
              </h3>
              <p style="margin-top: 6px; font-size: 15px; color: var(--text-light-secondary);">
                {highlight.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Direct Goodreads CTA -->
      <div class="reveal-on-scroll" style="margin-top: 48px; background-color: var(--bg-dark); color: var(--text-dark-primary); border-radius: 18px; padding: 32px 28px; border: 1px solid rgba(255,255,255,0.1); text-align: center;">
        <span class="eyebrow" style="color: var(--accent-sage);">Goodreads Profile</span>
        <h3 style="font-family: var(--font-serif); font-size: 1.6rem; margin-top: 8px;">
          389 Books & Year-in-Books Archive
        </h3>
        <p style="margin-top: 10px; font-size: 15px; color: var(--text-dark-secondary); max-width: 500px; margin-left: auto; margin-right: auto;">
          Every book read since 2017, rating breakdown, quotes, and reading challenge progress are tracked live on Goodreads.
        </p>
        <div style="margin-top: 24px;">
          <a
            href="https://www.goodreads.com/user/show/202026328-varneet-singh"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-accent"
          >
            Explore Varneet's Goodreads Profile <span class="arrow-spring">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
