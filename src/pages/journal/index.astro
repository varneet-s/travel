---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { journeysArchive, getTripTravelStyle } from '../../data/journeysArchive';

const allEntries = await getCollection('journal');
const entriesMap = new Map(allEntries.map((e) => [e.id, e]));

function getOrdinal(n: number) {
  const s = ['th', 'st', 'nd', 'rd'];
  const v = n % 100;
  return n + (s[(v - 20) % 10] || s[v] || s[0]);
}

interface SubstackPost {
  title: string;
  link: string;
  pubDate: string;
  description: string;
}

let substackPosts: SubstackPost[] = [];

try {
  const feedRes = await fetch('https://rekhoj.substack.com/feed', {
    headers: { 'User-Agent': 'Mozilla/5.0 (compatible; theMusafirPaaji/1.0)' }
  });
  if (feedRes.ok) {
    const xml = await feedRes.text();
    const itemRegex = /<item>([\s\S]*?)<\/item>/g;
    let match;
    while ((match = itemRegex.exec(xml)) !== null) {
      const itemContent = match[1];
      const titleMatch = itemContent.match(/<title><!\[CDATA\[([\s\S]*?)\]\]><\/title>/) || itemContent.match(/<title>([\s\S]*?)<\/title>/);
      const linkMatch = itemContent.match(/<link>([\s\S]*?)<\/link>/);
      const pubDateMatch = itemContent.match(/<pubDate>([\s\S]*?)<\/pubDate>/);
      const descMatch = itemContent.match(/<description><!\[CDATA\[([\s\S]*?)\]\]><\/description>/) || itemContent.match(/<description>([\s\S]*?)<\/description>/);

      const title = titleMatch ? titleMatch[1].trim() : 'Field Dispatch';
      const link = linkMatch ? linkMatch[1].trim() : 'https://rekhoj.substack.com';
      const rawDate = pubDateMatch ? pubDateMatch[1].trim() : '';
      let pubDate = rawDate;
      if (rawDate) {
        try {
          pubDate = new Date(rawDate).toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric'
          });
        } catch (e) {}
      }

      let desc = descMatch ? descMatch[1].replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim() : '';
      if (desc.length > 140) desc = desc.slice(0, 140) + '...';

      substackPosts.push({ title, link, pubDate, description: desc });
    }
  }
} catch (e) {
  // Graceful fallback for offline / build time
}
---

<BaseLayout
  title="Journeys Archive (14 Trips · 2023–2026) — Varneet"
  description="Chronological field log of 14 journeys across 3 years: Gokarna, Himachal trails, Banaras, Lucknow, and Rajasthan. Group trips, solo retreats, and trip leading with photo collages."
  image="/images/shangarh/shangarh-1.jpg"
>
  <div class="section-light">
    <div class="content-wrap">
      <div style="max-width: var(--reading-max);">
        <span class="eyebrow hero-enter hero-delay-1">Field Archives · 2023–2026</span>
        <h1 class="display-title hero-enter hero-delay-2" style="margin-top: 8px;">Journeys & The Road Archive</h1>
        <p class="hero-enter hero-delay-3" style="margin-top: 12px; color: var(--text-light-secondary); font-size: 1.15rem; line-height: 1.6;">
          An authentic chronological logbook of 14 trips taken over three years. Starting from that first nervous step in Gokarna, to guiding groups through Jibhi as a trip leader, solo reflections in Shojha, and desert miles across Rajasthan. Each entry includes its field story, curated photos, and memories.
        </p>

        <!-- Stats Bar -->
        <div class="hero-enter hero-delay-4" style="margin-top: 16px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
          <div style="background: rgba(14, 46, 37, 0.06); border: 1px solid var(--border-on-light); padding: 5px 14px; border-radius: 999px; font-size: 13px; font-weight: 500; color: var(--text-light-primary);">
            📍 14 Journeys Recorded
          </div>
          <div style="background: rgba(14, 46, 37, 0.06); border: 1px solid var(--border-on-light); padding: 5px 14px; border-radius: 999px; font-size: 13px; font-weight: 500; color: var(--text-light-primary);">
            🏔️ 4 States (HP, KA, UP, RJ)
          </div>
          <div style="background: rgba(14, 46, 37, 0.06); border: 1px solid var(--border-on-light); padding: 5px 14px; border-radius: 999px; font-size: 13px; font-weight: 500; color: var(--text-light-primary);">
            🎒 Trip Leader & Solo Explorer
          </div>
        </div>
      </div>

      <!-- Substack Publication Dispatches (RSS Feed) -->
      <section class="substack-feed-container reveal-on-scroll">
        <div class="substack-feed-header">
          <div>
            <span class="eyebrow" style="color: var(--accent-sage);">Substack Publication · reKhoj | The Musafir Paaji</span>
            <h2 style="font-family: var(--font-serif); font-size: 1.5rem; color: #ffffff; margin-top: 4px;">
              Recent Dispatches from the Road
            </h2>
          </div>
          <a
            href="https://rekhoj.substack.com"
            target="_blank"
            rel="noopener noreferrer"
            class="substack-ext-link"
          >
            Visit Publication on Substack <span class="arrow-spring">↗</span>
          </a>
        </div>

        <div id="substackCardsList" class="substack-cards-grid">
          {substackPosts.length > 0 ? (
            substackPosts.map((post) => (
              <a
                href={post.link}
                target="_blank"
                rel="noopener noreferrer"
                class="substack-post-card"
              >
                <div class="substack-post-top">
                  <span class="substack-badge">Dispatch</span>
                  <span class="substack-date">{post.pubDate}</span>
                </div>
                <h3 class="substack-post-title">{post.title}</h3>
                <p class="substack-post-desc">{post.description}</p>
                <span class="substack-read-link">
                  Read dispatch on Substack <span class="arrow-spring">→</span>
                </span>
              </a>
            ))
          ) : (
            <div id="substackEmptyCard" class="substack-empty-state">
              <div style="font-size: 24px; margin-bottom: 8px;">📬</div>
              <h3 style="font-family: var(--font-serif); font-size: 1.2rem; color: #ffffff; margin-bottom: 6px;">
                New letters in the notebook soon
              </h3>
              <p style="font-size: 14px; color: var(--text-dark-secondary); max-width: 480px; margin: 0 auto 18px; line-height: 1.6;">
                Unpublished trail notes, state bus transit logs, chai-stall expense ledgers, and stories from the road will publish directly to reKhoj on Substack and sync here automatically via RSS.
              </p>
              <a
                href="https://rekhoj.substack.com"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-accent"
                style="display: inline-flex; align-items: center; gap: 6px; font-size: 14px; padding: 9px 18px;"
              >
                <span>Read & Subscribe on Substack</span> <span class="arrow-spring">→</span>
              </a>
            </div>
          )}
        </div>
      </section>

      <!-- Year & Sort Controls (Roles & Styles filter removed) -->
      <div class="reveal-on-scroll" style="margin-top: 40px; display: flex; flex-direction: column; gap: 14px;">
        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
          <span class="eyebrow" style="margin-right: 4px;">Filter Year:</span>
          <button class="year-filter-pill active" data-year="all">All Trips (14)</button>
          <button class="year-filter-pill" data-year="2026">2026 (1)</button>
          <button class="year-filter-pill" data-year="2025">2025 (2)</button>
          <button class="year-filter-pill" data-year="2024">2024 (7)</button>
          <button class="year-filter-pill" data-year="2023">2023 (4)</button>
        </div>

        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
          <span class="eyebrow" style="margin-right: 4px;">Sort Order:</span>
          <button class="sort-filter-pill active" data-sort="desc">Newest First (Trip #14 → #01)</button>
          <button class="sort-filter-pill" data-sort="asc">Chronological (Trip #01 → #14)</button>
        </div>
      </div>

      <!-- Single Entry per Trip with Photo Collage, Location, Dates, and Blog Link -->
      <div id="journeysGrid" style="margin-top: 36px; display: flex; flex-direction: column; gap: 32px;">
        {journeysArchive.slice().reverse().map((trip) => {
          const entry = trip.journalSlug ? entriesMap.get(trip.journalSlug) : null;
          const images = entry?.data?.images || (trip.coverImage ? [trip.coverImage] : []);
          const displayImages = images.slice(0, 3);
          const ordinalText = getOrdinal(trip.id);
          const travelFormat = getTripTravelStyle(trip);

          return (
            <article
              class="journey-unified-card reveal-on-scroll"
              data-id={trip.id}
              data-year={trip.year.toString()}
            >
              {/* Top Meta Bar: Trip Number, Dates, and Travel Companion Badge */}
              <div class="trip-meta-header">
                <div class="trip-badge-group">
                  <span class="trip-number-pill">
                    Trip #{trip.id.toString().padStart(2, '0')} · {ordinalText} Journey
                  </span>
                  {travelFormat === 'With Raw Diaries' ? (
                    <a
                      href="https://www.instagram.com/rawdiaries.in/"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="trip-role-pill raw-diaries-pill-link"
                      title="Follow Raw Diaries on Instagram (@rawdiaries.in)"
                    >
                      🎒 With Raw Diaries <span class="pill-ext-arrow">↗</span>
                    </a>
                  ) : (
                    <span class="trip-role-pill">
                      {travelFormat === 'Solo' ? '🚶 Solo' : '👥 With Friends'}
                    </span>
                  )}
                </div>

                <div class="trip-date-badge">
                  <span class="calendar-icon">🗓️</span>
                  <strong>{trip.dates}</strong>
                </div>
              </div>

              {/* Location Highlight Banner */}
              <div class="trip-location-banner">
                <span class="location-pin">📍</span>
                <span class="location-destination">{trip.destination}</span>
                <span class="location-separator">·</span>
                <span class="location-region">{trip.region}</span>
                {entry?.data?.location && entry.data.location !== trip.destination && (
                  <span class="location-trail">({entry.data.location})</span>
                )}
              </div>

              {/* Title & Blog Summary */}
              <div class="trip-title-block">
                <h2 class="trip-title">
                  {trip.journalSlug ? (
                    <a href={`/journal/${trip.journalSlug}`}>{trip.title}</a>
                  ) : (
                    trip.title
                  )}
                </h2>
                <p class="trip-summary">
                  {trip.summary}
                </p>
              </div>

              {/* Integrated 3-Photo Collage */}
              {displayImages.length > 0 && (
                <div class="trip-collage-container">
                  <a
                    href={trip.journalSlug ? `/journal/${trip.journalSlug}` : '#'}
                    class="trip-photo-collage"
                    aria-label={`View photo dispatch for ${trip.title}`}
                  >
                    {displayImages.map((img, i) => (
                      <div class="collage-photo-cell">
                        <img
                          src={img}
                          alt={`${trip.title} - photograph ${i + 1}`}
                          loading="lazy"
                        />
                      </div>
                    ))}
                  </a>
                  <div class="collage-caption-bar">
                    <span class="collage-caption-text">
                      📷 Field Photographs · Authentic & face-free
                    </span>
                  </div>
                </div>
              )}

              {/* Memories & Field Marks */}
              <div class="trip-memories-box">
                <span class="memories-label">Memories & Field Marks</span>
                <ul class="memories-list">
                  {trip.highlights.map((h) => (
                    <li>
                      <span class="bullet-dot">•</span>
                      <span>
                        {h.includes('Raw Diaries') ? (
                          <>
                            {h.split('Raw Diaries')[0]}
                            <a
                              href="https://www.instagram.com/rawdiaries.in/"
                              target="_blank"
                              rel="noopener noreferrer"
                              class="highlight-raw-link"
                              title="Visit @rawdiaries.in on Instagram"
                            >
                              Raw Diaries ↗
                            </a>
                            {h.split('Raw Diaries')[1]}
                          </>
                        ) : (
                          h
                        )}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              {/* Card Footer: Tags and Link to Full Dispatch */}
              <div class="trip-card-footer">
                <div class="trip-tags">
                  {trip.tags.map((tag) => (
                    <span class="trip-tag">{tag}</span>
                  ))}
                </div>
                {trip.journalSlug && (
                  <a href={`/journal/${trip.journalSlug}`} class="read-dispatch-btn">
                    <span>Read Full Dispatch & Story</span>
                    <span class="arrow-spring">→</span>
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Interactive Timeline Filter & Sorting Script -->
  <script is:inline>
    const yearButtons = document.querySelectorAll('.year-filter-pill');
    const sortButtons = document.querySelectorAll('.sort-filter-pill');
    const journeysGrid = document.getElementById('journeysGrid');
    let cards = Array.from(document.querySelectorAll('#journeysGrid .journey-unified-card'));

    let activeYear = 'all';
    let activeSort = 'desc';

    function applyFilters() {
      cards.forEach((card) => {
        const cardYear = card.getAttribute('data-year');
        const yearMatch = activeYear === 'all' || cardYear === activeYear;

        if (yearMatch) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    function applySort() {
      cards.sort((a, b) => {
        const idA = parseInt(a.getAttribute('data-id') || '0', 10);
        const idB = parseInt(b.getAttribute('data-id') || '0', 10);
        return activeSort === 'asc' ? idA - idB : idB - idA;
      });

      cards.forEach((card) => {
        journeysGrid.appendChild(card);
      });
    }

    yearButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        yearButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeYear = btn.getAttribute('data-year');
        applyFilters();
      });
    });

    sortButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        sortButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeSort = btn.getAttribute('data-sort');
        applySort();
      });
    });
  </script>

  <style>
    .year-filter-pill, .sort-filter-pill {
      background: #ffffff;
      border: 1px solid var(--border-on-light);
      color: var(--text-light-secondary);
      font-size: 13px;
      font-weight: 500;
      padding: 6px 14px;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: var(--font-sans);
    }
    .year-filter-pill:hover, .style-filter-pill:hover, .sort-filter-pill:hover {
      border-color: var(--accent-terracotta);
      color: var(--accent-terracotta);
    }
    .year-filter-pill.active, .style-filter-pill.active, .sort-filter-pill.active {
      background: var(--bg-dark);
      color: #ffffff;
      border-color: var(--bg-dark);
    }

    /* Unified Card Styles */
    .journey-unified-card {
      background: #ffffff;
      border: 1px solid var(--border-on-light);
      border-radius: 16px;
      padding: 28px 32px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      position: relative;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .journey-unified-card:hover {
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
      border-color: rgba(14, 46, 37, 0.2);
    }

    .trip-meta-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(14, 46, 37, 0.08);
    }

    .trip-badge-group {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .trip-number-pill {
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 700;
      background: var(--accent-terracotta);
      color: #ffffff;
      padding: 4px 12px;
      border-radius: 999px;
      letter-spacing: 0.02em;
    }

    .trip-lead-pill {
      font-size: 12px;
      font-weight: 700;
      background: #e07a5f;
      color: #ffffff;
      padding: 3px 10px;
      border-radius: 999px;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .trip-role-pill {
      font-size: 12px;
      font-weight: 600;
      background: var(--bg-light);
      color: var(--text-light-primary);
      padding: 3px 10px;
      border-radius: 999px;
      border: 1px solid var(--border-on-light);
    }

    a.trip-role-pill.raw-diaries-pill-link {
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: var(--accent-terracotta);
      border-color: rgba(200, 90, 50, 0.35);
      background: rgba(200, 90, 50, 0.06);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    a.trip-role-pill.raw-diaries-pill-link:hover {
      background: rgba(200, 90, 50, 0.14);
      border-color: var(--accent-terracotta);
      color: var(--accent-terracotta);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(200, 90, 50, 0.15);
    }

    .pill-ext-arrow {
      font-size: 10px;
      opacity: 0.8;
      transition: transform 0.2s ease;
    }

    a.trip-role-pill.raw-diaries-pill-link:hover .pill-ext-arrow {
      transform: translate(1px, -1px);
    }

    .highlight-raw-link {
      color: var(--accent-terracotta);
      text-decoration: underline;
      text-underline-offset: 2px;
      font-weight: 600;
      transition: opacity 0.2s ease;
    }

    .highlight-raw-link:hover {
      opacity: 0.8;
    }

    .trip-date-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--text-light-primary);
      background: rgba(14, 46, 37, 0.05);
      padding: 4px 12px;
      border-radius: 999px;
      border: 1px solid var(--border-on-light);
    }

    .trip-location-banner {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      font-size: 14px;
      color: var(--text-light-secondary);
      background: #fafaf8;
      padding: 8px 14px;
      border-radius: 8px;
      border-left: 3px solid var(--accent-sage);
    }

    .location-pin {
      font-size: 15px;
    }

    .location-destination {
      font-weight: 700;
      color: var(--text-light-primary);
    }

    .location-separator {
      color: var(--text-light-muted);
    }

    .location-region {
      color: var(--text-light-secondary);
    }

    .location-trail {
      font-style: italic;
      color: var(--text-light-muted);
      font-size: 13px;
    }

    .trip-title-block {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .trip-title {
      font-family: var(--font-serif);
      font-size: 1.6rem;
      line-height: 1.25;
      color: var(--text-light-primary);
      margin: 0;
    }

    .trip-title a {
      color: inherit;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .trip-title a:hover {
      color: var(--accent-terracotta);
    }

    .trip-summary {
      font-size: 15.5px;
      color: var(--text-light-secondary);
      line-height: 1.6;
      margin: 0;
    }

    /* Collage styling */
    .trip-collage-container {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .trip-photo-collage {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      text-decoration: none;
    }

    .collage-photo-cell {
      position: relative;
      overflow: hidden;
      border-radius: 10px;
      aspect-ratio: 4 / 3;
      background: #ecebe6;
      border: 1px solid var(--border-on-light);
    }

    .collage-photo-cell img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .trip-photo-collage:hover .collage-photo-cell img {
      transform: scale(1.05);
    }

    .collage-caption-bar {
      display: flex;
      align-items: center;
      font-size: 12px;
      color: var(--text-light-muted);
      padding: 0 4px;
    }

    /* Memories Box */
    .trip-memories-box {
      background: var(--bg-light);
      border-radius: 10px;
      padding: 14px 18px;
      border-left: 3px solid var(--accent-sage);
    }

    .memories-label {
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-light-muted);
      margin-bottom: 6px;
      display: block;
    }

    .memories-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .memories-list li {
      font-size: 14px;
      color: var(--text-light-primary);
      display: flex;
      align-items: baseline;
      gap: 8px;
      line-height: 1.5;
    }

    .bullet-dot {
      color: var(--accent-terracotta);
      font-weight: 700;
    }

    /* Card Footer */
    .trip-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 14px;
      border-top: 1px solid var(--border-on-light);
      flex-wrap: wrap;
      gap: 12px;
    }

    .trip-tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .trip-tag {
      font-size: 12px;
      color: var(--text-light-muted);
      background: rgba(14, 46, 37, 0.04);
      padding: 2px 8px;
      border-radius: 4px;
    }

    .read-dispatch-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      font-weight: 600;
      color: var(--accent-terracotta);
      text-decoration: none;
      transition: gap 0.2s ease, color 0.2s ease;
    }

    .read-dispatch-btn:hover {
      color: var(--accent-terracotta-hover, #bf4324);
      gap: 10px;
    }

    /* Substack Publication RSS Feed Section */
    .substack-feed-container {
      margin-top: 36px;
      background: #0E2E25;
      color: #ffffff;
      border-radius: 18px;
      padding: 32px 28px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 16px 40px rgba(7, 25, 20, 0.25);
    }

    .substack-feed-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 22px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      padding-bottom: 16px;
    }

    .substack-ext-link {
      color: var(--accent-sage);
      font-size: 13.5px;
      font-weight: 600;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: color 0.2s ease;
    }

    .substack-ext-link:hover {
      color: #ffffff;
    }

    .substack-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 18px;
    }

    .substack-post-card {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      padding: 20px;
      text-decoration: none;
      color: #ffffff;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease, border-color 0.25s ease;
    }

    .substack-post-card:hover {
      transform: translateY(-3px);
      background: rgba(255, 255, 255, 0.09);
      border-color: rgba(255, 255, 255, 0.25);
    }

    .substack-post-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .substack-badge {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 999px;
      background: rgba(200, 168, 107, 0.2);
      color: var(--accent-ochre, #e8c872);
      border: 1px solid rgba(200, 168, 107, 0.3);
    }

    .substack-date {
      font-size: 12px;
      color: var(--text-dark-secondary);
    }

    .substack-post-title {
      font-family: var(--font-serif);
      font-size: 1.15rem;
      line-height: 1.35;
      color: #ffffff;
      margin: 0 0 8px 0;
    }

    .substack-post-desc {
      font-size: 13.5px;
      color: var(--text-dark-secondary);
      line-height: 1.5;
      margin-bottom: 16px;
      flex-grow: 1;
    }

    .substack-read-link {
      font-size: 13px;
      font-weight: 600;
      color: var(--accent-sage);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .substack-empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 36px 20px;
      background: rgba(255, 255, 255, 0.03);
      border-radius: 12px;
      border: 1px dashed rgba(255, 255, 255, 0.18);
    }

    @media (max-width: 680px) {
      .journey-unified-card {
        padding: 20px 18px;
      }
      .trip-photo-collage {
        grid-template-columns: 1fr;
        gap: 8px;
      }
      .trip-meta-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .trip-card-footer {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <!-- Substack Live RSS Hydration Script -->
  <script is:inline>
    (function checkSubstackLiveFeed() {
      const container = document.getElementById('substackCardsList');
      const emptyState = document.getElementById('substackEmptyCard');
      if (!container || !emptyState) return;

      fetch('https://api.rss2json.com/v1/api.json?rss_url=https%3A%2F%2Frekhoj.substack.com%2Ffeed')
        .then((res) => res.json())
        .then((data) => {
          if (data && data.status === 'ok' && Array.isArray(data.items) && data.items.length > 0) {
            container.innerHTML = '';
            data.items.slice(0, 6).forEach((item) => {
              const card = document.createElement('a');
              card.href = item.link;
              card.target = '_blank';
              card.rel = 'noopener noreferrer';
              card.className = 'substack-post-card';

              const dateStr = item.pubDate
                ? new Date(item.pubDate).toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric'
                  })
                : '';
              let desc = item.description ? item.description.replace(/<[^>]+>/g, '').trim() : '';
              if (desc.length > 140) desc = desc.slice(0, 140) + '...';

              card.innerHTML = `
                <div class="substack-post-top">
                  <span class="substack-badge">Dispatch</span>
                  <span class="substack-date">${dateStr}</span>
                </div>
                <h3 class="substack-post-title">${item.title}</h3>
                <p class="substack-post-desc">${desc}</p>
                <span class="substack-read-link">Read dispatch on Substack <span class="arrow-spring">→</span></span>
              `;
              container.appendChild(card);
            });
          }
        })
        .catch(() => {});
    })();
  </script>
</BaseLayout>

