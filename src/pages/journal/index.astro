---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allEntries = await getCollection('journal');
const sortedEntries = allEntries.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout
  title="Journeys & Notes — Varneet"
  description="Trip stories, high-altitude trail notes, and photographs from Himachal Pradesh."
>
  <div class="section-light">
    <div class="content-narrow">
      <div>
        <span class="eyebrow hero-enter hero-delay-1">Trip Stories & Field Notes</span>
        <h1 class="display-title hero-enter hero-delay-2" style="margin-top: 8px;">Journeys</h1>
        <p class="hero-enter hero-delay-3" style="margin-top: 12px; color: var(--text-light-secondary);">
          Photo-led field archives from unhurried Himalayan routes and mountain valleys.
        </p>
      </div>

      <div style="margin-top: 48px; display: flex; flex-direction: column; gap: 48px;">
        {sortedEntries.map((entry, idx) => {
          const dateStr = new Date(entry.data.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });
          return (
            <a href={`/journal/${entry.id}`} class={`preview-card-editorial reveal-on-scroll stagger-${(idx % 3) + 1}`}>
              <div class="preview-photos-3">
                {entry.data.images.slice(0, 3).map((img, i) => (
                  <div style="overflow: hidden; border-radius: 8px;">
                    <img
                      src={img}
                      alt={`${entry.data.title} photo ${i + 1}`}
                      loading="lazy"
                      style="width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);"
                    />
                  </div>
                ))}
              </div>
              <div class="preview-meta-row">
                <h3>{entry.data.title}</h3>
                <span class="eyebrow" style="color: var(--text-light-muted);">{dateStr} <span class="arrow-spring">→</span></span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>
