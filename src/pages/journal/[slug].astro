---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('journal');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = new Date(entry.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': entry.data.title,
  'description': entry.data.description || `Travel notes and photographs from ${entry.data.title}.`,
  'image': entry.data.images && entry.data.images.length > 0 ? `https://travel.varneet.in${entry.data.images[0]}` : undefined,
  'datePublished': entry.data.date,
  'author': {
    '@type': 'Person',
    'name': 'Varneet Singh',
    'alternateName': 'the_musafir_paaji',
    'url': 'https://travel.varneet.in/about',
  },
  'publisher': {
    '@type': 'Person',
    'name': 'reKhoj',
  },
};

const dmCheckoutUrl = `https://ig.me/m/the_musafir_paaji?text=${encodeURIComponent(`Hey Varneet, I was reading your journal on "${entry.data.title}" and would love to get the offline GPX trail markers and homestay notes!`)}`;
---

<BaseLayout
  title={`${entry.data.title} — Varneet`}
  description={entry.data.description || `Travel notes and trail insights from ${entry.data.title}.`}
  image={entry.data.images?.[0]}
  type="article"
  jsonLd={jsonLd}
>
  <div class="section-light">
    <article class="content-narrow">
      <div>
        <a href="/journal" class="eyebrow hero-enter hero-delay-1" style="margin-bottom: 12px; display: inline-block;">
          ← Back to Journeys
        </a>
        <h1 class="display-title hero-enter hero-delay-2" style="margin-top: 4px; margin-bottom: 8px;">
          {entry.data.title}
        </h1>

        <!-- Mountain Coordinates & Date with Live Beacon (Tubik Accent Motion) -->
        <div class="beacon-badge hero-enter hero-delay-3" style="margin-top: 6px; display: flex; align-items: center; gap: 8px;">
          <span class="beacon-dot-wrap">
            <span class="beacon-dot-ping"></span>
            <span class="beacon-dot-core"></span>
          </span>
          <span class="eyebrow" style="color: var(--text-light-muted);">
            {formattedDate}{entry.data.location ? ` · ${entry.data.location}` : ''}
          </span>
        </div>
      </div>

      {entry.data.images && entry.data.images.length > 0 && (
        <div class="hero-enter hero-delay-3" style="overflow: hidden; border-radius: 16px; margin: 28px 0; box-shadow: 0 16px 36px -12px rgba(15, 61, 48, 0.2);">
          <img
            src={entry.data.images[0]}
            alt={entry.data.title}
            class="hero-photo-ambient"
            style="width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block;"
          />
        </div>
      )}

      <div class="prose-block reveal-on-scroll">
        <Content />
      </div>

      {entry.data.images && entry.data.images.length > 1 && (
        <div class="prose-gallery-grid" style="margin-top: 32px;">
          {entry.data.images.slice(1).map((img, i) => (
            <div class={`reveal-on-scroll stagger-${(i % 3) + 1}`} style="overflow: hidden; border-radius: 12px; box-shadow: 0 10px 24px -8px rgba(15, 61, 48, 0.15);">
              <img
                src={img}
                alt={`${entry.data.title} gallery photo ${i + 2}`}
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);"
                onmouseover="this.style.transform='scale(1.05)'"
                onmouseout="this.style.transform='scale(1)'"
              />
            </div>
          ))}
        </div>
      )}

      <!-- Free Itinerary Guide Box -->
      <div class="itinerary-cta-box reveal-on-scroll">
        <div class="itinerary-cta-header">
          <span class="eyebrow" style="color: var(--accent-sage);">Free Route Guide · Open Field Notes</span>
          <span class="badge-sage">Trail Notes</span>
        </div>
        <h3>Want to walk this exact route?</h3>
        <p>
          I've compiled the complete day-by-day transit guide, local bus timings, homestay phone numbers, and offline trail markers for this journey — 100% free and open for independent slow travelers.
        </p>
        <div style="margin-top: 14px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
          <a
            href="/itineraries"
            class="btn-accent"
          >
            Explore All Route Guides <span class="arrow-spring">→</span>
          </a>
          <a
            href={dmCheckoutUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="accent-link"
            style="color: var(--accent-sage); font-size: 14px; font-weight: 500;"
          >
            Ask for Offline GPX File <span class="arrow-spring">→</span>
          </a>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
