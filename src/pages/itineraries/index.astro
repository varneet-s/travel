---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { itineraries } from '../../data/itineraries';
---

<BaseLayout
  title="Itineraries — Varneet"
  description="Tested routes, daily logistics, and field advice for quiet Himalayan travel."
>
  <div class="section-light">
    <div class="content-narrow">
      <div>
        <span class="eyebrow">Curated Route Guides</span>
        <h1 class="display-title" style="margin-top: 8px;">Itineraries</h1>
        <p style="margin-top: 12px; color: var(--text-light-secondary);">
          Detailed day-by-day routes, stay recommendations, and transport logistics.
        </p>
      </div>

      <div style="margin-top: 36px;">
        {itineraries.map((itinerary) => (
          <a href={`/itineraries/${itinerary.slug}`} class="itinerary-plain-row">
            <div>
              <span class="row-title">{itinerary.title}</span>
              <span class="eyebrow" style="color: var(--text-light-muted); margin-top: 4px;">
                {itinerary.region} · {itinerary.duration}
              </span>
            </div>
            <div style="font-size: 14px; color: var(--accent-terracotta); font-weight: 500; white-space: nowrap;">
              {itinerary.price} · view itinerary →
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
