---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { itineraries } from '../../data/itineraries';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Free Himalayan Field Itineraries by Varneet (@the_musafir_paaji)',
  'description': 'Tested routes, offline GPX waypoints, bus logistics, and homestay contacts across Himachal Pradesh. 100% free open guides.',
  'itemListElement': itineraries.map((itinerary, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'item': {
      '@type': 'TouristTrip',
      'name': itinerary.title,
      'description': itinerary.overview,
      'url': `https://travel.varneet.in/itineraries/${itinerary.slug}`,
    },
  })),
};
---

<BaseLayout
  title="Curated Route Guides & Field Notes — Varneet"
  description="Free day-by-day Himalayan routes, stay recommendations, and transit logistics. Day-by-day travel diary and offline waypoints."
  image="/images/shoja/shoja-1.jpg"
  jsonLd={jsonLd}
>
  <div class="section-light">
    <div class="content-wrap">
      <div style="max-width: var(--reading-max);">
        <span class="eyebrow hero-enter hero-delay-1">Curated Himalayan Route Guides</span>
        <h1 class="display-title hero-enter hero-delay-2" style="margin-top: 8px;">Itineraries</h1>
        <p class="hero-enter hero-delay-3" style="margin-top: 12px; color: var(--text-light-secondary); font-size: 1.15rem; line-height: 1.6;">
          Tested day-by-day routes, local bus timetables, and homestay recommendations. Built for slow, independent backpackers traveling on foot and modest budgets. 100% free and open.
        </p>

        <!-- Freshness Badge -->
        <div class="hero-enter hero-delay-4" style="margin-top: 14px; display: inline-flex; align-items: center; gap: 8px; background: rgba(14, 46, 37, 0.06); border: 1px solid var(--border-on-light); padding: 5px 14px; border-radius: 999px;">
          <span style="width: 8px; height: 8px; border-radius: 50%; background: #55756B;"></span>
          <span style="font-size: 13px; color: var(--text-light-primary); font-weight: 500;">
            Field notes updated September 2026 · All routes open access
          </span>
        </div>
      </div>

      <!-- Mood Filter Bar -->
      <div class="reveal-on-scroll" style="margin-top: 36px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
        <span class="eyebrow" style="margin-right: 4px;">Filter:</span>
        <button class="filter-pill active" data-filter="all">All (3)</button>
        <button class="filter-pill" data-filter="high-altitude">High Passes</button>
        <button class="filter-pill" data-filter="forest-trails">Forest Trails</button>
        <button class="filter-pill" data-filter="river-valley">River Valleys</button>
        <button class="filter-pill" data-filter="solo-friendly">Solo Friendly</button>
        <button class="filter-pill" data-filter="monsoon-safe">Monsoon-Safe</button>
      </div>

      <!-- 3 Itinerary Cards Grid -->
      <div id="itinerariesList" style="margin-top: 36px; display: flex; flex-direction: column; gap: 32px;">
        {itineraries.map((itinerary, idx) => (
          <article
            class={`itinerary-bento-card reveal-on-scroll stagger-${idx + 1}`}
            style="background: #ffffff;"
            data-tags={itinerary.moodTags.join(' ')}
          >
            <img
              src={itinerary.image}
              alt={itinerary.title}
              class="itinerary-card-img"
              loading="lazy"
            />
            <div class="itinerary-card-info" style="display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 6px;">
                  <span class="eyebrow">{itinerary.region} · {itinerary.duration}</span>
                  <span class="badge-sage" style="font-size: 11px; padding: 3px 8px;">
                    🌿 {itinerary.bestSeason}
                  </span>
                </div>

                <h2 style="font-family: var(--font-serif); font-size: 1.45rem; color: var(--text-light-primary); line-height: 1.3; margin: 6px 0 10px;">
                  <a href={`/itineraries/${itinerary.slug}`} style="color: inherit; text-decoration: none;">
                    {itinerary.title}
                  </a>
                </h2>

                <p style="font-size: 14.5px; color: var(--text-light-secondary); line-height: 1.6; margin-bottom: 16px;">
                  {itinerary.overview}
                </p>

                <!-- Mood Tags -->
                <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 16px;">
                  {itinerary.moodTags.map((tag) => (
                    <span style="font-size: 11.5px; color: var(--text-light-muted); background: var(--bg-light); padding: 2px 8px; border-radius: 4px;">
                      {tag}
                    </span>
                  ))}
                </div>

                <!-- First Day Diary Sneak Peek -->
                <div style="background: var(--bg-light); border-radius: 8px; padding: 12px 16px; border-left: 3px solid var(--accent-sage); margin-bottom: 18px;">
                  <span class="eyebrow" style="font-size: 10px; color: var(--text-light-muted);">Field Journal Snippet</span>
                  <p style="font-size: 13.5px; color: var(--text-light-primary); font-style: italic; margin-top: 4px; line-height: 1.5;">
                    "{itinerary.days[0].narrative.slice(0, 140)}..."
                  </p>
                </div>
              </div>

              <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 14px; border-top: 1px solid var(--border-on-light); flex-wrap: wrap; gap: 10px;">
                <span style="font-size: 13px; color: var(--text-light-muted);">
                  Altitude: {itinerary.elevation}
                </span>
                <a href={`/itineraries/${itinerary.slug}`} class="accent-link" style="font-weight: 600; font-size: 14.5px;">
                  Read Free Field Guide & Route Map <span class="arrow-spring">→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Packing Checklist Quick Trigger -->
      <div class="reveal-on-scroll" style="margin-top: 56px; background: #ffffff; border: 1px dashed var(--border-on-light); border-radius: 14px; padding: 24px 28px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
          <span class="eyebrow" style="color: var(--accent-terracotta);">Pre-Trail Preparation</span>
          <h3 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--text-light-primary); margin-top: 2px;">
            Minimalist Mountain Packing Checklist
          </h3>
          <p style="font-size: 14px; color: var(--text-light-secondary); margin-top: 4px;">
            What to carry in a 35L rucksack for 1–2 weeks in Himachal without extra weight.
          </p>
        </div>
        <a
          href="https://ig.me/m/the_musafir_paaji?text=Hey%20Varneet,%20could%20you%20share%20your%20minimalist%20backpacking%20checklist%20for%20Himachal?"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-accent"
          style="font-size: 14px; padding: 10px 20px;"
        >
          Get Free Packing Checklist <span class="arrow-spring">→</span>
        </a>
      </div>

      <!-- Ask About Custom Trail -->
      <div class="reveal-on-scroll" style="margin-top: 48px; background: var(--bg-dark); color: var(--text-dark-primary); border-radius: 16px; padding: 32px 28px; border: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; gap: 14px; max-width: var(--reading-max);">
        <span class="eyebrow" style="color: var(--accent-sage);">Need on-ground advice?</span>
        <h3 style="font-family: var(--font-serif); font-size: 1.45rem; color: #ffffff;">
          Planning a different mountain trail?
        </h3>
        <p style="font-size: 14.5px; color: var(--text-dark-secondary); line-height: 1.6;">
          If you are planning an unhurried journey through Kinnaur, Lahaul, or remote Kullu valleys and want practical answers on bus junctions, road openings, or homestay availability — send a message anytime.
        </p>
        <div style="margin-top: 8px;">
          <a
            href="https://instagram.com/the_musafir_paaji"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-accent"
          >
            Message @the_musafir_paaji on Instagram <span class="arrow-spring">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Filter Script -->
  <script is:inline>
    const filterButtons = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('#itinerariesList article');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        cards.forEach((card) => {
          if (filter === 'all') {
            card.style.display = 'flex';
          } else {
            const tags = card.getAttribute('data-tags') || '';
            if (tags.includes(filter)) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          }
        });
      });
    });
  </script>

  <style>
    .filter-pill {
      background: #ffffff;
      border: 1px solid var(--border-on-light);
      color: var(--text-light-secondary);
      font-size: 13px;
      font-weight: 500;
      padding: 6px 14px;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: var(--font-sans);
    }
    .filter-pill:hover {
      border-color: var(--accent-terracotta);
      color: var(--accent-terracotta);
    }
    .filter-pill.active {
      background: var(--bg-dark);
      color: #ffffff;
      border-color: var(--bg-dark);
    }
  </style>
</BaseLayout>


