---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { itineraries } from '../../data/itineraries';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Himalayan Field Itineraries by Varneet (@the_musafir_paaji)',
  'description': 'Tested routes, offline GPX markers, bus logistics, and homestay contacts across Himachal Pradesh.',
  'itemListElement': itineraries.map((itinerary, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'item': {
      '@type': 'TouristTrip',
      'name': itinerary.title,
      'description': itinerary.overview,
      'url': `https://travel.varneet.in/itineraries/${itinerary.slug}`,
      'offers': {
        '@type': 'Offer',
        'price': '59',
        'priceCurrency': 'INR',
      },
    },
  })),
};
---

<BaseLayout
  title="Curated Route Guides & Itineraries — Varneet"
  description="Detailed day-by-day Himalayan routes, stay recommendations, and transit logistics. Unlock offline GPX files and vetted homestay contacts for ₹59."
  image="/images/shoja/shoja-1.jpg"
  jsonLd={jsonLd}
>
  <div class="section-light">
    <div class="content-wrap">
      <div style="max-width: var(--reading-max);">
        <span class="eyebrow hero-enter hero-delay-1">Curated Himalayan Route Guides</span>
        <h1 class="display-title hero-enter hero-delay-2" style="margin-top: 8px;">Itineraries</h1>
        <p class="hero-enter hero-delay-3" style="margin-top: 12px; color: var(--text-light-secondary); font-size: 1.15rem; line-height: 1.6;">
          Tested day-by-day transit plans, homestay recommendations, and offline trail markers built for slow, independent backpackers traveling on a modest budget.
        </p>

        <div class="hero-enter hero-delay-4" style="margin-top: 16px; display: inline-flex; align-items: center; gap: 8px; background: rgba(14, 46, 37, 0.06); border: 1px solid var(--border-on-light); padding: 6px 14px; border-radius: 999px;">
          <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--accent-terracotta);"></span>
          <span style="font-size: 13px; color: var(--text-light-primary); font-weight: 500;">
            All 3 route guides include offline GPX trail markers & homestay numbers · ₹59 each
          </span>
        </div>
      </div>

      <!-- 3 Itinerary Cards Grid -->
      <div style="margin-top: 48px; display: flex; flex-direction: column; gap: 32px;">
        {itineraries.map((itinerary, idx) => (
          <article class={`itinerary-bento-card reveal-on-scroll stagger-${idx + 1}`} style="background: #ffffff;">
            <img
              src={itinerary.image}
              alt={itinerary.title}
              class="itinerary-card-img"
              loading="lazy"
            />
            <div class="itinerary-card-info" style="display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 6px;">
                  <span class="eyebrow">{itinerary.region} · {itinerary.duration}</span>
                  <span class="badge-sage" style="font-size: 11px; padding: 2px 8px;">
                    Instant Pack {itinerary.price}
                  </span>
                </div>

                <h2 style="font-family: var(--font-serif); font-size: 1.4rem; color: var(--text-light-primary); line-height: 1.3; margin: 6px 0 10px;">
                  {itinerary.title}
                </h2>

                <p style="font-size: 14.5px; color: var(--text-light-secondary); line-height: 1.55; margin-bottom: 16px;">
                  {itinerary.overview}
                </p>

                <!-- Key Highlights Preview -->
                <div style="margin-bottom: 20px;">
                  <span class="eyebrow" style="font-size: 10.5px; margin-bottom: 8px; display: block;">Route Highlights</span>
                  <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 4px;">
                    {itinerary.highlights.slice(0, 2).map((h) => (
                      <li style="font-size: 13.5px; color: var(--text-light-muted); display: flex; align-items: baseline; gap: 6px;">
                        <span style="color: var(--accent-terracotta);">•</span>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 14px; border-top: 1px solid var(--border-on-light); flex-wrap: wrap; gap: 10px;">
                <span style="font-size: 13px; color: var(--text-light-muted);">
                  Includes GPX & direct phone numbers
                </span>
                <a href={`/itineraries/${itinerary.slug}`} class="accent-link" style="font-weight: 600; font-size: 14.5px;">
                  View Day-by-Day & Get Guide ({itinerary.price}) <span class="arrow-spring">→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Trust & Custom Advisory Note -->
      <div class="reveal-on-scroll" style="margin-top: 64px; background: var(--bg-dark); color: var(--text-dark-primary); border-radius: 16px; padding: 32px 28px; border: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; gap: 14px; max-width: var(--reading-max);">
        <span class="eyebrow" style="color: var(--accent-sage);">Need custom route advice?</span>
        <h3 style="font-family: var(--font-serif); font-size: 1.45rem; color: #ffffff;">
          Planning a different mountain trail?
        </h3>
        <p style="font-size: 14.5px; color: var(--text-dark-secondary); line-height: 1.6;">
          If you are planning an unhurried journey through Kinnaur, Lahaul, or remote Kullu valleys and want practical answers on bus junctions, road openings, or homestay availability — reach out directly.
        </p>
        <div style="margin-top: 8px;">
          <a
            href="https://instagram.com/the_musafir_paaji"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-accent"
          >
            Message @the_musafir_paaji on Instagram <span class="arrow-spring">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

