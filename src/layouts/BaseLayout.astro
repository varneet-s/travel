---
import '../styles/global.css';
import { inject } from '@vercel/analytics';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = "Letters from — The Long way Home.",
  description = "Notes from the road, Himalayan state bus routes, and honest travel reflections by Varneet Singh (@the_musafir_paaji).",
  image = "/images/og-compass-card.png",
  type = "website",
  jsonLd,
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ? Astro.site.origin : 'https://travel.varneet.in';
const canonicalURL = new URL(currentPath, siteUrl).href;
const ogImageURL = image.startsWith('http') ? image : new URL(image, siteUrl).href;

inject();
---

<!doctype html>
<html lang="en" class="bg-[#0A1118] text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="the_musafir_paaji" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Google Fonts exclusively via standard link tags in head -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0A1118] text-white min-h-screen flex flex-col font-sans selection:bg-white/20 selection:text-white">
    <!-- Minimalist Top Navigation Header (No hamburger menu) -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-[#0A1118]/85 backdrop-blur-md border-b border-white/10 transition-all duration-300">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between" aria-label="Main Navigation">
        <a href="/" class="group flex items-center gap-2.5 text-white no-underline focus:outline-none">
          <span class="font-serif text-lg tracking-tight font-medium group-hover:text-white/80 transition-colors">
            reKhoj
          </span>
          <span class="text-xs text-white/40 font-mono tracking-widest hidden sm:inline-block">
            @the_musafir_paaji
          </span>
        </a>

        <!-- Direct Semantic Nav Links (Directly visible, zero hamburger menu) -->
        <div class="flex items-center gap-6 sm:gap-8 text-xs sm:text-sm font-sans tracking-wide">
          <a
            href="/#letters"
            class="text-white/70 hover:text-white transition-colors duration-200"
          >
            Letters
          </a>
          <a
            href="/#reading"
            class="text-white/70 hover:text-white transition-colors duration-200"
          >
            Reading
          </a>
          <a
            href="/about"
            class="text-white/70 hover:text-white transition-colors duration-200"
          >
            About
          </a>
          <a
            href="https://rekhoj.substack.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white font-medium border border-white/15 transition-colors duration-200 text-xs"
          >
            <span>Substack</span>
            <span class="text-white/60">↗</span>
          </a>
        </div>
      </nav>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Minimalist Editorial Footer -->
    <footer class="border-t border-white/10 bg-[#0F1720] py-12 px-4 sm:px-6 lg:px-8 text-white/50 text-xs font-sans">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="font-serif text-sm text-white/80">reKhoj</span>
          <span>·</span>
          <span>The Long way Home.</span>
          <span>·</span>
          <span>Slow routes & open notebooks</span>
        </div>
        <div class="flex items-center gap-6">
          <a href="https://rekhoj.substack.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
            Substack ↗
          </a>
          <a href="https://instagram.com/the_musafir_paaji" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
            Instagram ↗
          </a>
          <a href="/about" class="hover:text-white transition-colors">
            About
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
