---
import '../styles/global.css';
import { inject } from '@vercel/analytics';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = "Letter from — The Long Way Home",
  description = "Notes from the road, Himalayan state bus routes, and honest travel reflections by Varneet Singh (@the_musafir_paaji).",
  image = "/images/og-compass-card.png",
  type = "website",
  jsonLd,
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ? Astro.site.origin : 'https://travel.varneet.in';
const canonicalURL = new URL(currentPath, siteUrl).href;
const ogImageURL = image.startsWith('http') ? image : new URL(image, siteUrl).href;
const gaId = import.meta.env.PUBLIC_GA_ID || 'G-T0DVT2MZB2';

// Initialize Vercel Analytics
inject();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="the_musafir_paaji" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Schema.org JSON-LD Structured Data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Critical Hero & UI Asset Preloads -->
    <link rel="preload" as="image" href="/images/bir/bir-hero.jpg" fetchpriority="high" />
    <link rel="preload" as="image" href="/images/illustrations/expedition-compass.svg" />

    <!-- Google Fonts: Courier Prime, Newsreader, Source Sans 3 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Source+Sans+3:ital,wght@0,300..700;1,300..700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics (GA4) -->
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <!-- Top Reading / Scroll Progress Bar -->
    <div class="reading-progress-track" aria-hidden="true">
      <div id="readingProgress" class="reading-progress-bar"></div>
    </div>

    <!-- Custom Subtle Compass Cursor -->
    <div class="custom-cursor-dot" id="cursorDot" aria-hidden="true"></div>
    <div class="custom-cursor-ring" id="cursorRing" aria-hidden="true"></div>

    <!-- HIMACHAL.CLOUD STYLE: Minimal Corner Wayfinding System -->
    <!-- Fixed Top-Left Brand Anchor -->
    <div class="corner-brand-anchor">
      <a href="/" class="site-brand brand-mark-link" aria-label="reKhoj Homepage">
        <img
          src="/images/illustrations/expedition-compass.svg"
          alt=""
          class="corner-compass-icon"
          width="24"
          height="24"
          aria-hidden="true"
        />
        <div class="corner-brand-text">
          <span class="corner-brand-name">reKhoj</span>
          <span class="corner-brand-coords">@the_musafir_paaji · 32.04°N</span>
        </div>
      </a>
    </div>

    <!-- Fixed Top-Right Corner Compass Wayfinding Trigger -->
    <div class="corner-wayfinding-wrap">
      <button
        type="button"
        class="corner-compass-trigger mobile-nav-toggle"
        id="mobileNavToggle"
        aria-label="Toggle navigation wayfinding"
        aria-expanded="false"
        aria-controls="mobileNavDrawer"
      >
        <img
          src="/images/illustrations/expedition-compass.svg"
          alt=""
          class="nav-compass-spin"
          width="26"
          height="26"
          aria-hidden="true"
        />
        <span class="wayfinding-trigger-label">WAYFINDING</span>
        <span class="hamburger-box" aria-hidden="true">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </span>
      </button>
    </div>

    <!-- Desktop Side Scroll-Linked Indicator Dots (Scoped to Homepage) -->
    {currentPath === '/' && (
      <nav class="side-wayfinding-dots" aria-label="Section wayfinding" id="sideWayfindingNav">
        <a href="#hero" class="wayfinding-dot active" data-target="hero" title="The Road (Altitude Intro)">
          <span class="dot-point"></span>
          <span class="dot-label">01 · The Road</span>
        </a>
        <a href="#dispatch" class="wayfinding-dot" data-target="dispatch" title="Featured Dispatch (Shangarh)">
          <span class="dot-point"></span>
          <span class="dot-label">02 · Dispatch</span>
        </a>
        <a href="#atlas" class="wayfinding-dot" data-target="atlas" title="Expedition Atlas (14 Journeys)">
          <span class="dot-point"></span>
          <span class="dot-label">03 · Atlas</span>
        </a>
        <a href="#consuming" class="wayfinding-dot" data-target="consuming" title="Currently Consuming (Books + Film)">
          <span class="dot-point"></span>
          <span class="dot-label">04 · Consuming</span>
        </a>
        <a href="#letters" class="wayfinding-dot" data-target="letters" title="Substack Dispatches">
          <span class="dot-point"></span>
          <span class="dot-label">05 · Letters</span>
        </a>
        <a href="#volunteer" class="wayfinding-dot" data-target="volunteer" title="Hostel Volunteering">
          <span class="dot-point"></span>
          <span class="dot-label">06 · Stays</span>
        </a>
      </nav>
    )}

    <!-- Hidden Header Nav Structure Preserving Tests T3.1 & T4.1.1 -->
    <header class="nav-header" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0;">
      <nav class="masthead-nav swiss-nav" aria-label="Main Navigation">
        <a href="/" class="site-brand masthead-brand">reKhoj</a>
        <ul class="nav-menu desktop-nav swiss-menu">
          <li><a href="/journal" class={currentPath.startsWith('/journal') ? 'active' : ''}>Letters</a></li>
          <li><a href="/reading" class={currentPath.startsWith('/reading') ? 'active' : ''}>Library</a></li>
          <li><a href="/about" class={currentPath.startsWith('/about') ? 'active' : ''}>About &amp; Volunteer</a></li>
        </ul>
      </nav>
    </header>

    <!-- Full-Screen Atmospheric Overlay Navigation (himachal.cloud style) -->
    <div
      class="mobile-nav-backdrop himachal-overlay-backdrop"
      id="mobileNavBackdrop"
      aria-hidden="true"
    ></div>

    <div
      class="mobile-nav-drawer himachal-overlay-nav"
      id="mobileNavDrawer"
      role="dialog"
      aria-modal="true"
      aria-label="Wayfinding Menu"
      aria-hidden="true"
    >
      <div class="overlay-nav-header">
        <a href="/" class="site-brand mobile-drawer-brand">
          <img
            src="/images/illustrations/expedition-compass.svg"
            alt=""
            class="site-brand-compass"
            width="28"
            height="28"
            aria-hidden="true"
          />
          <span class="mobile-drawer-brand-text">
            <span class="mobile-drawer-title">reKhoj</span>
            <span class="mobile-drawer-sublabel">@the_musafir_paaji · Field Journal</span>
          </span>
        </a>

        <button
          type="button"
          class="mobile-nav-close overlay-close-btn"
          id="mobileNavClose"
          aria-label="Close wayfinding navigation"
        >
          <span aria-hidden="true">✕</span>
        </button>
      </div>

      <div class="overlay-nav-content">
        <!-- Single-Scroll Section Stops -->
        <div class="overlay-sections-column">
          <span class="overlay-kicker">STOPS ON THIS JOURNEY</span>
          <nav class="overlay-stops-list" aria-label="Wayfinding stops">
            <a href="/#hero" class="overlay-stop-link" data-stop="hero">
              <span class="stop-num">01</span>
              <span class="stop-name">The Altitude Road & Bus</span>
              <span class="stop-meta">15M → 3,450M</span>
            </a>
            <a href="/#dispatch" class="overlay-stop-link" data-stop="dispatch">
              <span class="stop-num">02</span>
              <span class="stop-name">Featured Dispatch (Shangarh)</span>
              <span class="stop-meta">2,100M Alpine Bowl</span>
            </a>
            <a href="/#atlas" class="overlay-stop-link" data-stop="atlas">
              <span class="stop-num">03</span>
              <span class="stop-name">Expedition Atlas</span>
              <span class="stop-meta">14 Journeys · 4 States</span>
            </a>
            <a href="/#consuming" class="overlay-stop-link" data-stop="consuming">
              <span class="stop-num">04</span>
              <span class="stop-name">Currently Consuming</span>
              <span class="stop-meta">Books + Cinema RSS</span>
            </a>
            <a href="/#letters" class="overlay-stop-link" data-stop="letters">
              <span class="stop-num">05</span>
              <span class="stop-name">Letters from the Road</span>
              <span class="stop-meta">reKhoj Substack RSS</span>
            </a>
            <a href="/#volunteer" class="overlay-stop-link" data-stop="volunteer">
              <span class="stop-num">06</span>
              <span class="stop-name">Hostel & Homestay Stays</span>
              <span class="stop-meta">Collaboration</span>
            </a>
          </nav>
        </div>

        <!-- Dedicated Archive Destinations (Preserving Tests T3.1) -->
        <div class="overlay-archives-column">
          <span class="overlay-kicker">ARCHIVES & LOGS</span>
          <ul class="mobile-nav-links overlay-archives-list">
            <li>
              <a href="/journal" class={`mobile-nav-link ${currentPath.startsWith('/journal') ? 'active' : ''}`}>
                <span>Letters (14 Trips)</span>
                <span class="drawer-arrow" aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a href="/reading" class={`mobile-nav-link ${currentPath.startsWith('/reading') ? 'active' : ''}`}>
                <span>Library (Goodreads)</span>
                <span class="drawer-arrow" aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a href="/about" class={`mobile-nav-link ${currentPath.startsWith('/about') ? 'active' : ''}`}>
                <span>About & Volunteer</span>
                <span class="drawer-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          </ul>

          <div class="mobile-nav-cta" style="margin-top: 24px;">
            <a
              href="https://rekhoj.substack.com"
              target="_blank"
              rel="noopener noreferrer"
              class="mobile-substack-pill"
              title="Read field dispatches on Substack"
            >
              <span>Dispatches on Substack</span>
              <span class="arrow-spring" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>

      <div class="mobile-nav-footer overlay-nav-footer">
        <span class="mobile-nav-tagline">
          Letter from — The Long Way Home · Slow routes. Useful stays. Open notebooks.
        </span>
      </div>
    </div>

    <!-- Main Content Slot -->
    <main>
      <slot />
    </main>

    <!-- Unified Editorial Footer with Interactive Cursor-Reactive Compass -->
    <footer class="editorial-footer" id="footer">
      <div class="footer-arrow-banner" aria-hidden="true">
        <img
          src="/images/illustrations/mountain-footer-ridge.svg?v=arrow-horizon"
          alt=""
          class="footer-ridge-svg"
          loading="lazy"
        />
      </div>
      <div class="footer-bottom-panel">
        <div class="content-wrap">
          <div class="footer-content-row">
            <div class="footer-brand-lockup">
              <!-- Cursor-Reactive Rotating Compass Icon -->
              <img
                src="/images/illustrations/expedition-compass.svg"
                alt="Expedition Compass Rose"
                class="footer-compass-badge"
                id="footerInteractiveCompass"
                aria-hidden="true"
              />
              <div class="footer-text-block">
                <span class="footer-brand-name">reKhoj · the_musafir_paaji</span>
                <span class="footer-tagline">
                  Letter from — The Long Way Home | Slow routes. Useful stays. Open notebooks.
                </span>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
              <a
                href="https://rekhoj.substack.com"
                target="_blank"
                rel="noopener noreferrer"
                class="footer-action footer-action-substack"
                title="Read and subscribe to dispatches on Substack"
              >
                Substack Dispatches <span class="arrow-spring">↗</span>
              </a>
              <a
                href="https://instagram.com/the_musafir_paaji"
                target="_blank"
                rel="noopener noreferrer"
                class="footer-action"
              >
                Instagram ↗
              </a>
              <a
                href="https://www.goodreads.com/user/show/202026328-varneet-singh"
                target="_blank"
                rel="noopener noreferrer"
                class="footer-action"
              >
                Goodreads ↗
              </a>
              <a
                href="https://letterboxd.com/the_musafir_paaji/"
                target="_blank"
                rel="noopener noreferrer"
                class="footer-action"
              >
                Letterboxd ↗
              </a>
            </div>
          </div>
        </div>
      </div>
    </footer>

    <!-- Centralized Scroll Engine, Wayfinding, Custom Cursor & Interactive Compass -->
    <script>
      import { initScrollEngine, bindReadingProgress, bindWayfindingDots } from '../scripts/scroll-engine';

      function initBaseLayout() {
        // 1. Centralized Scroll Engine with Lenis & GSAP ScrollTrigger sync
        const engine = initScrollEngine();

        // 2. Reading progress and wayfinding dots bound to Lenis scroll (zero duplicate unthrottled listeners)
        const unbindProgress = bindReadingProgress(engine.lenis, 'readingProgress');
        const unbindDots = bindWayfindingDots(engine.lenis, ['hero', 'dispatch', 'atlas', 'consuming', 'letters', 'volunteer']);

        // 3. Full-Screen Wayfinding Overlay Toggle
        const toggle = document.getElementById('mobileNavToggle');
        const drawer = document.getElementById('mobileNavDrawer');
        const backdrop = document.getElementById('mobileNavBackdrop');
        const closeBtn = document.getElementById('mobileNavClose');
        const stopLinks = document.querySelectorAll('.overlay-stop-link');

        function openDrawer() {
          drawer?.classList.add('is-open');
          backdrop?.classList.add('is-open');
          toggle?.setAttribute('aria-expanded', 'true');
          drawer?.setAttribute('aria-hidden', 'false');
          document.body.classList.add('drawer-locked');
        }

        function closeDrawer() {
          drawer?.classList.remove('is-open');
          backdrop?.classList.remove('is-open');
          toggle?.setAttribute('aria-expanded', 'false');
          drawer?.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('drawer-locked');
        }

        toggle?.addEventListener('click', openDrawer);
        closeBtn?.addEventListener('click', closeDrawer);
        backdrop?.addEventListener('click', closeDrawer);
        stopLinks.forEach(link => link.addEventListener('click', closeDrawer));

        // 4. Custom Subtle Compass Cursor
        const cursorDot = document.getElementById('cursorDot');
        const cursorRing = document.getElementById('cursorRing');
        let onMouseMove: ((e: MouseEvent) => void) | null = null;
        if (cursorDot && cursorRing && window.matchMedia('(pointer: fine)').matches) {
          onMouseMove = (e: MouseEvent) => {
            cursorDot.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
            cursorRing.style.transform = `translate3d(${e.clientX - 16}px, ${e.clientY - 16}px, 0)`;
          };
          window.addEventListener('mousemove', onMouseMove, { passive: true });

          const clickables = document.querySelectorAll('a, button, .milestone-interactive-node');
          clickables.forEach((el) => {
            el.addEventListener('mouseenter', () => cursorRing.classList.add('cursor-hover'));
            el.addEventListener('mouseleave', () => cursorRing.classList.remove('cursor-hover'));
          });
        }

        // 5. Interactive Footer Compass (Rotates towards cursor)
        const footerCompass = document.getElementById('footerInteractiveCompass');
        let onCompassMove: ((e: MouseEvent) => void) | null = null;
        if (footerCompass) {
          onCompassMove = (e: MouseEvent) => {
            const rect = footerCompass.getBoundingClientRect();
            const compassCenterX = rect.left + rect.width / 2;
            const compassCenterY = rect.top + rect.height / 2;
            const angle = Math.atan2(e.clientY - compassCenterY, e.clientX - compassCenterX) * (180 / Math.PI) + 90;
            footerCompass.style.transform = `rotate(${angle}deg)`;
          };
          window.addEventListener('mousemove', onCompassMove, { passive: true });
        }

        // 6. Comprehensive Teardown on pagehide or Astro view transitions
        const cleanup = () => {
          unbindProgress();
          unbindDots();
          engine.destroy();
          if (onMouseMove) window.removeEventListener('mousemove', onMouseMove);
          if (onCompassMove) window.removeEventListener('mousemove', onCompassMove);
          window.removeEventListener('pagehide', cleanup);
          document.removeEventListener('astro:before-swap', cleanup);
        };

        window.addEventListener('pagehide', cleanup, { once: true });
        document.addEventListener('astro:before-swap', cleanup, { once: true });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBaseLayout);
      } else {
        initBaseLayout();
      }
    </script>

    <style>
      /* Fixed Top-Left Brand Anchor */
      .corner-brand-anchor {
        position: fixed;
        top: 20px;
        left: 24px;
        z-index: 900;
      }

      .brand-mark-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(13, 22, 20, 0.75);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        padding: 8px 16px;
        border-radius: 999px;
        text-decoration: none;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .brand-mark-link:hover {
        transform: translateY(-1px);
        border-color: var(--accent-terracotta);
      }

      .corner-compass-icon {
        width: 22px;
        height: 22px;
        transition: transform 0.4s ease;
      }

      .brand-mark-link:hover .corner-compass-icon {
        transform: rotate(45deg);
      }

      .corner-brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
      }

      .corner-brand-name {
        font-family: 'Newsreader', var(--font-serif);
        font-size: 15px;
        font-weight: 700;
        color: #FAF8F5;
      }

      .corner-brand-coords {
        font-family: var(--font-mono);
        font-size: 9px;
        color: var(--accent-sage-light);
        letter-spacing: 0.04em;
      }

      /* Fixed Top-Right Corner Wayfinding Trigger */
      .corner-wayfinding-wrap {
        position: fixed;
        top: 20px;
        right: 24px;
        z-index: 900;
      }

      .corner-compass-trigger {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(13, 22, 20, 0.85);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1.5px solid rgba(255, 255, 255, 0.18);
        color: #FAF8F5;
        padding: 8px 18px;
        border-radius: 999px;
        cursor: pointer;
        min-height: 44px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
        transition: all 0.2s ease;
      }

      .corner-compass-trigger:hover {
        border-color: var(--accent-terracotta);
        transform: translateY(-1px);
      }

      .wayfinding-trigger-label {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .hamburger-box {
        width: 16px;
        height: 10px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      /* Mobile Clearance: Eliminate button collision on 375px-412px viewports */
      @media (max-width: 768px) {
        .corner-brand-anchor {
          top: 14px;
          left: 14px;
        }
        .corner-wayfinding-wrap {
          top: 14px;
          right: 14px;
        }
        .corner-brand-coords {
          display: none !important;
        }
        .wayfinding-trigger-label {
          display: none !important;
        }
        .brand-mark-link {
          padding: 6px 12px;
        }
        .corner-compass-trigger {
          padding: 8px 12px;
          min-width: 44px;
          min-height: 44px;
          justify-content: center;
        }
      }

      /* Desktop Side Wayfinding Dots */
      .side-wayfinding-dots {
        position: fixed;
        right: 24px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        flex-direction: column;
        gap: 18px;
        z-index: 850;
        pointer-events: auto;
      }

      .wayfinding-dot {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        flex-direction: row-reverse;
      }

      .dot-point {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.5);
        transition: all 0.2s ease;
      }

      .dot-label {
        font-family: var(--font-mono);
        font-size: 10px;
        color: rgba(255, 255, 255, 0.6);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        opacity: 0;
        transform: translateX(8px);
        transition: opacity 0.2s ease, transform 0.2s ease;
        pointer-events: none;
      }

      .wayfinding-dot:hover .dot-label,
      .wayfinding-dot.active .dot-label {
        opacity: 1;
        transform: translateX(0);
      }

      .wayfinding-dot.active .dot-point {
        background: var(--accent-terracotta);
        border-color: #ffffff;
        transform: scale(1.4);
        box-shadow: 0 0 10px var(--accent-terracotta);
      }

      @media (max-width: 960px) {
        .side-wayfinding-dots {
          display: none !important;
        }
      }

      /* Full-Screen Overlay Nav (himachal.cloud style) */
      .himachal-overlay-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(4, 15, 12, 0.92);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        z-index: 998;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease, visibility 0.25s ease;
        pointer-events: none;
      }

      .himachal-overlay-backdrop.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      .himachal-overlay-nav {
        position: fixed;
        inset: 0;
        background: #0B1412;
        background-image: radial-gradient(circle at 80% 20%, rgba(91, 155, 130, 0.1) 0%, transparent 60%);
        z-index: 999;
        display: flex;
        flex-direction: column;
        padding: 40px 48px;
        box-sizing: border-box;
        overflow-y: auto;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-20px);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .himachal-overlay-nav.is-open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .overlay-nav-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 24px;
        margin-bottom: 36px;
      }

      .overlay-close-btn {
        width: 48px;
        height: 48px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #FAF8F5;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        transition: all 0.2s ease;
      }

      .overlay-close-btn:hover {
        background: var(--accent-terracotta);
        border-color: #ffffff;
      }

      .overlay-nav-content {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 60px;
        flex: 1;
      }

      .overlay-kicker {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.16em;
        color: var(--accent-sage-light);
        margin-bottom: 20px;
        display: block;
      }

      .overlay-stops-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .overlay-stop-link {
        display: flex;
        align-items: center;
        gap: 20px;
        text-decoration: none;
        padding: 12px 18px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        transition: all 0.2s ease;
      }

      .overlay-stop-link:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--accent-terracotta);
        transform: translateX(6px);
      }

      .stop-num {
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 700;
        color: var(--accent-terracotta);
      }

      .stop-name {
        font-family: 'Newsreader', var(--font-serif);
        font-size: 1.5rem;
        color: #FAF8F5;
        flex: 1;
      }

      .stop-meta {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--accent-sage-light);
      }

      .overlay-archives-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .overlay-nav-footer {
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        margin-top: 36px;
      }

      @media (max-width: 860px) {
        .himachal-overlay-nav {
          padding: 24px 20px;
        }
        .overlay-nav-content {
          grid-template-columns: 1fr;
          gap: 36px;
        }
        .stop-name {
          font-size: 1.2rem;
        }
      }

      /* Custom Subtle Cursor */
      .custom-cursor-dot {
        position: fixed;
        top: 0;
        left: 0;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent-terracotta);
        pointer-events: none;
        z-index: 10000;
        will-change: transform;
      }

      .custom-cursor-ring {
        position: fixed;
        top: 0;
        left: 0;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1.5px solid rgba(216, 107, 88, 0.4);
        pointer-events: none;
        z-index: 9999;
        transition: width 0.2s ease, height 0.2s ease, border-color 0.2s ease;
        will-change: transform;
      }

      .custom-cursor-ring.cursor-hover {
        width: 44px;
        height: 44px;
        border-color: var(--accent-terracotta);
        background: rgba(216, 107, 88, 0.08);
      }

      @media (pointer: coarse) {
        .custom-cursor-dot,
        .custom-cursor-ring {
          display: none !important;
        }
      }

      /* Footer Interactive Compass */
      .footer-compass-badge {
        transition: transform 0.15s ease-out;
      }

      :global(body.drawer-locked) {
        overflow: hidden !important;
      }
    </style>
  </body>
</html>
