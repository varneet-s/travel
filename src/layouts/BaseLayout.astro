---
import '../styles/global.css';
import { inject } from '@vercel/analytics';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = "Letters from — The Long way Home.",
  description = "Notes from the road, Himalayan state bus routes, and honest travel reflections by Varneet Singh (@the_musafir_paaji).",
  image = "/images/og-compass-card.png",
  type = "website",
  jsonLd,
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ? Astro.site.origin : 'https://travel.varneet.in';
const canonicalURL = new URL(currentPath, siteUrl).href;
const ogImageURL = image.startsWith('http') ? image : new URL(image, siteUrl).href;

inject();
---

<!doctype html>
<html lang="en" class="bg-[#0A1C20] text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="the_musafir_paaji" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Google Fonts exclusively via standard link tags in head -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fontdiner+Swanky&family=Inter:wght@300;400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Oswald:wght@700;900&family=Spicy+Rice&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0A1C20] text-white min-h-screen flex flex-col font-sans selection:bg-[#77C5A0]/25 selection:text-white">
    <!-- Navbar: White background with Fogging Forest video loop, reKhoj (large backpacker K), equal word spacing -->
    <header
      id="main-header"
      class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-black/5 text-[#0A1C20] transition-all duration-500 ease-out transform -translate-y-full opacity-0 pointer-events-none shadow-sm overflow-hidden"
    >
      <!-- Real Clouds Video Background Loop in Navbar -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden select-none z-0" aria-hidden="true">
        <video
          autoplay
          loop
          muted
          playsinline
          onloadeddata="this.playbackRate = 0.5;"
          class="w-full h-full object-cover pointer-events-none opacity-45 filter contrast-[1.15] brightness-[1.05] saturate-[1.2]"
          style="object-position: center 15%;"
        >
          <source src="/videos/fogging-forest.mp4" type="video/mp4" />
        </video>
      </div>

      <!-- Desktop Navigation Bar: Corner-to-corner full width with equal word spacing -->
      <nav class="relative z-10 w-full px-4 sm:px-6 md:px-8 h-16 hidden md:flex items-center justify-between" aria-label="Main Navigation">
        <!-- Brand: reKhoj with backpacker K matching text baseline and clean spacing -->
        <a href="/" class="group inline-flex items-baseline text-[#0A1C20] no-underline focus:outline-none" aria-label="reKhoj — home">
          <span class="font-serif text-2xl font-bold tracking-tight mr-1.5 sm:mr-2">re</span>
          <img
            src="/images/backpacker-k.png"
            alt=""
            aria-hidden="true"
            class="inline-block h-8 sm:h-9 w-auto object-contain group-hover:scale-110 transition-transform duration-300"
            style="vertical-align: -0.14em;"
            loading="eager"
          />
          <span class="font-serif text-2xl font-bold tracking-tight">hoj</span>
        </a>

        <a href="/#letters" class="text-[#0A1C20]/85 hover:text-[#0A1C20] font-sans font-semibold text-sm hover:underline underline-offset-4 transition-colors duration-200">
          Letters
        </a>

        <a href="/#reading" class="text-[#0A1C20]/85 hover:text-[#0A1C20] font-sans font-semibold text-sm hover:underline underline-offset-4 transition-colors duration-200">
          Reading
        </a>

        <a href="/#about" class="text-[#0A1C20]/85 hover:text-[#0A1C20] font-sans font-semibold text-sm hover:underline underline-offset-4 transition-colors duration-200">
          About
        </a>

        <a href="/#volunteer" class="text-[#0A1C20]/85 hover:text-[#0A1C20] font-sans font-semibold text-sm hover:underline underline-offset-4 transition-colors duration-200">
          Volunteer
        </a>
      </nav>

      <!-- Mobile Navigation Bar -->
      <nav class="relative z-10 w-full px-4 sm:px-6 h-16 flex md:hidden items-center justify-between" aria-label="Mobile Navigation">
        <a href="/" class="group inline-flex items-baseline text-[#0A1C20] no-underline focus:outline-none" aria-label="reKhoj — home">
          <span class="font-serif text-xl font-bold tracking-tight mr-1.5">re</span>
          <img
            src="/images/backpacker-k.png"
            alt=""
            aria-hidden="true"
            class="inline-block h-7 w-auto object-contain"
            style="vertical-align: -0.14em;"
            loading="eager"
          />
          <span class="font-serif text-xl font-bold tracking-tight">hoj</span>
        </a>

        <!-- Mobile Hamburger Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 text-[#0A1C20] hover:text-black hover:bg-black/10 focus:outline-none rounded-lg transition-colors"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </nav>

      <!-- Mobile Dropdown Menu -->
      <div
        id="mobile-menu"
        class="hidden md:hidden border-t border-black/10 bg-white/95 backdrop-blur-md px-6 py-6 transition-all duration-300 shadow-lg relative"
      >
        <div class="flex flex-col gap-4 text-base font-sans tracking-wide">
          <a href="/#letters" class="mobile-nav-link flex items-center justify-between text-[#0A1C20] font-semibold hover:underline py-1.5 border-b border-black/10">Letters</a>
          <a href="/#reading" class="mobile-nav-link flex items-center justify-between text-[#0A1C20] font-semibold hover:underline py-1.5 border-b border-black/10">Reading</a>
          <a href="/#about" class="mobile-nav-link flex items-center justify-between text-[#0A1C20] font-semibold hover:underline py-1.5 border-b border-black/10">About</a>
          <a href="/#volunteer" class="mobile-nav-link flex items-center justify-between text-[#0A1C20] font-semibold hover:underline py-1.5">Volunteer</a>
        </div>
      </div>
    </header>

    <script is:inline>
      function handleScrollNav() {
        const header = document.getElementById('main-header');
        if (!header) return;
        if (window.scrollY > 40) {
          header.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
          header.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
        } else {
          header.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
          header.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
          // Close mobile menu when scrolling back to absolute top
          const mobileMenu = document.getElementById('mobile-menu');
          const hIcon = document.getElementById('hamburger-icon');
          const cIcon = document.getElementById('close-icon');
          if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
            mobileMenu.classList.add('hidden');
            if (hIcon) hIcon.classList.remove('hidden');
            if (cIcon) cIcon.classList.add('hidden');
          }
        }
      }

      function setupMobileMenu() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const hIcon = document.getElementById('hamburger-icon');
        const cIcon = document.getElementById('close-icon');
        if (!btn || !menu) return;

        btn.addEventListener('click', () => {
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', !isExpanded);
          menu.classList.toggle('hidden');
          if (hIcon) hIcon.classList.toggle('hidden');
          if (cIcon) cIcon.classList.toggle('hidden');
        });

        // Close when clicking any link
        const links = menu.querySelectorAll('.mobile-nav-link');
        links.forEach(l => {
          l.addEventListener('click', () => {
            menu.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            if (hIcon) hIcon.classList.remove('hidden');
            if (cIcon) cIcon.classList.add('hidden');
          });
        });
      }

      function enforceVideoHalfSpeed() {
        document.querySelectorAll('video').forEach((v) => {
          v.playbackRate = 0.5;
        });
      }

      window.addEventListener('scroll', handleScrollNav, { passive: true });
      document.addEventListener('DOMContentLoaded', () => {
        handleScrollNav();
        setupMobileMenu();
        enforceVideoHalfSpeed();
      });
      // Periodic check on load to ensure video speed stays at 0.5x
      window.addEventListener('load', enforceVideoHalfSpeed);
    </script>

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Minimalist Editorial Footer -->
    <footer class="border-t border-white/10 bg-[#12292E] py-12 px-4 sm:px-6 lg:px-8 text-white/50 text-xs font-sans">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 text-center md:text-left">
          <span class="font-serif text-sm text-[#F7E4A1]/90">reKhoj</span>
          <span>·</span>
          <span>The Long way Home.</span>
          <span>·</span>
          <span>Slow routes &amp; open notebooks</span>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-6">
          <a
            href="https://buymeacoffee.com/rekhoj"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#FFDD00] hover:bg-[#FFE633] text-[#000000] font-sans text-xs font-semibold shadow-md transition-transform hover:scale-105"
            title="Buy me a coffee on buymeacoffee.com"
          >
            <span>☕</span>
            <span>Buy me a coffee</span>
          </a>
          <a href="https://instagram.com/the_musafir_paaji" target="_blank" rel="noopener noreferrer" class="hover:text-[#F7E4A1] transition-colors">
            Instagram ↗
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
